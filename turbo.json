{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate": {
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["src/generated/**"],
      "env": ["DATABASE_URL"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "generate"]
    },
    "test:db": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "passThroughEnv": [
        "APP_DATABASE_URL",
        "SYSTEM_DATABASE_URL",
        "DATABASE_URL",
        "REDIS_URL",
        "PLATFORM_DOMAIN"
      ]
    },
    "dev": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "persistent": true
    },
    "db:seed": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": [
        "APP_DATABASE_URL",
        "SYSTEM_DATABASE_URL",
        "PLATFORM_DOMAIN",
        "SECRETS_ENCRYPTION_KEY",
        "WHATSAPP_TOKEN_ENCRYPTION_KEY",
        "NODE_ENV"
      ]
    }
  }
}
