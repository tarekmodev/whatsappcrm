# Documented contract for every environment variable the platform reads.
# Copy to `.env` for local development. Never commit a filled-in copy: deployed
# environments read these from Render environment groups (see `render.yaml` and
# docs/runbooks/environments.md), not from a file.
#
# Keys the API validates must be mirrored in apps/api/src/config/env.schema.ts in
# the same commit.
#
# A blank value means "not set": the API strips empty values before validating, so
# `KEY=` falls back to the default or stays optional rather than failing as a
# malformed value. That is what makes copying this file verbatim work.
#
# The API reads this file from the repository root regardless of which directory it
# is started from — the same file `apps/api/prisma.config.mjs` reads, so the app and
# the migration CLI cannot disagree about which database "local" means.

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000

# Names the provisioned environment: local | development | staging | production.
# Stamped on every log line, metric and error-tracker event. Distinct from
# NODE_ENV — all three deployed environments run NODE_ENV=production.
DEPLOY_ENV=local

# Surfaced on the health endpoint. Render passes the commit SHA in as this.
APP_VERSION=0.0.0

# ---------------------------------------------------------------------------
# Infrastructure. The values below point at the local `docker-compose.yml`
# stack and match its defaults, so a fresh copy of this file works with no
# edits.
#
# Deployed environments get both from their Render environment (`render.yaml`
# wires them from the database and Key Value instance in that same environment,
# so they cannot be pointed at the wrong one by hand). Both are **required
# whenever NODE_ENV=production** — the API refuses to boot without them rather
# than starting and failing at the first request. They stay optional locally and
# under test so the app still runs with nothing behind it.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://whatsappcrm:local_dev_only@localhost:5432/whatsappcrm?schema=public
REDIS_URL=redis://localhost:6379

# Scratch database Prisma resets on every use, needed only to generate down
# migrations locally. Created by the local Docker stack. Leave unset in any
# deployed environment — `prisma migrate deploy` never touches it.
SHADOW_DATABASE_URL=postgresql://whatsappcrm:local_dev_only@localhost:5432/whatsappcrm_shadow?schema=public

# ---------------------------------------------------------------------------
# Local Docker stack (docker-compose.yml). Compose reads this file itself, so
# these are consumed by Compose rather than by the apps.
#
# The password is a throwaway for a container bound to localhost. It is not a
# secret and must never be reused anywhere else; real credentials never live in
# a committed file.
#
# If port 5432 or 6379 is already taken on your machine, change the port here
# AND in DATABASE_URL / REDIS_URL above — they are not derived from each other.
# ---------------------------------------------------------------------------
POSTGRES_USER=whatsappcrm
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=whatsappcrm
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Human-readable output for a terminal. Never enable in a deployed environment —
# the log collector parses JSON.
LOG_PRETTY=false
# A request at or above this many milliseconds is logged at warn and flagged slow.
SLOW_REQUEST_THRESHOLD_MS=1000
# Upper bound on a single readiness probe.
HEALTH_CHECK_TIMEOUT_MS=2000

# Error tracker. Leave empty locally: with no DSN the SDK is never started.
SENTRY_DSN=
# 0 disables performance tracing. Raise per environment, not per developer.
SENTRY_TRACES_SAMPLE_RATE=0

# ---------------------------------------------------------------------------
# Frontend (apps/web) — NEXT_PUBLIC_* values are inlined into the browser
# bundle. Never put a secret behind this prefix.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# ---------------------------------------------------------------------------
# Third-party credentials — one set per environment, provisioned as Render
# environment-group secrets (`render.yaml`). Development and staging take the
# provider's test credentials; production takes live ones, entered deliberately
# and never copied down from another environment.
#
# No application code reads these yet, so they are absent from
# apps/api/src/config/env.schema.ts. The story that first reads one adds it there
# and makes it required.
#   TAR-35  auth session signing secret
#   TAR-37  Polar.sh
# ---------------------------------------------------------------------------
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
