# Documented contract for every environment variable the platform reads.
# Copy to `.env` for local development. Never commit a filled-in copy: deployed
# environments read these from the platform's secret store (see
# docs/adr/0001-stack-decision.md), not from a file.
#
# Keys must be mirrored in apps/api/src/config/env.schema.ts in the same commit.

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000
APP_VERSION=0.0.0

# Provisioned by TAR-41. Optional at scaffold stage; required from TAR-41 on.
DATABASE_URL=
REDIS_URL=

# ---------------------------------------------------------------------------
# Frontend (apps/web) — NEXT_PUBLIC_* values are inlined into the browser
# bundle. Never put a secret behind this prefix.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# ---------------------------------------------------------------------------
# Third-party credentials — added by the stories that introduce them. Listed
# here so the shape of a complete environment is visible from day one.
#   TAR-35  auth session signing secret
#   TAR-37  Polar.sh API key and webhook signing secret
#   TAR-41  error-tracker DSN, log destination
#   WhatsApp Cloud API: app secret, access token, phone number id,
#           webhook verify token
# ---------------------------------------------------------------------------
