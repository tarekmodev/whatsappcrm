# Documented contract for every environment variable the platform reads.
# Copy to `.env` for local development. Never commit a filled-in copy: deployed
# environments read these from Render environment groups (see `render.yaml` and
# docs/runbooks/environments.md), not from a file.
#
# Keys the API validates must be mirrored in apps/api/src/config/env.schema.ts in
# the same commit; frontend keys in apps/web/lib/config/env.ts.
#
# A blank value means "not set": the API strips empty values before validating, so
# `KEY=` falls back to the default or stays optional rather than failing as a
# malformed value. That is what makes copying this file verbatim work.
#
# Declare every key exactly once. Every reader of this format — Node's
# `loadEnvFile`, dotenv, Docker Compose — takes the LAST occurrence, so a second
# `KEY=` further down silently blanks the value set above it.
#
# Every reader takes this file from the repository root regardless of which
# directory it is started from — the API and its seed through
# `apps/api/src/repository-env-file.ts`, the console through
# `apps/web/repository-env-file.mjs`, and the Prisma CLI in
# `apps/api/prisma.config.mjs`. One file, so the app, the console and the
# migration CLI cannot disagree about which database "local" means.

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000

# Names the provisioned environment: local | development | staging | production.
# Stamped on every log line, metric and error-tracker event. Distinct from
# NODE_ENV — all three deployed environments run NODE_ENV=production.
DEPLOY_ENV=local

# Surfaced on the health endpoint. Render passes the commit SHA in as this.
APP_VERSION=0.0.0

# The API's two database connections. Which role a client connects as *is* the
# tenant isolation guarantee, so these are two URLs and not one:
#
#   APP_DATABASE_URL     TenantPrisma, as `whatsappcrm_app`. Holds neither
#                        SUPERUSER nor BYPASSRLS, so row-level security applies
#                        and a query with no tenant in scope returns nothing.
#   SYSTEM_DATABASE_URL  SystemPrisma, as `whatsappcrm_system`. Reads and writes
#                        across every tenant — five call sites only, see
#                        docs/architecture/0002-architecture-and-api-contract.md.
#
# Neither may be the migration owner below: on a managed instance the owner is
# usually a superuser, and a superuser skips RLS entirely.
#
# `pnpm db:roles` creates both roles NOLOGIN and without a password;
# `pnpm db:roles:login` gives them the throwaway one used here. Deployed
# environments take the password from the platform's secret store instead.
#
# In a deployed environment the roles are created by the deploy hook and their
# password comes from the Render environment group — see `render.yaml` and
# docs/runbooks/environments.md.
APP_DATABASE_URL=postgresql://whatsappcrm_app:local_dev_only@localhost:5432/whatsappcrm?schema=public
SYSTEM_DATABASE_URL=postgresql://whatsappcrm_system:local_dev_only@localhost:5432/whatsappcrm?schema=public

# The DNS zone every tenant's platform subdomain is issued under: a tenant with
# slug `acme` is provisioned at `acme.app.localhost`. Custom domains (TAR-29) are
# added alongside it, never instead of it.
#
# `*.localhost` resolves to 127.0.0.1 in Chrome, Firefox and Safari with no hosts
# file entry, which is what makes host-based tenant resolution testable locally.
PLATFORM_DOMAIN=app.localhost

# The hostname a tenant points its own domain at: the CNAME target handed back
# by POST /api/v1/tenant/domains when a customer adds a custom domain (TAR-419).
#
# A bare hostname — no scheme, no trailing dot — because it goes into a DNS
# record rather than a URL. In a deployed environment it is the *public* edge
# host of that environment's web service, e.g.
# `whatsappcrm-web-prod.onrender.com`; render.yaml prompts for it per
# environment. Not a secret: every tenant that adds a domain is shown it.
#
# Left blank here. A local stack has no edge to point DNS at, and a made-up
# value would be a CNAME target that resolves somewhere wrong rather than one
# that is obviously absent. With it unset the custom-domain routes refuse a
# claim outright instead of publishing an unfollowable record.
#
# Attaching the domain at the edge and confirming its certificate is an operator
# step, not something the API does: docs/runbooks/custom-domains.md.
PLATFORM_EDGE_HOSTNAME=

# What a tenant that has set no product name of its own is called (TAR-29). Shown
# in the browser title and on the login screen of every such tenant, so it is a
# white-label deployment's own name rather than this repository's. Unset falls
# back to `BRANDING_DEFAULTS.productName` in @whatsappcrm/contracts. Not a secret:
# it is published by GET /api/v1/tenant/public to anyone who asks.
PLATFORM_PRODUCT_NAME=

# How long an unverified custom-domain claim survives before the sweeper deletes
# it and releases the hostname. A claim reserves a globally unique hostname, so
# without an expiry one tenant typing a competitor's domain holds it forever.
DOMAIN_VERIFICATION_TTL_DAYS=7

# How often pending claims are re-checked and lapsed ones released. This is what
# makes verification arrive without the tenant sitting on a settings screen —
# DNS propagation is minutes to hours. Per-claim backoff is in the sweeper, so a
# shorter interval here does not mean more queries per domain.
DOMAIN_VERIFICATION_SWEEP_INTERVAL_MS=900000

# Upper bound on one DNS lookup during ownership verification. Short on purpose:
# the record is at a name the tenant nominated, so a slow answer is far more
# likely to be a nameserver that will not answer than one that needs a moment.
DOMAIN_VERIFICATION_TIMEOUT_MS=3000

# Scheme put in front of a tenant's hostname in the links invite and
# password-reset emails carry. `https` everywhere the platform is deployed;
# `http` only here, where nothing is serving TLS on `*.localhost`.
APP_LINK_SCHEME=http

# Whether the four public self-signup routes are served (TAR-405):
#
#   POST /api/v1/signup            POST /api/v1/signup/verify
#   POST /api/v1/signup/resend     GET  /api/v1/signup/slug-available
#
# On by default — self-serve signup is the product. Set it to `false` for a
# deployment that provisions tenants by hand through the platform admin surface
# below; every signup route then answers 404 rather than 403, so a disabled
# feature does not advertise itself to anybody who probes.
#
# These are the only routes in the product that are both outside tenancy and
# unauthenticated. What protects them is a rate limit, this flag, and the fact
# that nothing is provisioned until an emailed token comes back.
SIGNUP_ENABLED=true

# Bearer credentials for the platform admin surface (`POST /api/v1/admin/tenants`),
# as comma-separated `label:secret` entries — one per operator or automation:
#
#   PLATFORM_ADMIN_TOKEN=ops-alice:<secret>,ci-provisioner:<secret>
#
# The caller presents the *secret* half as the bearer token; the label is not a
# secret and is written to `audit_logs.actor_label`, so the trail can say which
# operator connected a WhatsApp Business Account or deactivated a tenant
# (TAR-166). Revoking one operator is deleting one entry rather than rotating
# everybody. Labels are 2-40 characters of `a-z0-9._-`.
#
# ⚠️ Deploy step, not a code change: **an unlabelled value is refused at boot**,
# with no transitional dual-accept. Every environment holding this variable —
# local, CI, staging, production — must be updated to the labelled form in the
# same release, or the API will not start.
#
# Unset means the admin surface refuses every request — an environment with no
# token cannot provision tenants, which is the safe default for a route that
# creates them. A malformed value is different: it fails the boot, because it is
# a mistake rather than a decision.
#
# The value below is a placeholder for a localhost-only stack, exactly like the
# database password above, and must never be reused anywhere else. Generate a
# real secret with `openssl rand -base64 48` and keep it in the platform's secret
# store; minimum secret length is 32 characters.
PLATFORM_ADMIN_TOKEN=local-dev:local_dev_only_platform_admin_token_not_a_secret

# The edge trust boundary (TAR-148). `TRUSTED_PROXY_SECRET` itself is declared
# once, further down with the frontend keys, because a single .env file serves
# both apps locally — see the note there for what the pair does and why the host
# rides on `x-edge-host`.
#
# Two things the API adds to it:
#
#   * It refuses to BOOT without it under NODE_ENV=production. An API that
#     cannot resolve a tenant serves nothing, so a missing secret is a failed
#     deploy the previous instance keeps serving through, rather than a healthy
#     instance answering `tenant_not_found` on every tenant route.
#   * The previous value is accepted alongside the current one, so the secret
#     can be rotated without both services swapping in the same instant. Set it
#     only during a rotation: put the old value here and the new one above, roll
#     the web tier onto the new value, then clear this.
TRUSTED_PROXY_SECRET_PREVIOUS=

# WhatsApp webhook ingestion (TAR-20). One Meta app serves every tenant, so both
# of these are platform-level secrets — tenant routing is `phone_number_id` →
# `whatsapp_accounts`, never a per-tenant secret.
#
#   WHATSAPP_APP_SECRET            verifies `X-Hub-Signature-256` over the raw
#                                  request body. Unset means every inbound
#                                  webhook is rejected, which is the safe default
#                                  for an unauthenticated public route.
#   WHATSAPP_WEBHOOK_VERIFY_TOKEN  echoed during Meta's `GET` handshake, once,
#                                  when the webhook URL is registered. Unset
#                                  means the handshake answers 403.
#
# Both come from the Meta app dashboard and belong in the platform's secret
# store. The values below are localhost placeholders and are not secrets; they
# match nothing Meta would ever send.
#
# WHATSAPP_APP_SECRET is read on a second path since TAR-161: it is also the
# `client_secret` on the Embedded Signup code exchange (see META_APP_ID below).
# One variable, not two — it is the same secret of the same Meta app, and a
# duplicate is a rotation that silently half-applies.
WHATSAPP_APP_SECRET=local_dev_only_meta_app_secret_not_a_secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=local_dev_only_verify_token_not_a_secret

# The sweeper that turns a Redis outage into lateness rather than loss: it
# re-enqueues any stored event still `received`, or stuck in `processing`, past
# WEBHOOK_STUCK_AFTER_MS. Kept well under the five minutes TAR-39 says should
# page someone, so recovery is attempted before an alert fires.
WEBHOOK_STUCK_AFTER_MS=60000
WEBHOOK_SWEEP_INTERVAL_MS=30000
# Attempts before an event is parked `failed`. Parked, never dropped.
WEBHOOK_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# SLA timers (TAR-26)
# ---------------------------------------------------------------------------

# How often the breach sweep runs, and therefore the upper bound on how late a
# supervisor learns a ticket went overdue. Thirty seconds against a 60-minute
# first-response window is 0.8% of it. The deadline itself lives in Postgres, so
# an outage of any length makes alerts late rather than absent: the first sweep
# after recovery drains the whole backlog.
SLA_SWEEP_INTERVAL_MS=30000

# ---------------------------------------------------------------------------
# Workflow automation (TAR-27)
# ---------------------------------------------------------------------------

# How often the elapsed-trigger sweep runs, and therefore the upper bound on how
# late a "ticket unresolved for N hours" rule fires. Sixty seconds against a
# four-hour threshold is 0.4% of it, and longer than the SLA interval on purpose:
# an SLA breach is a contractual deadline, an escalation threshold is a
# supervisor's own rule with a five-minute floor.
#
# The threshold lives in Postgres, so a Redis outage of any length makes
# escalations late rather than absent — the next sweep re-derives every overdue
# ticket from `created_at`. Event triggers have no such backstop.
WORKFLOW_SWEEP_INTERVAL_MS=60000

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (TAR-20)
# ---------------------------------------------------------------------------
#
# AES-256-GCM key for the per-WABA access token, base64 of 32 bytes. Unset means
# every WhatsApp connection and every send is refused — an environment with no
# key must not fall back to storing Meta credentials in clear text.
#
# The value below is a throwaway for a localhost-only stack, exactly like the
# database password above, and must never be reused anywhere else. Generate a
# real one with `openssl rand -base64 32` and keep it in the platform's secret
# store. Rotating it requires re-encrypting the stored tokens.
WHATSAPP_TOKEN_ENCRYPTION_KEY=bG9jYWxfZGV2X29ubHlfbm90X2Ffc2VjcmV0X2tleTE=

# Meta's Graph API origin and pinned version. Pinned rather than floating: Meta
# deprecates versions on a schedule, and a silent bump is how a response shape
# changes underneath a parser. `META_GRAPH_API_TIMEOUT_MS` bounds every outbound
# call — an unbounded wait on Meta becomes an unbounded wait on a worker.
META_GRAPH_API_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v23.0
META_GRAPH_API_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Embedded Signup (TAR-161)
# ---------------------------------------------------------------------------
#
# How a tenant connects its own WABA from the console: Meta hands the browser a
# short-lived code, and the server exchanges it for the business token using
# WHATSAPP_APP_SECRET above as the `client_secret`. Neither value here is a
# secret — both reach the browser as public configuration.
#
#   META_APP_ID                     `client_id` on the exchange, and what the
#                                   console launches `FB.login` with.
#   META_EMBEDDED_SIGNUP_CONFIG_ID  the Facebook Login for Business configuration
#                                   that run uses.
#
# Both are optional and fail closed at the route: unset, POST
# /api/v1/whatsapp/business-accounts answers whatsapp_signup_failed with reason
# `insufficient_permissions` and every other route is unaffected. Both are Meta
# ids, so digits only — a non-numeric value is a failed boot rather than a Graph
# call that fails per request. Left blank below: a local stack has no Meta app,
# and a made-up id would fail at Meta rather than at the door.
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=

# ---------------------------------------------------------------------------
# Media pipeline (TAR-20e)
# ---------------------------------------------------------------------------
#
# Where re-hosted WhatsApp media is written. There is no object store yet —
# ADR 0001 chose Render and took no decision on blob storage, and TAR-41 is the
# story that provisions it — so the pipeline ships against a `MediaStorage`
# port with a filesystem adapter. Swapping in an S3-compatible adapter is a
# module binding, not a rewrite.
#
# ⚠ A deployed environment MUST point this at a durable, shared volume and use
# an absolute path. A container's writable layer is neither: media written
# there vanishes on the next deploy while the rows naming it survive, and on
# more than one replica a download served by one pod cannot see what another
# wrote. It holds customer data, so it is backed up and access-controlled like
# the database.
#
# Relative paths resolve against the process working directory, which differs
# between `pnpm dev`, `pnpm test` and a container. The default below is a
# git-ignored directory at the repository root, for local work only.
MEDIA_STORAGE_ROOT=.media-storage

# Timeout for one media transfer to or from Meta. Much larger than
# META_GRAPH_API_TIMEOUT_MS on purpose: that bounds a small JSON round trip,
# this bounds a transfer that may legitimately be 100 MB.
MEDIA_DOWNLOAD_TIMEOUT_MS=60000

# Attempts an inbound download gets before the attachment is parked `failed`.
# Small on purpose: Meta's media URL is valid for five minutes, so past that
# window no further attempt can succeed.
MEDIA_DOWNLOAD_MAX_ATTEMPTS=3

# Attempts a ticket.ensure-for-message job gets before it lands in the failed
# set. Larger than the media budget: the dominant failure is a job overtaking
# the transaction that wrote its message, which the next attempt fixes.
TICKET_LINK_MAX_ATTEMPTS=5

# The migration owner. Read by the Prisma CLI (`prisma.config.mjs`) and never by
# the running API. Deployed environments override it from the platform's secret
# store (TAR-41).
DATABASE_URL=postgresql://whatsappcrm:local_dev_only@localhost:5432/whatsappcrm?schema=public

# Required whenever NODE_ENV=production — which is every deployed environment.
# The API refuses to boot without it rather than looking healthy until the first
# job. Optional locally so the app still runs with nothing behind it.
REDIS_URL=redis://localhost:6379

# Scratch database Prisma resets on every use, needed only to generate down
# migrations locally. Created by the local Docker stack. Leave unset in any
# deployed environment — `prisma migrate deploy` never touches it.
SHADOW_DATABASE_URL=postgresql://whatsappcrm:local_dev_only@localhost:5432/whatsappcrm_shadow?schema=public

# ---------------------------------------------------------------------------
# Local Docker stack (docker-compose.yml). Compose reads this file itself, so
# these are consumed by Compose rather than by the apps.
#
# The password is a throwaway for a container bound to localhost. It is not a
# secret and must never be reused anywhere else; real credentials never live in
# a committed file.
#
# If port 5432 or 6379 is already taken on your machine, change the port here
# AND in DATABASE_URL / REDIS_URL above — they are not derived from each other.
# ---------------------------------------------------------------------------
POSTGRES_USER=whatsappcrm
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=whatsappcrm
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Human-readable output for a terminal. Never enable in a deployed environment —
# the log collector parses JSON.
LOG_PRETTY=false
# A request at or above this many milliseconds is logged at warn and flagged slow.
SLOW_REQUEST_THRESHOLD_MS=1000
# Upper bound on a single readiness probe.
HEALTH_CHECK_TIMEOUT_MS=2000

# Error tracker. Leave empty locally: with no DSN the SDK is never started.
SENTRY_DSN=
# 0 disables performance tracing. Raise per environment, not per developer.
SENTRY_TRACES_SAMPLE_RATE=0

# ---------------------------------------------------------------------------
# Frontend (apps/web) — NEXT_PUBLIC_* values are inlined into the browser
# bundle. Never put a secret behind this prefix.
#
# Keys must be mirrored in apps/web/lib/config/env.ts in the same commit.
# ---------------------------------------------------------------------------

# Where the browser sends API calls. A same-origin path, rewritten to the API
# host by apps/web/next.config.mjs: a white-label tenant on its own domain would
# otherwise have its session cookie dropped as third-party (TAR-39, Decision 3).
NEXT_PUBLIC_API_BASE_URL=/api

# The absolute API origin, used by server-side rendering and server actions,
# which have no page origin to be relative to. Also the rewrite's destination.
# Server-only, so deliberately no NEXT_PUBLIC_ prefix.
#
# Needed at BUILD time, not only at runtime: next.config.mjs reads it while
# building and freezes the destination into .next/routes-manifest.json, so a
# build that cannot see it proxies the browser to localhost:3001 forever.
API_BASE_URL=http://localhost:3001/api

# Proves to the API that an x-edge-host came from our own web tier rather than
# from an arbitrary caller, so HostTenantGuard may resolve the tenant from it
# (TAR-64). Read by BOTH apps — they must agree, and when they do not the API
# resolves no tenant and every tenant route answers tenant_not_found.
#
# The host rides on x-edge-host rather than the standard x-forwarded-host because
# the web tier reaches the API over the public internet, through proxies that
# populate x-forwarded-* as a matter of course and may rewrite them (TAR-148).
#
# One entry serves both apps here because local development runs them from a
# single .env file. That is NOT true of a deployed environment: render.yaml
# declares the key separately on the web service and on the API service, and the
# two must be given the same value by hand.
#
# Server-only on the web side: never give this a NEXT_PUBLIC_ prefix, which would
# inline it into the browser bundle and hand it to every visitor. Generate a real
# one per deployed environment with `openssl rand -hex 32`; the value below is a
# local-development placeholder and must never be used anywhere else.
TRUSTED_PROXY_SECRET=local_dev_only_not_a_real_secret

# Serves every API call from apps/web's in-memory fixtures instead of HTTP.
#
# Code default is off, and it must stay off in a deployed environment. It is
# `true` here — TAR-82 built the console against the fixtures before the
# endpoints existed, and it stays on as the way to work on the console with no
# database and no API running at all. The endpoints it stood in for have since
# landed, so turning it off is now a supported local setup rather than a
# half-wired one; do that to exercise the real API.
#
# The fixtures use the same ids `pnpm db:seed` writes, so flipping this changes
# the transport and not the ids.
NEXT_PUBLIC_USE_MOCK_API=true

# ⚠️ INTERIM STUB — REMOVE WHEN TAR-35 (auth/sessions) LANDS.
# Exposes a role switcher so the agent / supervisor / admin views from TAR-22 can
# be demonstrated before real sessions exist. It changes what the browser renders
# and grants nothing: the API enforces the same permission on every request
# regardless, and `getSession()` refuses the stub under NODE_ENV=production
# whatever this says.
#
# Code default is off. It is `true` here, and only here, because a seeded local
# stack has no other way in: every seeded user's password_hash is null until
# invite acceptance (TAR-55) ships, so without the stub there is nothing to sign
# in with. Its API counterpart is AUTH_STUB_ENABLED below — turn both on or
# neither, or the two halves will disagree about who you are.
NEXT_PUBLIC_ENABLE_ROLE_STUB=true

# The console's half of Embedded Signup (TAR-169). Both values MUST equal the
# META_APP_ID and META_EMBEDDED_SIGNUP_CONFIG_ID declared above: the API exchanges
# the code with the same app the browser authorised against, and a mismatch is a
# code Meta refuses after the tenant has already been through the whole flow.
#
# They are duplicated rather than derived because a variable without the
# NEXT_PUBLIC_ prefix is not inlined into the browser bundle at all — there is no
# way for the console to read the unprefixed name. Neither is a secret: the app id
# appears in every FB.login snippet Meta publishes, and the credential that turns a
# code into a token is WHATSAPP_APP_SECRET, which never leaves the API.
#
# Left blank below, like their API counterparts: with either one unset the console
# says self-service connection is not configured instead of offering a button that
# cannot work. A malformed value is a failed build rather than a failed connection.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=

# The Graph version FB.init pins Meta's SDK to. Keep it equal to
# META_GRAPH_API_VERSION above — the two halves of one flow talking to two versions
# of one API is a difference nobody would think to look for. Optional: unset means
# the same default the API applies.
NEXT_PUBLIC_META_GRAPH_API_VERSION=v23.0

# ---------------------------------------------------------------------------
# Access control (TAR-22)
#
# ⚠️ INTERIM — REMOVE WHEN TAR-35 (auth/sessions) LANDS.
#
# TAR-35 has not shipped, so there is no session for the API to read a role
# from. `true` binds StubPrincipalSource, which resolves the caller from the
# same `wac_role_stub` cookie the console sets (or an `x-dev-role` header for
# curl) and looks up a real seeded user with that role in the tenant the request
# host resolves to. It grants nothing: every request still passes
# PermissionGuard and every query still runs under row-level security.
#
# Code default is off, and the API refuses to BOOT with it on under
# NODE_ENV=production. It is `true` here so the console works against a real API
# on a fresh clone (README, "Seed data"); leave it unset everywhere else.
#
# Its console counterpart is NEXT_PUBLIC_ENABLE_ROLE_STUB above — turn both on
# or neither, or the two halves will disagree about who you are.
AUTH_STUB_ENABLED=true

# ---------------------------------------------------------------------------
# Sessions (TAR-35)
# ---------------------------------------------------------------------------
#
# Whether the session cookie carries `Secure` and the `__Host-` prefix, which is
# what stops a sibling tenant subdomain shadowing it. `true` everywhere real —
# the API refuses to BOOT with it off under NODE_ENV=production.
#
# `false` here for one reason only: Safari does not treat plain-HTTP localhost
# as a secure context, so a `__Host-` cookie cannot be set there at all and you
# could not log in locally. It also changes the cookie *name* — `wac_session`
# rather than `__Host-wac_session` — so both halves of the stack read it from
# this one flag rather than hardcoding a spelling.
SESSION_COOKIE_SECURE=false

# Whether `request.ip` is the address of the client, which is what decides
# whether the per-client-address login failure window (TAR-59) is enforced. The
# other two layers are unconditional and are not affected by this: the durable
# per-account lockout, and the per-email lockout that fires at the same ten
# failures for an address with no account so the 429 cannot be read as "this
# account exists".
#
# Off by default. Express `trust proxy` is deliberately not set, because
# `HostTenantGuard` depends on `Host` being unforgeable, so behind a load
# balancer `request.ip` is the *proxy* and every agent in a tenant would share
# one window: twenty failures would lock the whole tenant out for fifteen
# minutes. Turn it on where the API takes client connections directly.
LOGIN_IP_THROTTLE_ENABLED=false

# ---------------------------------------------------------------------------
# Realtime (TAR-20 / TAR-69)
# ---------------------------------------------------------------------------

# Absolute origin of the Socket.IO server, handed to the browser on
# `POST /api/v1/auth/realtime-ticket` so the client never hardcodes it.
#
# This is the one URL the browser opens *directly* rather than through the
# Next.js rewrite: every HTTP call goes through the proxy so the session cookie
# stays first-party under a white-label domain, and the WebSocket cannot be
# proxied as reliably, so it carries a short-lived single-use ticket instead
# (ADR 0002 decision 3). Locally the gateway runs in the API process, so this is
# the API's own origin and matches PORT above.
#
# Not a secret: it reaches every browser. A deployed environment must set it to
# the public realtime origin — the default below would point real users at their
# own machine.
REALTIME_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Third-party credentials — one set per environment, provisioned as Render
# environment-group secrets (`render.yaml`). Development and staging take the
# provider's test credentials; production takes live ones, entered deliberately
# and never copied down from another environment.
#
#   TAR-37  Polar.sh API key and webhook signing secret
#
# WhatsApp webhook ingest (TAR-20b) belongs to the same class, but its two keys
# — WHATSAPP_APP_SECRET and WHATSAPP_WEBHOOK_VERIFY_TOKEN — are declared once,
# under the API section above, with localhost placeholders the README's webhook
# walkthrough uses. Declaring them a second time here would win: every reader of
# this format — Node's `loadEnvFile`, dotenv, Docker Compose — takes the last
# occurrence of a key, so an empty re-declaration silently blanks the value set
# earlier in the file.
#
# The WhatsApp *access token* and *phone number id* are deliberately not here and
# never will be: they are per tenant, per WABA, supplied through the admin
# connection endpoint and stored — the token encrypted — in
# `whatsapp_business_accounts`.
# ---------------------------------------------------------------------------
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
