node_modules/
dist/
build/
out/
.next/
coverage/
.turbo/
*.tsbuildinfo

# Generated by `next build` / `next typegen`.
next-env.d.ts

# Generated by `prisma generate` (apps/api/prisma/schema.prisma). Rebuilt by
# `pnpm db:generate`, which every build, typecheck and test run depends on.
apps/api/src/generated/

# Local media store (MEDIA_STORAGE_ROOT). Re-hosted WhatsApp media and the
# temporary files multipart uploads are staged through — customer data, and
# never something to commit. A deployed environment points this at a volume.
.media-storage/

# Environment — never commit real values. .env.example is the documented contract.
.env
.env.*
!.env.example

# Dump files and reports written by `pnpm db:restore-drill`. A dump of a real
# database is the database — it never belongs in the repository.
.drill/

.DS_Store
Thumbs.db
*.log
