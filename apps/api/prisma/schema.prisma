// Prisma schema — the single source of truth for the database shape.
//
// Authored by TAR-47 against the entity table in
// `docs/architecture/0002-architecture-and-api-contract.md` (TAR-39). That
// document fixes the tenancy mechanism, the entity set, the constraints that
// carry meaning, and the load-bearing indexes; this file expresses them and
// adds nothing that changes a decision recorded there.
//
// The connection URL lives in `prisma.config.mjs`, not here: Prisma 7 reads the
// datasource URL from the config file and no longer loads `.env` on its own.
//
// The `generator` block below is TAR-49's, together with `@prisma/client`, the
// `@prisma/adapter-pg` driver adapter, and the `TenantPrisma` / `SystemPrisma`
// split in `src/database`.
//
// ---------------------------------------------------------------------------
// Conventions, applied without exception
// ---------------------------------------------------------------------------
//
//  1. **Every tenant-scoped table carries a non-null `tenant_id`**, even where
//     the tenant is already reachable through a foreign key. Denormalised on
//     purpose: an RLS policy is a row predicate and cannot join (TAR-39,
//     decision 1, rule 2). TAR-48 attaches `FORCE ROW LEVEL SECURITY` and the
//     `tenant_isolation` policy to exactly the tables that have this column.
//
//  2. **Tenant-scoped foreign keys are composite** — `(tenant_id, <parent_id>)`
//     referencing the parent's `@@unique([tenantId, id])`, never the parent's
//     `id` alone. This is the one integrity property RLS cannot provide: RLS
//     stops a tenant *reading* another tenant's row, but a plain
//     `contact_id uuid REFERENCES contacts(id)` would still happily accept an
//     id belonging to another tenant if a handler took it from a request body.
//     The composite key makes that write fail in the database.
//     Cost: one extra unique index per referenced table. Paid deliberately.
//
//  3. **Composite indexes lead with `tenant_id`** (TAR-39, decision 1, rule 3),
//     so an RLS-filtered query and an application-filtered query use the same
//     index. Sort keys are `(<timestamp> DESC, id DESC)` — keyset pagination
//     needs a total order, and a UUIDv7 id is a stable tie-breaker for two rows
//     written in the same millisecond.
//
//  4. **Referential actions are only ever `Cascade` or `NoAction`.**
//     `Cascade` where the child is genuinely owned by the parent (a message
//     without its conversation is garbage). `NoAction` everywhere else —
//     including every optional user/team reference. Two reasons, both load-
//     bearing:
//       * `Restrict` is checked immediately, so it would abort a legitimate
//         `DELETE FROM tenants` whose cascade is about to remove the
//         referencing rows anyway. `NoAction` defers to end of statement and
//         lets that succeed.
//       * `SetNull` on a *composite* key nulls **every** column in the key,
//         including `tenant_id`, which is `NOT NULL`. Postgres 15+ can restrict
//         that to named columns; Prisma cannot express it. So optional
//         references are never `SetNull`, and removing a user is a status
//         change (`UserStatus.removed`), not a row delete.
//
//  5. **Ids are UUIDv7**, generated by the Prisma client (`@default(uuid(7))`).
//     No Postgres release before 18 has a native `uuidv7()` — so there is no
//     column default in the generated SQL. Anything inserting outside the
//     client (TAR-48's isolation fixture, TAR-46's seed) must supply the id.
//
//  6. **Timestamps are `timestamptz`**, millisecond precision to match what a
//     JavaScript `Date` can actually represent. Money is integer minor units
//     plus an ISO 4217 code. Phone numbers are E.164. Emails, slugs and
//     hostnames are `citext`, so `A@b.com` and `a@b.com` collide on a unique
//     index rather than becoming two accounts.

datasource db {
  provider = "postgresql"
}

// Prisma 7's generator. Notes on each option, because none of them is a default:
//
//   provider      `prisma-client` is the Prisma 7 generator. The old
//                 `prisma-client-js` wrote into `node_modules/.prisma`, which
//                 pnpm's non-flat store makes unreliable.
//   output        Required now. Inside `src` so `tsc` and `nest build` compile
//                 it with everything else; git-ignored, because generated code
//                 in review noise is worse than one `pnpm db:generate`.
//   moduleFormat  The API is CommonJS (`packages/tsconfig/nestjs.json`).
//   runtime       Plain Node, not an edge or Deno build.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

// ---------------------------------------------------------------------------
// Enums
//
// Native Postgres enums rather than text + CHECK: they are the closed sets in
// the contract, and a typo becomes an error at write time instead of a filter
// that silently matches nothing. The trade-off is that adding a value is cheap
// (`ALTER TYPE ... ADD VALUE`) but removing one is not. Anything genuinely
// open-ended — `ticket_events.type`, workflow definitions — stays text or JSON
// for exactly that reason.
// ---------------------------------------------------------------------------

/// The tenant lifecycle vocabulary, reconciled with `@whatsappcrm/contracts` by
/// TAR-403 (`20260815120000_tenant_lifecycle_status_vocabulary`).
///
/// It had carried `pending / active / suspended / cancelled` since TAR-47, while
/// `TENANT_STATUSES` published `trialing / active / past_due / suspended /
/// cancelled / deleted`. `pending` was **renamed** to `created` — one state, two
/// spellings — and the three missing labels were added. The column is now a
/// superset of the published set by exactly one label: `created` is the
/// pre-provisioning state, which no customer-facing response reports.
///
/// **The order below is the catalog's, not a preference.** `ALTER TYPE ... ADD
/// VALUE` appends, so `trialing`, `past_due` and `deleted` sort after the four
/// original labels. `prisma migrate diff` compares this list against
/// `pg_enum.enumsortorder`, and listing them in reading order would make it
/// propose a reordering that is not a real change. Nothing sorts by this column,
/// so the order carries no meaning of its own.
enum TenantStatus {
  created
  active
  suspended
  cancelled
  trialing
  past_due
  deleted

  @@map("tenant_status")
}

enum TenantDomainKind {
  platform
  custom

  @@map("tenant_domain_kind")
}

/// Why the last DNS check on a custom domain did not prove ownership (TAR-29).
/// Exactly `DOMAIN_VERIFICATION_FAILURE_REASONS` in
/// `packages/contracts/src/tenant.ts` — the value is read straight out of the
/// column onto the wire, so there is no mapping layer for the two to drift
/// through.
///
/// TAR-416's contract writes this column as `text`. A native enum instead, for
/// the reason stated at the head of this section and one specific to this
/// column: it is serialised by `z.enum(...)`, so a value the contract does not
/// know about does not degrade — it throws at the response serializer and the
/// tenant gets a 500 while looking at a settings page. The enum moves that
/// failure to the write that caused it. Adding a fifth reason is one
/// `ALTER TYPE ... ADD VALUE`, online and non-blocking.
///
/// Null means "no failure recorded": either never checked, or the last check
/// succeeded. A successful verification clears it.
enum TenantDomainVerificationFailureReason {
  record_not_found
  record_mismatch
  lookup_failed
  lookup_timeout

  @@map("tenant_domain_verification_failure_reason")
}

/// The role vocabulary, and it is exactly `TENANT_ROLES` in
/// `packages/contracts/src/rbac.ts` — no more and no less (TAR-80).
///
/// TAR-39's contract is what every guard, every response schema and the session
/// principal speak, and it names three roles. This enum carried a fourth,
/// `owner`, which no code has ever written and which no `TenantRoleSchema` would
/// accept: a row holding it would fail response validation at the serializer and
/// answer 500, not 200. Removed rather than added to the contract, because
/// TAR-22 records "three roles cover v1" as a settled assumption.
///
/// The direction matters if that assumption changes. Adding a value back is one
/// `ALTER TYPE ... ADD VALUE`, online and non-blocking. Removing one is a type
/// swap and a table rewrite — which is precisely why this is done now, while
/// `users` and `invites` are empty in every environment, rather than later.
enum UserRole {
  admin
  supervisor
  agent

  @@map("user_role")
}

enum UserStatus {
  invited
  active
  suspended
  removed

  @@map("user_status")
}

enum UserAvailability {
  available
  away
  offline

  @@map("user_availability")
}

enum WhatsappAccountStatus {
  connected
  disconnected
  error

  @@map("whatsapp_account_status")
}

/// Where a WABA stands with Meta (TAR-52). Modelled as the lifecycle — not
/// verified, submitted, cleared, refused — rather than as a transcription of
/// Meta's field, because Meta exposes two different vocabularies here (the
/// business's `verification_status` and the WABA's `account_review_status`) and
/// TAR-39 records which one the Embedded Signup flow returns as *unverified*.
/// TAR-20 confirms it against Meta's current documentation and maps onto these
/// four; a value it needs and does not find is one `ALTER TYPE ... ADD VALUE`,
/// which is the cheap direction of an enum change.
enum WhatsappBusinessVerificationStatus {
  not_verified
  pending
  verified
  rejected

  @@map("whatsapp_business_verification_status")
}

/// Meta's per-phone-number quality rating. It belongs to the number and not to
/// the business: Meta rates each number separately and throttles each one
/// separately, so two numbers under one WABA can and do sit at different
/// ratings. `unknown` is a value Meta itself returns — distinct from the column
/// being NULL, which means we have never asked.
enum WhatsappQualityRating {
  green
  yellow
  red
  unknown

  @@map("whatsapp_quality_rating")
}

enum MessageTemplateStatus {
  pending
  approved
  rejected
  paused
  disabled

  @@map("message_template_status")
}

enum CustomFieldType {
  text
  number
  date
  boolean
  select
  multi_select

  @@map("custom_field_type")
}

enum ConversationStatus {
  open
  pending
  resolved
  /// Finished, as distinct from `resolved`'s "handled, and I expect this to come
  /// back". Added by TAR-68 (`20260811170000_conversation_status_closed`) to
  /// close the drift with `CONVERSATION_STATUSES` in `@whatsappcrm/contracts`,
  /// which has published it since TAR-39 — without it, a status update the
  /// published schema calls valid reached the database as an invalid label.
  closed

  @@map("conversation_status")
}

enum MessageDirection {
  inbound
  outbound

  @@map("message_direction")
}

/// Ordered ladder for outbound messages: queued → sent → delivered → read.
/// `received` is the terminal state of an inbound message and never advances.
/// TAR-20's `isMessageStatusAdvance` reads this order so a late `sent` webhook
/// cannot un-read a message.
enum MessageStatus {
  received
  queued
  sent
  delivered
  read
  failed

  @@map("message_status")
}

enum MessageContentType {
  text
  image
  video
  audio
  document
  sticker
  location
  contacts
  interactive
  template
  system
  /// Anything Meta sends that is not modelled yet — `reaction`, `order`,
  /// `button`, and whatever it ships next. Added by TAR-20's ingestion pipeline
  /// (`20260810180000_message_content_type_unsupported`) to close the drift with
  /// `MESSAGE_TYPES` in `@whatsappcrm/contracts`, which has always published it.
  /// Recording the message is the point: the raw payload is on `webhook_events`,
  /// so a type the product learns to render later can be backfilled, and in the
  /// meantime the thread shows that *something* arrived rather than a gap.
  unsupported

  @@map("message_content_type")
}

/// What a stored binary is, in WhatsApp's own vocabulary (TAR-20e).
///
/// Not `message_content_type` reused: that enum has to cover `text`,
/// `location`, `interactive` and `unsupported`, none of which is a file, and a
/// column typed on it could hold `media_objects.kind = 'text'`. A narrower enum
/// makes that unrepresentable rather than merely wrong.
enum MediaKind {
  image
  video
  audio
  document
  /// Inbound only. Sending one needs a sticker pack registered with Meta, which
  /// the product does not model — see `UPLOADABLE_MEDIA_KINDS` in the contract.
  sticker

  @@map("media_kind")
}

/// How a stored binary came to exist. Recorded rather than inferred from
/// whether an attachment happens to reference it: retention, and whether the
/// bytes may be re-sent, both follow from this.
enum MediaSource {
  /// Downloaded from Meta after an inbound message named it.
  inbound
  /// Uploaded by an agent through `POST /api/v1/media`, before a send.
  upload

  @@map("media_source")
}

/// How far an inbound attachment has got. Downloading runs off the ingest path
/// — Meta's media endpoint is a second network call and a document may be
/// 100 MB — so there is a real interval in which a message exists and its
/// picture does not, and the inbox has to render the difference.
enum MediaDownloadState {
  pending
  stored
  /// Terminal. Meta refused, the five-minute handle expired, or the payload
  /// broke a limit. The message stays in the thread: the customer did send
  /// something, and a gap would say otherwise.
  failed

  @@map("media_download_state")
}

enum TicketStatus {
  open
  pending
  resolved
  closed

  @@map("ticket_status")
}

/// Whether routing may still act on a ticket, and if not, why (TAR-271, 0008
/// decision 3). Coarser than the router's four outcomes on purpose — *how* a
/// ticket got here is the event log's job.
enum TicketRoutingState {
  /// Created; the routing job has not reached a conclusion. The column default,
  /// so no create path has to write it.
  pending
  /// Routing placed it, by rule or by rotation. Which one is in the event log.
  assigned
  /// Routing ran and nobody was eligible. This is TAR-23's "flagged for
  /// supervisor attention".
  deferred
  /// A human assigned, reassigned or released it. **Terminal for routing**, and
  /// load-bearing: without it a re-route would overrule a supervisor who parked
  /// a ticket deliberately.
  manual

  @@map("ticket_routing_state")
}

/// The values of `FALLBACK_ASSIGNMENT_REASONS` (ADR 0007), as a PostgreSQL type.
/// One vocabulary across the decision object, `tickets.routing_deferred_reason`
/// and the `assignment_deferred` event — not three that have to be mapped.
enum TicketRoutingDeferredReason {
  /// Candidates exist and are present; every one is at their cap.
  all_at_capacity
  /// Candidates exist in the scope; none is available and recently seen.
  none_available
  /// The scope holds no active user who could ever be a candidate — an empty
  /// team, or a tenant with no agents. Distinct from `none_available` because it
  /// needs a different person to fix it.
  no_candidate_pool

  @@map("ticket_routing_deferred_reason")
}

/// ⚠️ **The declaration order is the queue order.** Postgres sorts an enum by
/// the order its labels were declared, and the ticket queue is
/// `ORDER BY priority DESC` with no sort parameter (0006, §6) — so `urgent`
/// being declared last is the whole of "urgent tickets sort to the top".
/// Reordering these labels silently inverts the queue, with no error anywhere.
/// `TICKET_PRIORITIES` in `packages/contracts/src/tickets.ts` mirrors this list
/// and `ticket-queue.int-spec.ts` asserts the ordering against a real database.
enum TicketPriority {
  low
  normal
  high
  urgent

  @@map("ticket_priority")
}

enum SlaTargetKind {
  first_response
  resolution

  @@map("sla_target_kind")
}

enum SlaTimerState {
  running
  met
  breached
  cancelled
  /// Waiting on the customer, so the clock is not running (0006, decision on
  /// pause accounting). `SLA_STATES` in `@whatsappcrm/contracts` has published
  /// `paused` since TAR-73 and `TICKET_STATUS_PAUSES_SLA` names the statuses
  /// that reach it — this enum did not carry it, so the first pause would have
  /// reached the database as an invalid label.
  ///
  /// Appended rather than inserted after `running`, exactly as `closed` was on
  /// `conversation_status`: enum order is the sort order for `ORDER BY state`,
  /// no query sorts by it, and `BEFORE`/`AFTER` placement would make
  /// `ADD VALUE IF NOT EXISTS` non-idempotent. Added by
  /// `20260813120000_sla_timer_state_paused`, which is its own migration file
  /// because PostgreSQL refuses to *use* a label in the transaction that added
  /// it and Prisma runs one migration per transaction.
  paused

  @@map("sla_timer_state")
}

enum WorkflowRunStatus {
  pending
  running
  succeeded
  failed
  /// The run happened and the conditions did not match, so no action was
  /// attempted (0009, `WORKFLOW_RUN_STATUSES`). Not `failed` — nothing went
  /// wrong — and it is the answer to "why didn't my rule fire", which is the
  /// question a supervisor brings to the run list.
  ///
  /// Appended rather than inserted before `failed`, exactly as `paused` was on
  /// `sla_timer_state`: enum order is the sort order for `ORDER BY status`, no
  /// query sorts by it, and `BEFORE`/`AFTER` placement would make
  /// `ADD VALUE IF NOT EXISTS` non-idempotent. Added by
  /// `20260816120000_workflow_run_status_skipped`, which is its own migration
  /// file because PostgreSQL refuses to *use* a label in the transaction that
  /// added it and Prisma runs one migration per transaction.
  skipped

  @@map("workflow_run_status")
}

/// What fires a workflow (0009, `WORKFLOW_TRIGGER_TYPES`). Exactly one per
/// workflow — a workflow *is* one rule (0009, decision 4).
///
/// This is a column on `workflows` as well as a field inside `definition`, and
/// the duplication is deliberate: every triggering occurrence reads "the active
/// workflows in this tenant whose trigger is X", and a JSONB extraction in that
/// predicate cannot use the composite index that also carries `position`.
enum WorkflowTriggerType {
  ticket_created
  ticket_status_changed
  ticket_assigned
  ticket_sla_breached
  /// The elapsed trigger, detected by the sweep rather than by an event
  /// (0009, decision 3). Its threshold lives in `definition`, not here.
  ticket_unresolved_for

  @@map("workflow_trigger_type")
}

/// Why a workflow was auto-deactivated (0009, `WORKFLOW_BROKEN_REASONS`).
/// Non-null exactly when that happened, and it blocks re-enabling until every
/// reference in the definition resolves again.
enum WorkflowBrokenReason {
  /// A referenced user was removed. Set in the removal transaction, beside the
  /// `assignment_rules` cleanup that already lives there (0009, decision 6).
  reference_removed
  /// A reference went missing at evaluation time — the belt-and-braces case no
  /// foreign key covers.
  reference_missing

  @@map("workflow_broken_reason")
}

/// Why a run failed (0009, `WORKFLOW_FAILURE_REASONS`). Typed rather than left
/// to `workflow_runs.error`, because a supervisor filters the run list on it and
/// free text cannot be filtered.
enum WorkflowFailureReason {
  reference_missing
  transition_refused
  ticket_gone
  run_budget_exceeded
  internal_error

  @@map("workflow_failure_reason")
}

/// What a `notifications` row is (0009, decision 7). `sla_breach` is the type
/// `sla_alerts` held before the rename, and it stays the column default so that
/// a writer which forgets the column lands on the type whose CHECK requires an
/// `sla_timer_id` and fails loudly rather than quietly inventing a category.
enum NotificationType {
  sla_breach
  workflow_notify
  workflow_broken
  /// A human asked for supervisor attention on a ticket (TAR-32/TAR-468).
  ///
  /// The third type, and the one 0006 decision 5 named as the trigger to
  /// generalise `sla_alerts` into this table. TAR-394 reached that point first
  /// at the second type, so escalation arrives into a table that already exists
  /// — which is why TAR-468 adds a value here rather than the fourth parallel
  /// alerts table ADR 0011 decision 5 specified. Two unread counts and two
  /// acknowledge endpoints is precisely what both ADRs exist to prevent.
  escalation

  @@map("notification_type")
}

enum KnowledgeDocumentStatus {
  pending
  indexed
  failed

  @@map("knowledge_document_status")
}

/// Who owns the reply in a conversation (0010 decision 5, TAR-402).
///
/// Four values where TAR-28 names three, because "the bot never engaged" and
/// "the bot gave up" are different facts and the console renders them
/// differently — an empty-knowledge-base tenant's inbox must not look like a
/// tenant whose bot is failing.
///
/// `human_active` is terminal for the conversation's active life on purpose, and
/// resets to `off` when the conversation is resolved or closed. A bot that
/// resumes after an agent has spoken talks over a colleague in front of the
/// customer, and no confidence score prevents that.
enum ConversationBotState {
  off
  bot_active
  handed_off
  human_active

  @@map("conversation_bot_state")
}

/// Who authored a message (0010 decision 14, TAR-402).
///
/// `MessageResponse.sentByAutomation` is derived from `sender_user_id IS NULL`
/// and TAR-27's workflows are about to send with a null sender too, so that flag
/// stops distinguishing a bot reply from a workflow reply — and the console has
/// to badge exactly one of them. Both stay published; `sentByAutomation` keeps
/// its meaning as `origin NOT IN (contact, agent)`.
///
/// `workflow` is deliberately absent: it is TAR-27's value to append when its
/// send action lands. 0009 claims no column of its own for message authorship,
/// so this is a seam the two stories share.
enum MessageOrigin {
  contact
  agent
  bot
  system

  @@map("message_origin")
}

enum BotTurnOutcome {
  replied
  handed_off
  suppressed

  @@map("bot_turn_outcome")
}

/// The published `HANDOFF_REASONS` list (0010 decision 6).
enum HandoffReason {
  low_confidence
  no_match
  customer_requested
  max_turns
  agent_requested
  bot_error

  @@map("handoff_reason")
}

enum BillingInterval {
  month
  year

  @@map("billing_interval")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
  incomplete

  @@map("subscription_status")
}

enum WebhookEventStatus {
  received
  processing
  processed
  failed

  @@map("webhook_event_status")
}

enum IdempotencyKeyState {
  in_progress
  completed

  @@map("idempotency_key_state")
}

/// Who an `audit_logs` row is attributed to (TAR-166). `actor_user_id` alone
/// could not say: NULL there meant both "the platform acted" and "nothing
/// recorded who", and those are different answers to the question this table
/// exists to answer.
///
/// `unattributed` is a **backfill value only** — it belongs to rows written
/// before attribution existed, and to any row an instance predating this release
/// wrote during the rollout. Application code writes from `AuditActorType` in
/// `src/audit/audit-actor.ts`, which does not include it.
enum AuditActorType {
  user
  platform_operator
  system
  unattributed

  @@map("audit_actor_type")
}

/// What kind of event caused a tenant lifecycle edge (ADR 0009), and exactly
/// `LIFECYCLE_TRIGGERS` in `packages/contracts/src/tenant.ts` — no more and no
/// less.
///
/// Distinct from `AuditActorType`, which says *who*. Both are recorded on every
/// transition because either alone is ambiguous: a `billing_event` can be
/// hand-posted by an operator, and a `timer` fires with `system` as its actor
/// and nobody behind it.
enum LifecycleTrigger {
  user_action
  operator_action
  billing_event
  timer
  system

  @@map("lifecycle_trigger")
}

// ---------------------------------------------------------------------------
// Tenancy — TAR-19 / TAR-29 / TAR-36
// ---------------------------------------------------------------------------

/// The only table that is not tenant-scoped by design: it *is* the tenant.
/// Never RLS-protected, and reachable only through `SystemPrisma`.
model Tenant {
  id          String       @id @default(uuid(7)) @db.Uuid
  /// Stable, human-readable handle. Used for the platform subdomain and in
  /// support tooling. `citext` so `Acme` and `acme` cannot both exist.
  slug        String       @unique @db.Citext
  name        String
  status      TenantStatus @default(created)
  trialEndsAt DateTime?    @map("trial_ends_at") @db.Timestamptz(3)
  /// Set by TAR-51. Deactivation retains data and revokes access.
  suspendedAt DateTime?    @map("suspended_at") @db.Timestamptz(3)

  /// When the tenant last entered `cancelled` (TAR-403). Kept through a
  /// reactivation — `cancelled → active` is a legal transition — so support can
  /// still answer "when did they leave".
  cancelledAt       DateTime? @map("cancelled_at") @db.Timestamptz(3)
  /// When the grace period currently running expires, after which the retention
  /// sweeper moves the tenant on. Null when no timer is running.
  ///
  /// The *length* of a grace period is TAR-397's, published as a constant; only
  /// the instant lives here. That is what lets a revised duration take effect
  /// without a migration, and stops it silently reinterpreting a timer already
  /// running for a live tenant.
  gracePeriodEndsAt DateTime? @map("grace_period_ends_at") @db.Timestamptz(3)
  /// The earliest instant hard-delete may run. Null until the retention window
  /// starts. Nothing purges before it passes.
  purgeAt           DateTime? @map("purge_at") @db.Timestamptz(3)
  /// When the first purge batch began (ADR 0009). Stamped in the same
  /// transaction that enqueues the `tenant_deleted` email, before the first
  /// `DELETE`, so a purge that crashes half-way **resumes** rather than
  /// restarting — and so a half-purged tenant is distinguishable from a queued
  /// one, which is the condition the stuck-purge alert fires on. Null until the
  /// purge starts.
  ///
  /// Not indexed: the sweep finds these rows through `tenants_purge_at_idx` and
  /// reads this off the row it already has.
  purgeStartedAt    DateTime? @map("purge_started_at") @db.Timestamptz(3)
  /// When the purge ran. The row **survives** it as a tombstone holding
  /// `status = deleted`, which is what keeps `lifecycle_audit_log` permanent —
  /// a child table cannot outlive a parent row that is gone.
  ///
  /// `tenants_deleted_at_matches_status` makes this and `status` agree in both
  /// directions. It is a CHECK, so it lives in the migration rather than here.
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  domains                  TenantDomain[]
  branding                 TenantBranding?
  settings                 TenantSettings?
  users                    User[]
  sessions                 Session[]
  passwordResetTokens      PasswordResetToken[]
  invites                  Invite[]
  inviteTeams              InviteTeam[]
  teams                    Team[]
  teamMembers              TeamMember[]
  whatsappBusinessAccounts WhatsappBusinessAccount[]
  whatsappAccounts         WhatsappAccount[]
  messageTemplates         MessageTemplate[]
  contacts                 Contact[]
  tags                     Tag[]
  contactTags              ContactTag[]
  customFieldDefs          CustomFieldDef[]
  conversations            Conversation[]
  messages                 Message[]
  mediaObjects             MediaObject[]
  attachments              MessageAttachment[]
  internalNotes            InternalNote[]
  tickets                  Ticket[]
  ticketEvents             TicketEvent[]
  ticketCounter            TicketCounter?
  assignmentRules          AssignmentRule[]
  assignmentStates         AssignmentState[]
  slaPolicies              SlaPolicy[]
  slaTimers                SlaTimer[]
  notifications            Notification[]
  ticketTags               TicketTag[]
  workflows                Workflow[]
  workflowRuns             WorkflowRun[]
  workflowReferences       WorkflowReference[]
  aiConfig                 AiConfig?
  knowledgeDocs            KnowledgeDocument[]
  knowledgeChunks          KnowledgeChunk[]
  botTurns                 BotTurn[]
  handoffEvents            HandoffEvent[]
  cannedResponses          CannedResponse[]
  subscription             Subscription?
  usageCounters            UsageCounter[]
  webhookEvents            WebhookEvent[]
  idempotencyKeys          IdempotencyKey[]
  auditLogs                AuditLog[]
  /// No `lifecycleEvents` relation, and that is ADR 0009 Amendment 1 ruling 2:
  /// the trail carries `tenant_id` as a recorded identifier with no foreign key,
  /// so it survives the purge that empties everything else on this list.
  entitlements             TenantEntitlements?

  @@index([status])
  /// Two indexes are missing from this block on purpose. The retention sweeper's
  /// `tenants_grace_period_ends_at_idx` and `tenants_purge_at_idx` are
  /// **partial** (`WHERE <column> IS NOT NULL`), so each holds one entry per
  /// tenant with a timer actually running rather than one per tenant. Prisma
  /// cannot express an index predicate, so they live in raw SQL in
  /// `20260815130000_tenant_lifecycle_retention_audit_and_limits` — the same
  /// arrangement as `users_tenant_id_locked_until_idx`. Prisma's describer skips
  /// predicated indexes, so `migrate dev` proposes neither to create nor to drop
  /// them and this is not drift.
  @@map("tenants")
}

/// Every tenant lifecycle transition, append-only (TAR-403).
///
/// **Not folded into `audit_logs`**, and the reasons all point the same way:
/// `from_state` and `to_state` are typed columns here where `audit_logs` could
/// only carry them inside free-form `metadata`, and a state machine whose
/// history is untyped JSON cannot be reconstructed by a query; append-only is
/// enforced rather than assumed; and the retention rule differs — this table
/// outlives the tenant's data.
///
/// **Platform-level, not tenant-scoped** (ADR 0009 decision 5, confirmed by
/// Amendment 1 ruling 2). No foreign keys and no `tenant_isolation` policy:
/// `tenantId` and `actorUserId` are recorded identifiers that outlive the rows
/// they name. The composite FK to `users` that TAR-403 shipped made the purge
/// impossible to finish — the purge deletes every `users` row and keeps the
/// `tenants` row as the slug tombstone, so a retained event carrying
/// `actorUserId` blocked that delete with SQLSTATE 23503, and it could not be
/// repaired on the way past because the append-only trigger refuses the UPDATE
/// and neither role holds DELETE.
///
/// It is `system-only` in `tenant-scope.extension.ts` and the app role holds
/// **no grant at all** — the third table where the grant rather than RLS is the
/// enforcement, alongside `webhook_events` and `tenant_signups`. That is not
/// optional: the table still carries `tenant_id`, so a grant without the policy
/// would expose every tenant's history to the tenant connection.
/// `verify-tenant-isolation.sql` asserts the absent grant by name.
///
/// **Append-only is enforced twice.** `prisma/sql/app-roles.sql` grants
/// `SELECT, INSERT` to `whatsappcrm_system` only and withholds `UPDATE, DELETE`
/// from it too, which constrains the application. The
/// `lifecycle_events_append_only` trigger raises `TN002` on any UPDATE including
/// the table owner's, which constrains us. DELETE is not blocked by the trigger
/// and no longer needs to be: with both foreign keys gone there is no cascade
/// left that could reach these rows.
model LifecycleEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  /// TAR-166's attribution triple, reused verbatim so support tooling reads one
  /// vocabulary across both audit tables. Unlike `audit_logs.actor_type` there
  /// is **no default**: a table that starts empty has no rollout window, so every
  /// writer states who acted or the insert fails.
  ///
  /// `lifecycle_events_actor_attribution` makes the three agree — a `user`
  /// row names a user and carries no label, a `platform_operator` row carries a
  /// label and names no user, `system` and `unattributed` carry neither.
  ///
  /// `actorUserId` is **not** a relation. It records who acted and keeps
  /// recording it after that user is purged, which is the whole point of a trail
  /// that outlives the tenant.
  actorType   AuditActorType @map("actor_type")
  actorUserId String?        @map("actor_user_id") @db.Uuid
  actorLabel  String?        @map("actor_label")

  /// Null only for the first row of a tenant's history — its creation, and the
  /// rows the migration backfilled for tenants that predate this table.
  /// `lifecycle_events_transition_changes_state` refuses any other row whose
  /// two states are equal: that is not a transition.
  fromState TenantStatus? @map("from_state")
  toState   TenantStatus  @map("to_state")

  /// What **kind of event** caused this edge — a different question from
  /// `actorType`'s "who", and both are needed to say a transition was
  /// legitimate: an operator can cause a `billing_event` by hand-posting a
  /// webhook, and a `timer` fires with `actorType = system` and no actor at all.
  ///
  /// No default, like `actorType`: every writer states it, which is what makes
  /// "no `active → past_due` from a button" assertable rather than aspirational.
  /// Rows backfilled by TAR-403 carry `system` — the platform put them in the
  /// state they record.
  trigger LifecycleTrigger

  /// When the tenant-admin notification for this transition was sent. **Null
  /// means one is owed**, and the lifecycle sweep re-enqueues any row still
  /// holding null a minute after it was written: the row is the truth, the queue
  /// is an accelerator.
  ///
  /// The single column on this append-only table that may ever be `UPDATE`d, and
  /// only null → value, once. Two things hold that: a **column-level** `GRANT
  /// UPDATE ("notified_at")` to `whatsappcrm_system` alone in
  /// `prisma/sql/app-roles.sql` — table-level UPDATE stays withheld — and the
  /// `lifecycle_events_append_only` trigger, which refuses the stamp unless the
  /// old value was null and every other column is identical.
  ///
  /// Its sweep index is **partial** (`WHERE notified_at IS NULL`) and keyed on
  /// `occurredAt`, which Prisma can express neither half of, so it lives in raw
  /// SQL in `20260815160000_lifecycle_trigger_notification_backstop_and_purge_resume`
  /// and Prisma's describer skips it — not drift.
  notifiedAt DateTime? @map("notified_at") @db.Timestamptz(3)

  /// Free text, written by whoever caused the transition. Never PII.
  reason   String?
  /// A redacted before/after at most — never PII, never a secret value.
  metadata Json?

  /// The read endpoint: this tenant's history, newest first, keyset-paginated.
  /// The only index on the table — a tenant accumulates a handful of these over
  /// its whole life, so a second one would cost a write per transition and never
  /// beat the scan it replaced.
  @@index([tenantId, occurredAt(sort: Desc), id(sort: Desc)])
  @@map("lifecycle_events")
}

/// The tenant's **effective** entitlements — the only thing write-time
/// enforcement reads, and the only thing the console displays (TAR-403, widened
/// and renamed by ADR 0009 Amendment 1 ruling 3).
///
/// **Why per tenant rather than per plan.** `plans.entitlements` is the
/// catalogue and it belongs to TAR-37, which is still in `backlog` and whose
/// table today is populated only by the demo seed. Reaching for it would mean
/// fixing that column's JSON shape and requiring a `subscriptions` row per
/// tenant — both decisions belonging to the story that owns billing. It is also
/// platform-wide and so carries no RLS policy, while the enforcement TAR-405
/// needs runs on the tenant connection.
///
/// **Why the whole shape rather than two caps.** `TenantLifecycleResponse.plan`
/// publishes `PlanEntitlements`, so a table holding two of the five limits and
/// no `features` could not populate the response at all. Widening it here means
/// enforcement and display read the same row — the failure that prevents is a
/// console showing "3 of 3" from one store while the refusal the admin just got
/// came from another.
///
/// The row is a **snapshot** of the catalogue, not a pointer to it: a tenant
/// keeps what it was sold when the catalogue moves under it. When TAR-37 lands,
/// its plan sync becomes this table's writer.
///
/// **Why not columns on `TenantSettings`**, whose comment invites exactly that:
/// settings are edited by the tenant's own admins, and a seat cap the capped
/// party can raise is not a cap. A separate table is a separate grant.
model TenantEntitlements {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  /// Which plan these entitlements were taken from. `trial` for a self-signup
  /// tenant; `unlimited` on the rows the migration backfilled for tenants
  /// provisioned by an operator before self-signup existed, which were never
  /// sold a cap. Bounded to `PlanSchema.key`'s shape by
  /// `tenant_entitlements_plan_key_format`.
  planKey String @default("trial") @map("plan_key")

  /// Display name for `planKey`, so `TenantLifecycleResponse.plan` maps from
  /// this one row with no join.
  planName String @default("Trial") @map("plan_name")

  /// `PlanEntitlementsSchema`: `{ features: PlanFeature[], limits: { seats,
  /// conversationsPerPeriod, whatsappNumbers, teams, knowledgeDocuments } }`.
  /// **A null limit means unlimited**, deliberately not `-1` or a sentinel
  /// maximum, both of which invite arithmetic bugs at the comparison site.
  ///
  /// `tenant_entitlements_shape` is the database backstop — it asserts the five
  /// limit keys are present and each is null or a positive integer, and that
  /// `features` is an array. It cannot check the feature *values*, so
  /// `PlanEntitlementsSchema` at every write site is the actual contract. A
  /// CHECK on jsonb is not expressible in Prisma, so it lives in
  /// `20260815180000_lifecycle_events_and_tenant_entitlements`.
  ///
  /// The default is 0009's published trial shape — defensible rather than
  /// measured, and a column default so provisioning inserts a row without
  /// restating it. TAR-397 owns the real figures.
  entitlements Json @default("{\"features\":[\"assignment_rules\",\"sla_policies\"],\"limits\":{\"seats\":3,\"conversationsPerPeriod\":1000,\"whatsappNumbers\":1,\"teams\":2,\"knowledgeDocuments\":10}}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_entitlements")
}

/// A self-signup between the form and the tenant existing (TAR-440, ADR 0009
/// decision 3). `POST /api/v1/signup` writes one row here and sends one email;
/// nothing is provisioned. `POST /api/v1/signup/verify` consumes the row and only
/// then calls `TenantProvisioningService.provision()`.
///
/// **The fourth table with no tenant scoping**, and the second where the *grant*
/// rather than RLS is the enforcement. A policy needs a tenant to compare
/// against and there is none: at insert the tenant has not been provisioned and
/// the caller is anonymous. `webhook_events` is the precedent, and this model is
/// `system-only` in `tenant-scope.extension.ts` for the same reason —
/// `whatsappcrm_app` is granted nothing on the table at all.
///
/// Consumption is one conditional statement, the pattern `InviteService.accept`
/// already sets — `UPDATE … WHERE consumed_at IS NULL AND expires_at > now()
/// RETURNING` — so the update itself is the concurrency control and two
/// simultaneous uses of one link cannot both call `provision()`.
model TenantSignup {
  id    String @id @default(uuid(7)) @db.Uuid
  email String @db.Citext

  /// The platform subdomain the signup asked for. Held as a **soft reservation**
  /// by `tenant_signups_slug_reserved`, a partial unique index over
  /// `(desired_slug) WHERE consumed_at IS NULL` — so an unconsumed row holds the
  /// name and a consumed one releases nothing, because the tenant holds it by
  /// then. Missing from this block on purpose: Prisma cannot express an index
  /// predicate, so it lives in raw SQL in `20260815140000_tenant_signups`.
  ///
  /// ⚠️ That predicate cannot carry `AND expires_at > now()` — an index
  /// predicate must be IMMUTABLE — so an abandoned signup holds its slug until
  /// something deletes it. TAR-405's insert path must delete expired unconsumed
  /// rows for the slug in its own transaction before inserting. Same trap, same
  /// answer, as `invites_one_live_per_email`.
  ///
  /// `tenant_signups_desired_slug_format` restates `TenantSlugSchema`: a
  /// reservation the tenant could never be given squats a name for nothing.
  desiredSlug String @map("desired_slug") @db.Citext

  tenantName String @map("tenant_name")
  adminName  String @map("admin_name")

  /// Argon2id at the same cost parameters as `users.password_hash`, taken at
  /// signup so verification is one click and not a second form. ADR 0009 records
  /// the call: a verify page that asks for a password is one an attacker who
  /// intercepted the link can *complete*, where one that only confirms is not.
  /// An unconsumed row is removed by the expiry sweep, so an abandoned signup
  /// leaves no credential behind.
  passwordHash String @map("password_hash")

  /// SHA-256 hex of the token, as `sessions`, `invites` and
  /// `password_reset_tokens`. The token itself is never stored, so a database
  /// leak yields no usable verification link. ADR 0009 sketched this as `bytea`;
  /// `text` keeps it on the one hashing idiom the other three share — see the
  /// migration header.
  tokenHash String @unique @map("token_hash")

  /// Seed `tenant_settings` on provisioning. Null means "take that table's own
  /// default" rather than restating `UTC` / `en` somewhere they could drift.
  timezone String?
  locale   String?

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)

  /// The tenant this signup produced, written on consumption. Forensics only.
  ///
  /// **No relation and no foreign key**, and it is not called `tenant_id`. It is
  /// a backreference rather than a scoping key, it has to survive the tenant's
  /// purge, and `pnpm db:verify:rls` requires every table carrying a `tenant_id`
  /// column to have FORCEd RLS and a `tenant_isolation` policy — a rule this
  /// table cannot satisfy and should not be exempted from.
  ///
  /// `tenant_signups_provisioned_implies_consumed` makes a row that names a
  /// tenant also be consumed. One way only: the consuming UPDATE has to win its
  /// race before `provision()` can return an id.
  provisionedTenantId String? @map("provisioned_tenant_id") @db.Uuid

  /// Abuse review only — never a filter, never shown to a user. Rate limiting is
  /// Redis-backed, in the shape `LoginThrottleService` already uses.
  ipAddress String?  @map("ip_address") @db.Inet
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// A third index is missing from this block for the same reason as the
  /// reservation above: `tenant_signups_expires_at_idx` is **partial** over
  /// `(expires_at) WHERE consumed_at IS NULL`, which is exactly the expiry
  /// sweep's predicate. Consumed rows are kept and their `expires_at` is in the
  /// past too, so an unpartial index would hand the sweep every signup ever
  /// completed. Raw SQL in `20260815140000_tenant_signups`.
  @@map("tenant_signups")
}

/// Host → tenant resolution (TAR-39, decision 2, step 1). `hostname` is unique
/// **globally**, not per tenant: it is the lookup key on an unauthenticated
/// request, so two tenants claiming one host has no correct answer.
///
/// That global unique index is also the collision rule for custom domains
/// (TAR-29), and it works under RLS because **unique indexes are enforced below
/// row-level security**: a tenant inserting a hostname another tenant holds gets
/// a unique violation without being able to read, or learn anything about, the
/// conflicting row. The API maps the violation to `conflict` and must not try to
/// read that row back.
///
/// ⚠️ Three database objects on this table are invisible to Prisma — it cannot
/// express a partial index or a CHECK constraint, and its describer skips
/// predicated indexes, so `migrate dev` neither regenerates them nor reports
/// their absence as drift. They live in
/// `20260815120000_branding_and_custom_domains/migration.sql` and are asserted
/// by `src/prisma/tenant-branding-domains.int-spec.ts`:
///
///   * `tenant_domains_one_primary` — UNIQUE (tenant_id) WHERE is_primary.
///     `TenantLinkService.primaryHostname()` builds invite and password-reset
///     links from this row; two primaries makes which link a recipient gets
///     depend on row order.
///   * `tenant_domains_unverified` — (verification_requested_at)
///     WHERE verified_at IS NULL. The verification sweeper's work queue.
///   * `tenant_domains_custom_needs_token` — CHECK: a custom domain always
///     carries a token; a platform subdomain never needs one.
model TenantDomain {
  id         String           @id @default(uuid(7)) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  hostname   String           @unique @db.Citext
  kind       TenantDomainKind @default(platform)
  /// Custom domains are unverified until DNS and TLS check out (TAR-29). An
  /// unverified row must not resolve a request.
  verifiedAt DateTime?        @map("verified_at") @db.Timestamptz(3)
  isPrimary  Boolean          @default(false) @map("is_primary")

  /// 32 hex characters from a CSPRNG, published by the tenant as
  /// `whatsappcrm-domain-verification=<token>` at
  /// `_whatsappcrm-challenge.<hostname>`.
  ///
  /// **Stored in plaintext, deliberately.** Unlike a session or a reset token
  /// this one is published in public DNS, so it is not a credential and hashing
  /// it would only stop us re-displaying the record the tenant has to paste.
  /// It authorises nothing on its own: proving it means controlling that
  /// hostname's DNS, and it is scoped to one hostname and one tenant.
  ///
  /// Null exactly when `kind = 'platform'` — ours to issue, nothing to prove.
  /// `tenant_domains_custom_needs_token` enforces the other direction.
  verificationToken         String?                                @map("verification_token")
  /// When the claim was made. Starts the squat-expiry clock:
  /// `DOMAIN_VERIFICATION_TTL_DAYS` after this, an unverified row is deleted by
  /// the sweeper and the hostname is released for anyone else to claim.
  verificationRequestedAt   DateTime?                              @map("verification_requested_at") @db.Timestamptz(3)
  verificationLastCheckedAt DateTime?                              @map("verification_last_checked_at") @db.Timestamptz(3)
  /// Drives the sweeper's exponential backoff, so a domain whose DNS is never
  /// going to appear is retried less often rather than every cycle.
  verificationAttempts      Int                                    @default(0) @map("verification_attempts")
  verificationFailureReason TenantDomainVerificationFailureReason? @map("verification_failure_reason")

  /// Set when a platform operator attaches the domain at the edge and its
  /// certificate is issued — never by the tenant. Verification and activation
  /// are separate halves on purpose: a verified-but-unattached domain receives
  /// no traffic, an attached-but-unverified one resolves to nothing, and neither
  /// party controls both (TAR-416, "Delivery / Resolution / Authorisation").
  activatedAt DateTime? @map("activated_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_domains")
}

/// White-label presentation, one row per tenant (TAR-29 owns the contents).
///
/// The row is created lazily on the first branding write, not at provisioning —
/// `TenantProvisioningService` says so in its own comment, and a tenant that has
/// configured nothing genuinely has nothing here.
///
/// **Every column stays nullable, and that is a decision rather than an
/// oversight.** `BRANDING_DEFAULTS` in `packages/contracts` fills the product
/// name and both colours when a row or a column is absent, so the response is
/// always fully populated and the frontend renders unconditionally. A
/// `NOT NULL DEFAULT` here would instead bake the platform's own brand into
/// every row and make "has this tenant customised anything" unanswerable.
///
/// ⚠️ Four CHECK constraints on this table are invisible to Prisma; they live in
/// `20260815120000_branding_and_custom_domains/migration.sql` and are asserted by
/// `src/prisma/tenant-branding-domains.int-spec.ts`:
/// `tenant_branding_logo_complete` / `tenant_branding_favicon_complete` (an
/// asset's four columns are all null or all set) and
/// `tenant_branding_primary_color_hex` / `tenant_branding_accent_color_hex`
/// (`#rrggbb`, matching `HexColorSchema`).
model TenantBranding {
  id           String  @id @default(uuid(7)) @db.Uuid
  tenantId     String  @unique @map("tenant_id") @db.Uuid
  productName  String? @map("product_name")
  primaryColor String? @map("primary_color")
  accentColor  String? @map("accent_color")
  supportEmail String? @map("support_email") @db.Citext

  /// Key in the `MediaStorage` port, `tenants/<tenantId>/branding/<storageId>` —
  /// not a row in `media_objects`, whose kinds, mime allow-list and retention
  /// sweep are Meta's Cloud API vocabulary and would collect a logo as
  /// unreferenced (TAR-416, "Technology Choices").
  ///
  /// No URL is stored. The same row is served under a platform subdomain **and**
  /// under a custom domain, so an absolute URL would name whichever host existed
  /// at write time and make the browser fetch cross-origin under the other —
  /// which drops the session cookie (0002, decision 3). The wire carries the
  /// relative path `brandingAssetPath()` builds. This is what replaced the
  /// `logo_url` / `favicon_url` columns.
  logoStorageKey    String?   @map("logo_storage_key")
  /// Sniffed from the bytes at upload, never taken from the request's declared
  /// `Content-Type`, and echoed back as the response's `Content-Type`.
  logoMimeType      String?   @map("logo_mime_type")
  /// A number an operator can sum per tenant, which is the reason this is four
  /// columns rather than one JSON blob.
  logoSizeBytes     Int?      @map("logo_size_bytes")
  /// The `?v=` cache-buster on the asset path, and the pivot between a one-year
  /// `immutable` response and a 60-second one.
  logoUpdatedAt     DateTime? @map("logo_updated_at") @db.Timestamptz(3)
  faviconStorageKey String?   @map("favicon_storage_key")
  faviconMimeType   String?   @map("favicon_mime_type")
  faviconSizeBytes  Int?      @map("favicon_size_bytes")
  faviconUpdatedAt  DateTime? @map("favicon_updated_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_branding")
}

/// Operational defaults, one row per tenant — the "settings" of TAR-19's first
/// acceptance criterion. Deliberately small: feature stories add their own
/// columns here rather than inventing a second settings table.
model TenantSettings {
  id                          String @id @default(uuid(7)) @db.Uuid
  tenantId                    String @unique @map("tenant_id") @db.Uuid
  /// IANA zone name. Drives business hours, SLA calculation and report
  /// bucketing; timestamps themselves are always stored `timestamptz`.
  timezone                    String @default("UTC")
  locale                      String @default("en")
  /// `{ mon: [{ from: "09:00", to: "17:00" }], ... }`. JSON because the shape
  /// is presentation-driven and TAR-26 owns its interpretation.
  businessHours               Json?  @map("business_hours")
  /// How many active tickets one agent may hold before rotation skips them
  /// (TAR-272, 0008 decision 4). The tenant-wide default, so a new tenant routes
  /// correctly with nothing configured; `users.max_concurrent_tickets` overrides
  /// it per agent. Bounded 1–1000 by
  /// `tenant_settings_default_max_concurrent_tickets_range` in the migration.
  ///
  /// Five is a defensible starting value, **not a measured one**, and it is
  /// duplicated in `ASSIGNMENT_POLICY.defaultMaxConcurrentTickets` — which is
  /// the fallback for a tenant with no settings row at all, not a second source
  /// of truth. The two move together.
  defaultMaxConcurrentTickets Int    @default(5) @map("default_max_concurrent_tickets")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

// ---------------------------------------------------------------------------
// Identity and access — TAR-22 / TAR-35
// ---------------------------------------------------------------------------

/// The "agents" of TAR-19's acceptance criteria. Identity is **tenant-scoped**:
/// `UNIQUE (tenant_id, email)`, not a global unique email (TAR-39, decision 2).
/// Someone who works for two client organisations gets two accounts. TAR-39
/// records this as worth confirming with Tarek before TAR-35 ships, and records
/// the additive migration path if it turns out to be wrong.
model User {
  id           String           @id @default(uuid(7)) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  email        String           @db.Citext
  /// Argon2id (TAR-39, security). Null for a user who has been invited but has
  /// not yet accepted.
  passwordHash String?          @map("password_hash")
  name         String
  avatarUrl    String?          @map("avatar_url")
  role         UserRole         @default(agent)
  status       UserStatus       @default(invited)
  availability UserAvailability @default(offline)
  lastLoginAt  DateTime?        @map("last_login_at") @db.Timestamptz(3)
  /// `UserResponse.lastSeenAt` (TAR-39's users contract), and not the same thing
  /// as `last_login_at`: an agent who logged in on Monday and is working now is
  /// "last seen" now. The truth lives in `sessions.last_seen_at`, but reading it
  /// per row would make the people list an aggregate over `sessions` for every
  /// user, and sessions are swept on expiry, so the history disappears with
  /// them. Denormalised here instead, written by the same session-touch path
  /// that maintains `sessions.last_seen_at` (TAR-35), which is already rate
  /// limited by the principal cache TTL — so this is at most one extra UPDATE
  /// per user per minute, not one per request.
  lastSeenAt   DateTime?        @map("last_seen_at") @db.Timestamptz(3)

  /// Lockout state (TAR-53, decision 3), and the reason it is three durable
  /// columns rather than a Redis counter: TAR-35 requires a lockout to be
  /// *observable to a tenant admin*, and a counter that evaporates on an
  /// eviction cannot answer "is this account locked, and since when".
  ///
  /// `failed_login_attempts` is monotonic between successes — the lockout fires
  /// on every positive multiple of `AUTH_POLICY.loginFailureThreshold`, so an
  /// attacker who waits out one window does not get a fresh allowance of ten.
  /// A successful login resets it to zero along with `locked_until`.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  /// Distinguishes "locked right now" from "locked last March" in the admin
  /// list. `locked_until` alone cannot: it is cleared on the next success.
  lastFailedLoginAt   DateTime? @map("last_failed_login_at") @db.Timestamptz(3)
  /// The lockout itself. Compared against the database's `now()`, never a
  /// node's clock, so skew between API instances cannot end one early.
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)

  /// Per-agent override of `tenant_settings.default_max_concurrent_tickets`
  /// (TAR-272, 0008 decision 4). **Null means inherit**, rather than copying the
  /// default onto every user at creation: a supervisor raising the tenant
  /// default should move everyone who has not been singled out, and a copied
  /// value silently would not.
  ///
  /// Bounded 1–1000 by `users_max_concurrent_tickets_range`, a CHECK that lives
  /// in the migration because Prisma cannot express one. The floor is 1, not 0 —
  /// "route nothing to me" is what `availability = 'away'` already means.
  ///
  /// Writing it requires `assignment_rule:write` and not merely `user:update`:
  /// setting a colleague's cap to 1 is deciding how much work reaches them,
  /// which is the same act as writing a routing rule.
  maxConcurrentTickets Int? @map("max_concurrent_tickets")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions              Session[]
  passwordResetTokens   PasswordResetToken[]
  invitesSent           Invite[]
  teamMemberships       TeamMember[]
  assignedConversations Conversation[]
  sentMessages          Message[]
  uploadedMedia         MediaObject[]
  internalNotes         InternalNote[]
  assignedTickets       Ticket[]             @relation("TicketAssignee")
  /// The two sides of TAR-30's per-agent breakdown (0010 decision 4). Named
  /// because there are now three relations between `User` and `Ticket`, and
  /// Prisma refuses more than one unnamed relation between a pair of models.
  ticketsFirstResponded Ticket[]             @relation("TicketFirstResponder")
  ticketsResolved       Ticket[]             @relation("TicketResolver")
  ticketEvents          TicketEvent[]
  assignmentRules       AssignmentRule[]
  assignmentCursors     AssignmentState[]
  notifications         Notification[]
  workflowReferences    WorkflowReference[]
  cannedResponses       CannedResponse[]
  auditLogs             AuditLog[]
  /// No `lifecycleEvents` relation. `lifecycle_events.actor_user_id` records who
  /// acted and keeps recording it after the purge deletes this row — the
  /// composite foreign key it used to carry is what made that purge impossible
  /// to finish (ADR 0009 Amendment 1 ruling 2).

  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  /// One index is missing from this block on purpose:
  /// `users_tenant_id_locked_until_idx` is **partial**
  /// (`WHERE locked_until IS NOT NULL`), so the admin list can surface locked
  /// accounts without scanning a table where almost every row has a NULL there.
  /// Prisma cannot express an index predicate, so it lives in raw SQL in
  /// `20260811150000_auth_schema_and_policies` — the same arrangement as
  /// `tickets_one_active_per_contact` (TAR-74). Prisma's describer skips
  /// predicated indexes entirely, so `migrate dev` proposes neither to create
  /// nor to drop it and this is not drift. Nothing regenerates it from this
  /// file alone.
  @@map("users")
}

/// Opaque server-side sessions (TAR-39, decision 2). The token itself is never
/// stored — only its hash — so a database leak does not hand over live sessions.
model Session {
  id                String    @id @default(uuid(7)) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  /// The *sliding* idle deadline: `now() + AUTH_POLICY.sessionIdleMs`, pushed
  /// forward on use but never past `absolute_expires_at`.
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  /// The cap the sliding window may not cross —
  /// `created_at + AUTH_POLICY.sessionAbsoluteMs` (TAR-53, decision 1). Stored
  /// rather than derived from `created_at` so the sweep is one index range scan
  /// instead of a computed predicate over every row, and so the cap can be
  /// shortened for one session (a suspicious login) without a schema change.
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Why this session died: `logout` / `logout_all` / `password_change` /
  /// `password_reset` / `deactivation` / `admin`. Free text rather than an enum
  /// — it is an audit annotation nothing branches on, and TAR-57/58/59 will add
  /// reasons; `ALTER TYPE` for a label no query filters on is cost without
  /// benefit. Null on a live session, and on one that simply expired.
  revokedReason     String?   @map("revoked_reason")
  lastSeenAt        DateTime? @map("last_seen_at") @db.Timestamptz(3)
  ipAddress         String?   @map("ip_address") @db.Inet
  userAgent         String?   @map("user_agent")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  /// Bulk revoke on a role change or a password reset.
  @@index([tenantId, userId])
  /// The expiry sweep, which runs across tenants under `SystemPrisma`.
  @@index([expiresAt])
  /// The other half of that sweep. A row can be past its absolute cap while its
  /// sliding `expires_at` is still in the future — that is the whole point of a
  /// cap — so the `expires_at` index above does not find it.
  @@index([absoluteExpiresAt])
  @@map("sessions")
}

/// Single-use, time-limited password reset (TAR-53). A table rather than a
/// signed stateless token: single-use is *state*, and expiry alone does not
/// give it. A stateless token needs a consumed-list to be single-use, which is
/// this table with extra steps.
///
/// Redemption is one conditional statement —
/// `UPDATE … WHERE consumed_at IS NULL RETURNING` — so the update itself is the
/// concurrency control and two simultaneous uses of one link cannot both win.
/// A read-then-write would let both through.
model PasswordResetToken {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  /// SHA-256 hex of the token. The token itself is never stored, so a database
  /// leak yields no usable link. SHA-256 rather than argon2id is correct here
  /// specifically: the input is 256 bits of uniform entropy, not a
  /// human-chosen password, so there is no dictionary for a KDF to slow down.
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(3)
  /// Forensics only — never a filter, never shown to a user.
  requestedIp String?   @map("requested_ip") @db.Inet
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  /// "Invalidate this user's outstanding tokens", which every new request and
  /// every completed reset does.
  @@index([tenantId, userId])
  /// The cross-tenant expiry sweep under `SystemPrisma`.
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Invite {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  email           String    @db.Citext
  role            UserRole  @default(agent)
  tokenHash       String    @unique @map("token_hash")
  invitedByUserId String?   @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz(3)
  /// An admin cancelling a pending invite. `accepted_at` cannot express it:
  /// "never accepted" and "withdrawn" are different states, and only one of
  /// them should stop the link working.
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User?        @relation(fields: [tenantId, invitedByUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  teams     InviteTeam[]

  /// Referenced by `invite_teams` (conventions, rule 2).
  @@unique([tenantId, id])
  @@index([tenantId, email])
  @@index([tenantId, invitedByUserId])
  /// A second index is missing from this block on purpose:
  /// `invites_one_live_per_email` is a **partial unique** index over
  /// `(tenant_id, email) WHERE accepted_at IS NULL AND revoked_at IS NULL`, so
  /// two live invites for one address — which means two accounts — are
  /// impossible rather than merely unlikely. Prisma cannot express an index
  /// predicate; it lives in raw SQL in
  /// `20260811150000_auth_schema_and_policies`, which also explains why the
  /// predicate cannot carry an expiry term and what TAR-55 must do about it.
  @@map("invites")
}

/// The teams an invited agent joins on acceptance.
/// `InviteCreateInputSchema` has carried `teamIds` since TAR-53 and nothing in
/// the schema held them.
///
/// A `uuid[]` column on `invites` would be one fewer table and cannot express a
/// foreign key, so a team deleted between invite and acceptance would leave a
/// dangling id that surfaces as a 500 in the middle of onboarding. Here the
/// database removes the row with the team.
model InviteTeam {
  tenantId String @map("tenant_id") @db.Uuid
  inviteId String @map("invite_id") @db.Uuid
  teamId   String @map("team_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invite Invite @relation(fields: [tenantId, inviteId], references: [tenantId, id], onDelete: Cascade)
  team   Team   @relation(fields: [tenantId, teamId], references: [tenantId, id], onDelete: Cascade)

  /// The natural key is the whole row, so it is the primary key — no surrogate
  /// `id` that nothing would ever reference (TAR-53's data model).
  @@id([tenantId, inviteId, teamId])
  /// "Which pending invites reference this team", the read a team deletion
  /// needs. The primary key leads with `invite_id` and cannot serve it.
  @@index([tenantId, teamId])
  @@map("invite_teams")
}

/// The routing unit of TAR-22: a conversation assigned to a team is visible to
/// every member of that team, whatever their own assignment.
model Team {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// `citext`, on the same reasoning as `tenants.slug` and every email column
  /// (conventions, rule 6): this is a *unique* key within the tenant that a
  /// human types, so `Billing` and `billing` colliding on the unique index is
  /// the correct answer. Without it an admin creating "billing" next to an
  /// existing "Billing" gets two teams that look identical in every picker, and
  /// conversations routed to one are invisible to the members of the other.
  name        String   @db.Citext
  /// `TeamResponse.description` in TAR-39's users contract, which had nowhere to
  /// land. `TeamCreateInput` caps it at 500 characters; that bound is the
  /// contract's to enforce, not a column type's.
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members               TeamMember[]
  pendingInvites        InviteTeam[]
  assignedConversations Conversation[]
  assignedTickets       Ticket[]
  assignmentRules       AssignmentRule[]
  assignmentState       AssignmentState?
  /// Workflows naming this team, as a `reassign` target or inside a condition
  /// (TAR-27). No team-delete path exists today; when TAR-22 adds one, this is
  /// the foreign key that makes it refuse rather than break a workflow.
  workflowReferences    WorkflowReference[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(uuid(7)) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  teamId   String   @map("team_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [tenantId, teamId], references: [tenantId, id], onDelete: Cascade)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, teamId, userId])
  /// "Which teams is this user in" — resolved on every session bootstrap to fill
  /// `SessionPrincipal.teamIds`, and again wherever a role-scoped list needs the
  /// user's team set. `team_id` is trailing rather than absent so the answer
  /// comes out of the index without touching the heap; it replaces the narrower
  /// `(tenant_id, user_id)` index, which was a prefix of this one and therefore
  /// served nothing extra.
  @@index([tenantId, userId, teamId])
  @@map("team_members")
}

// ---------------------------------------------------------------------------
// WhatsApp channel — TAR-20
// ---------------------------------------------------------------------------

/// Meta scopes its WhatsApp objects at three levels, not two, and TAR-52 gives
/// the middle one a table of its own:
///
///   Tenant ──< WhatsappBusinessAccount ──< WhatsappAccount   (phone numbers)
///                                     └──< MessageTemplate
///
/// A tenant may hold several WABAs (TAR-39, question 6, answered by Tarek), each
/// with one or more numbers. The two things that follow from Meta's own scoping,
/// and that this table exists to express:
///
///   * **The access token is issued to the business, not to the number.** One
///     copy per WABA, so a rotation is a single-row update that cannot leave two
///     numbers holding different secrets.
///   * **Template approval is per WABA.** `message_templates` hangs off this
///     table, which is what lets one tenant hold `order_update`/`en` approved
///     separately under two WABAs.
///
/// Quality rating and messaging limits stay on the phone number, where Meta puts
/// them — see `WhatsappAccount`.
model WhatsappBusinessAccount {
  id                   String                             @id @default(uuid(7)) @db.Uuid
  tenantId             String                             @map("tenant_id") @db.Uuid
  /// Meta's own id for the business account. Unique **globally**, on the same
  /// reasoning as `phone_number_id`: one Meta app serves every tenant, so a
  /// WABA id arriving on a webhook has to resolve to exactly one row.
  wabaId               String                             @unique @map("waba_id")
  /// The business name Meta reports. Display only — two WABAs under one tenant
  /// are otherwise indistinguishable in an operator's list.
  name                 String?
  /// The per-business credential, encrypted at rest and decrypted only in the
  /// send path (TAR-39, security). Never selected into an API response.
  accessTokenEncrypted String?                            @map("access_token_encrypted")
  verificationStatus   WhatsappBusinessVerificationStatus @default(not_verified) @map("verification_status")
  createdAt            DateTime                           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts  WhatsappAccount[]
  templates MessageTemplate[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("whatsapp_business_accounts")
}

/// One phone number, child of a WABA. One Meta app serves every tenant, so
/// `phone_number_id` is the webhook routing key and must be unique **globally**
/// (TAR-39, webhook ingestion) — that does not change with several WABAs behind
/// it, because the routing key names the number rather than the business.
model WhatsappAccount {
  id                        String                 @id @default(uuid(7)) @db.Uuid
  tenantId                  String                 @map("tenant_id") @db.Uuid
  whatsappBusinessAccountId String                 @map("whatsapp_business_account_id") @db.Uuid
  phoneNumberId             String                 @unique @map("phone_number_id")
  displayPhoneNumber        String                 @map("display_phone_number")
  verifiedName              String?                @map("verified_name")
  /// Meta's rating for this number. NULL until we have read it; `unknown` when
  /// Meta says so. Not on the WABA — Meta rates and throttles per number.
  qualityRating             WhatsappQualityRating? @map("quality_rating")
  status                    WhatsappAccountStatus  @default(disconnected)
  createdAt                 DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  whatsappBusinessAccount WhatsappBusinessAccount @relation(fields: [tenantId, whatsappBusinessAccountId], references: [tenantId, id], onDelete: Cascade)
  conversations           Conversation[]

  @@unique([tenantId, id])
  @@index([tenantId, whatsappBusinessAccountId])
  @@map("whatsapp_accounts")
}

/// A template belongs to the WABA that submitted it for approval, not to the
/// tenant and not to the number: `UNIQUE (tenant_id, whatsapp_business_account_id,
/// name, language)`. Keyed on the tenant as well as the WABA even though the
/// WABA already implies one, because every unique index here has to lead with
/// `tenant_id` for RLS to use it (TAR-39, decision 1, rule 3).
model MessageTemplate {
  id                        String                @id @default(uuid(7)) @db.Uuid
  tenantId                  String                @map("tenant_id") @db.Uuid
  whatsappBusinessAccountId String                @map("whatsapp_business_account_id") @db.Uuid
  name                      String
  language                  String
  category                  String?
  status                    MessageTemplateStatus @default(pending)
  /// Meta's component tree, stored verbatim — its shape is Meta's to change.
  components                Json?
  providerTemplateId        String?               @map("provider_template_id")
  createdAt                 DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  whatsappBusinessAccount WhatsappBusinessAccount @relation(fields: [tenantId, whatsappBusinessAccountId], references: [tenantId, id], onDelete: Cascade)

  /// No separate `(tenant_id, whatsapp_business_account_id)` index: this unique
  /// index leads with exactly those two columns, so "every template in this
  /// WABA" already has one. A second index on the same prefix would cost write
  /// throughput and serve no read.
  @@unique([tenantId, whatsappBusinessAccountId, name, language])
  /// Serves `GET /api/v1/message-templates` (TAR-20a, shape ruled in 0002
  /// amendment 1): approved templates for the tenant in scope, ordered by name,
  /// keyset-paginated. The unique index above cannot serve it — it leads with
  /// the WABA, while this list may span a tenant's WABAs — so without this the
  /// composer's template picker is a sequential scan of every tenant's
  /// templates. `status` sits second because the endpoint filters on exactly one
  /// value; `tenant_id` leads it because RLS supplies that equality on every
  /// query (TAR-39, decision 1, rule 3); `name, language, id` are the three sort
  /// keys, and a name-leading order is also what makes the `q` prefix a range.
  @@index([tenantId, status, name, language, id])
  /// Serves `GET /api/v1/whatsapp/message-templates` (TAR-91, ruled in 0002
  /// amendment 8): every template the tenant holds, in amendment 1's ordering,
  /// with no status constraint. The index above cannot serve it — `status` sits
  /// second there, and with a leading column left free the index no longer
  /// yields rows in `(name, language, id)` order, so the plan becomes a sort
  /// over every template the tenant holds. Both are kept: neither is a prefix of
  /// the other, the composer's is the hotter path and wants its `status`
  /// equality early, and this table is written only by the template sync.
  @@index([tenantId, name, language, id])
  @@map("message_templates")
}

// ---------------------------------------------------------------------------
// Contacts — TAR-33
// ---------------------------------------------------------------------------

model Contact {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  /// E.164, and the natural key for an inbound message: every inbound webhook
  /// resolves a contact through `(tenant_id, phone_e164)`.
  phoneE164    String    @map("phone_e164")
  displayName  String?   @map("display_name")
  email        String?   @db.Citext
  locale       String?
  /// Values for `custom_field_defs`, keyed by `custom_field_defs.key`. JSONB so
  /// a tenant adding a field is a row insert, not a migration.
  customFields Json?     @map("custom_fields")
  /// Set when the contact opts out. A non-null value blocks outbound sends.
  optedOutAt   DateTime? @map("opted_out_at") @db.Timestamptz(3)
  lastSeenAt   DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tags          ContactTag[]
  conversations Conversation[]
  tickets       Ticket[]

  @@unique([tenantId, phoneE164])
  @@unique([tenantId, id])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("contacts")
}

model Tag {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  color     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts           ContactTag[]
  /// TAR-27's second join table. The same taxonomy, a different subject: a
  /// contact tag is a property of a customer, a ticket tag is a fact about one
  /// incident.
  tickets            TicketTag[]
  /// Workflows naming this tag (TAR-27). The foreign key out of that table is
  /// what refuses a delete while one does — see `WorkflowReference`.
  workflowReferences WorkflowReference[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@map("tags")
}

model ContactTag {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tenantId, tagId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, contactId, tagId])
  /// "Every contact with this tag" — the filter that makes tags useful.
  @@index([tenantId, tagId])
  @@map("contact_tags")
}

model CustomFieldDef {
  id        String          @id @default(uuid(7)) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  /// The key used inside `contacts.custom_fields`.
  key       String
  label     String
  type      CustomFieldType @default(text)
  /// Allowed values for `select` / `multi_select`.
  options   Json?
  position  Int             @default(0)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("custom_field_defs")
}

// ---------------------------------------------------------------------------
// Inbox — TAR-20
// ---------------------------------------------------------------------------

model Conversation {
  id                     String             @id @default(uuid(7)) @db.Uuid
  tenantId               String             @map("tenant_id") @db.Uuid
  whatsappAccountId      String             @map("whatsapp_account_id") @db.Uuid
  contactId              String             @map("contact_id") @db.Uuid
  status                 ConversationStatus @default(open)
  assignedUserId         String?            @map("assigned_user_id") @db.Uuid
  assignedTeamId         String?            @map("assigned_team_id") @db.Uuid
  /// Meta's 24-hour customer service window. Past this, only an approved
  /// template may be sent — so it is a column, not a derived value.
  serviceWindowExpiresAt DateTime?          @map("service_window_expires_at") @db.Timestamptz(3)
  /// Denormalised from `messages` to keep the inbox list a single-table scan.
  /// Maintained in the same transaction as the message insert.
  ///
  /// NOT NULL, and that is load-bearing rather than tidiness (TAR-92): this is
  /// the leading *sort* column of all three inbox keyset indexes below.
  /// Postgres orders NULLs FIRST under DESC, so a message-less conversation
  /// would pin itself to page one, and the ruled resume predicate
  /// (`last_message_at <= $1 AND NOT (…)`) evaluates to NULL — not TRUE — for
  /// that cursor, silently dropping every row after it. A thread with no
  /// message yet sorts by when it was opened: the default is the row's own
  /// insert time, matching `created_at`.
  lastMessageAt          DateTime           @default(now()) @map("last_message_at") @db.Timestamptz(3)
  unreadCount            Int                @default(0) @map("unread_count")

  /// Who owns the reply (0010 decision 5, TAR-402). `botHandling` in the
  /// published contract is `botState === 'bot_active'` and keeps its meaning.
  ///
  /// Written by three places and no more: `BotTurnService` on the way in
  /// (compare-and-set against `bot_state <> 'human_active'`), `MessageSendService`
  /// and the assign/claim path on the way to `human_active`, and the conversation
  /// status path on the reset to `off`. It is a plain column rather than an
  /// `AiModule` API precisely so those three need no module edge.
  botState     ConversationBotState @default(off) @map("bot_state")
  /// When the bot took this conversation — the start of the window the handoff
  /// DTO's `botExchange` spans. Null when the bot never replied, and cleared on
  /// the reset to `off`.
  ///
  /// `conversations_bot_engaged_at_requires_engagement` holds the one direction
  /// that matters (`off` implies null). It is a CHECK, so it lives in the
  /// migration rather than here.
  botEngagedAt DateTime?            @map("bot_engaged_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  whatsappAccount WhatsappAccount @relation(fields: [tenantId, whatsappAccountId], references: [tenantId, id], onDelete: Cascade)
  contact         Contact         @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Cascade)
  assignedUser    User?           @relation(fields: [tenantId, assignedUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  assignedTeam    Team?           @relation(fields: [tenantId, assignedTeamId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  messages        Message[]
  internalNotes   InternalNote[]
  tickets         Ticket[]
  botTurns        BotTurn[]
  handoffEvents   HandoffEvent[]

  /// One thread per contact per WhatsApp number.
  @@unique([tenantId, whatsappAccountId, contactId])
  @@unique([tenantId, id])
  /// The inbox list — the hottest query in the product (TAR-39, index table).
  @@index([tenantId, status, lastMessageAt(sort: Desc), id(sort: Desc)])
  /// An agent's default view — the `conversation:read` (no `_all`) inbox, which
  /// is the whole difference between an agent and a supervisor (TAR-22).
  ///
  /// The sort key is part of the index, not an afterthought. Without it the
  /// planner drops the scope predicate to a filter and walks the tenant-wide
  /// index above instead, so the work scales with the *tenant's* conversation
  /// count rather than with the principal's. Measured on 120 000 conversations
  /// where the principal holds 2 000 of them: 3 094 buffers and 39 333
  /// `Rows Removed by Filter` for one 25-row page, against 6 buffers and an
  /// Index Only Scan once the sort key is in the index.
  ///
  /// Explicitly named because Prisma's generated name for five columns exceeds
  /// Postgres's 63-character identifier limit and would be silently truncated.
  @@index([tenantId, assignedUserId, status, lastMessageAt(sort: Desc), id(sort: Desc)], map: "conversations_tenant_assigned_user_inbox_idx")
  @@index([tenantId, assignedTeamId, status, lastMessageAt(sort: Desc), id(sort: Desc)], map: "conversations_tenant_assigned_team_inbox_idx")
  @@index([tenantId, contactId])
  @@map("conversations")
}

model Message {
  id                String             @id @default(uuid(7)) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  conversationId    String             @map("conversation_id") @db.Uuid
  direction         MessageDirection
  status            MessageStatus
  contentType       MessageContentType @default(text) @map("content_type")
  body              String?
  /// Meta's id. Null until an outbound send is acknowledged, which is why the
  /// unique constraint tolerates it — Postgres does not collide NULLs. Once
  /// set, it is what makes a replayed webhook a no-op.
  providerMessageId String?            @map("provider_message_id")
  /// The agent who sent an outbound message. Null for inbound and for messages
  /// sent by automation.
  senderUserId      String?            @map("sender_user_id") @db.Uuid
  /// Who authored the message (0010 decision 14, TAR-402).
  ///
  /// **The default is a seed value, not the answer.** A column default cannot
  /// depend on the row, and the correct origin depends on `direction` and
  /// `senderUserId` — so `contact` is right for every inbound message and is
  /// completed for outbound ones by the `messages_derive_origin` trigger, which
  /// applies the same rule the backfill did. A writer that names `bot`, `agent`
  /// or `system` is left alone, so TAR-406 sets `bot` explicitly.
  ///
  /// `messages_origin_matches_direction` — a CHECK, so it lives in the migration
  /// — makes the invariant exact: a message is `contact`-authored if and only if
  /// it is inbound. That is also what makes the trigger sound, because `contact`
  /// on an outbound row can only mean "the writer did not say".
  origin            MessageOrigin      @default(contact)
  /// The provider's timestamp, never insert order: Meta does not guarantee
  /// delivery order and ingest is concurrent (TAR-39, ordering).
  sentAt            DateTime           @map("sent_at") @db.Timestamptz(3)
  deliveredAt       DateTime?          @map("delivered_at") @db.Timestamptz(3)
  readAt            DateTime?          @map("read_at") @db.Timestamptz(3)
  failedAt          DateTime?          @map("failed_at") @db.Timestamptz(3)
  errorCode         String?            @map("error_code")
  errorMessage      String?            @map("error_message")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation      Conversation        @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)
  sender            User?               @relation(fields: [tenantId, senderUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  attachments       MessageAttachment[]
  botTurnsHandled   BotTurn[]           @relation("BotTurnInboundMessage")
  botTurnsReplied   BotTurn[]           @relation("BotTurnReplyMessage")
  handoffsTriggered HandoffEvent[]

  @@unique([tenantId, providerMessageId])
  @@unique([tenantId, id])
  /// Thread view and keyset pagination (TAR-39, index table).
  @@index([tenantId, conversationId, sentAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, senderUserId])
  @@map("messages")
}

/// One stored binary (TAR-20e).
///
/// ## Why this is not `message_attachments`
///
/// `POST /api/v1/media` returns a `mediaId` **before** any message exists — the
/// composer attaches a file, then sends. An attachment row cannot represent
/// that: `message_id` is what makes it an attachment. So the binary is its own
/// entity, and an attachment is the join between a message and one.
///
/// It also makes the two lifetimes separable, which they genuinely are. An
/// upload that is never sent is a stray media object with no attachment, and
/// sweeping those is a retention job that never has to reason about messages.
///
/// ## What is not here
///
/// No Meta media id for the *outbound* direction. Meta's upload handle is
/// scoped to the phone number it was uploaded to and expires on Meta's own
/// schedule, so caching one would be a per-number, time-limited cache whose
/// staleness surfaces as a failed send. The bytes are uploaded per send
/// instead; see `MediaSendResolver`.
model MediaObject {
  id               String      @id @default(uuid(7)) @db.Uuid
  tenantId         String      @map("tenant_id") @db.Uuid
  kind             MediaKind
  source           MediaSource
  /// Where the bytes are in the object store, namespaced by tenant. Unique per
  /// tenant so two rows can never point at one blob and a delete of either
  /// orphan the other.
  storageKey       String      @map("storage_key")
  mimeType         String      @map("mime_type")
  sizeBytes        Int         @map("size_bytes")
  /// SHA-256 of the stored bytes, lower-case hex. Written on the way in, so a
  /// corrupted or truncated object can be proven rather than suspected — and so
  /// an inbound download can be checked against the digest Meta publishes.
  checksumSha256   String      @map("checksum_sha256")
  /// What the recipient sees, and what a download is named. Documents only in
  /// practice; null when the source supplied none.
  fileName         String?     @map("file_name")
  /// Meta's handle for an inbound object. Retrieval only — it is not a handle
  /// this platform may send with, and it stops resolving after Meta expires it.
  providerMediaId  String?     @map("provider_media_id")
  /// The agent who uploaded it. Null for inbound and for automation.
  uploadedByUserId String?     @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy  User?               @relation(fields: [tenantId, uploadedByUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  attachments MessageAttachment[]

  @@unique([tenantId, id])
  @@unique([tenantId, storageKey])
  /// The retention sweep over uploads nothing ever attached, and the only
  /// listing this table has.
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, uploadedByUserId])
  @@map("media_objects")
}

model MessageAttachment {
  id              String             @id @default(uuid(7)) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  messageId       String             @map("message_id") @db.Uuid
  /// The stored binary, once there is one. Null while an inbound download is
  /// `pending`, and permanently null when it `failed` — the row still records
  /// that the customer sent a file, which is the honest thing for the thread to
  /// show.
  mediaObjectId   String?            @map("media_object_id") @db.Uuid
  /// Re-hosted by us: Meta's media URLs expire.
  ///
  /// Stored as a path (`/api/v1/media/{id}/content`), not an absolute URL. The
  /// same row is served through a tenant's platform subdomain and through its
  /// custom domain (TAR-29), so the origin is the request's to supply and the
  /// response mapper is where the two are joined. An absolute URL here would
  /// name whichever host was configured the day the row was written.
  url             String?
  kind            MediaKind
  downloadState   MediaDownloadState @default(stored) @map("download_state")
  /// Why a download ended `failed`, for the operator. Never rendered to a
  /// customer, and never carries a URL or a token.
  downloadError   String?            @map("download_error")
  mimeType        String             @map("mime_type")
  /// Known once the bytes are stored. Meta's inbound payload does not carry it.
  sizeBytes       Int?               @map("size_bytes")
  filename        String?
  providerMediaId String?            @map("provider_media_id")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  message     Message      @relation(fields: [tenantId, messageId], references: [tenantId, id], onDelete: Cascade)
  mediaObject MediaObject? @relation(fields: [tenantId, mediaObjectId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  /// One attachment per message per Meta handle. Meta sends exactly one media
  /// object per inbound message, so this is what makes a replayed webhook a
  /// no-op instead of a second attachment on the same message.
  @@unique([tenantId, messageId, providerMediaId])
  @@index([tenantId, messageId])
  /// The retry sweep: inbound downloads that never completed.
  @@index([tenantId, downloadState, createdAt])
  @@map("message_attachments")
}

/// Agent-only notes on a conversation. Never sent to the contact.
model InternalNote {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  conversationId   String   @map("conversation_id") @db.Uuid
  authorUserId     String?  @map("author_user_id") @db.Uuid
  body             String
  /// Who to notify. A plain `uuid[]` rather than a join table: it is written
  /// once, read with the note, and never queried the other way round.
  mentionedUserIds String[] @map("mentioned_user_ids") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)
  author       User?        @relation(fields: [tenantId, authorUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, authorUserId])
  @@map("internal_notes")
}

// ---------------------------------------------------------------------------
// Tickets — TAR-21 / TAR-25 / TAR-32
// ---------------------------------------------------------------------------

model Ticket {
  id             String         @id @default(uuid(7)) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  /// Per-tenant, human-facing ticket number. Unique within the tenant only —
  /// two tenants both having ticket #1 is correct. Allocated by
  /// `TicketCounter` below (TAR-73, decision 3); the unique constraint is what
  /// makes a racy allocator fail loudly instead of duplicating.
  number         Int
  subject        String?
  status         TicketStatus   @default(open)
  priority       TicketPriority @default(normal)
  conversationId String?        @map("conversation_id") @db.Uuid
  contactId      String?        @map("contact_id") @db.Uuid
  assignedUserId String?        @map("assigned_user_id") @db.Uuid
  assignedTeamId String?        @map("assigned_team_id") @db.Uuid

  /// Whether routing may still act on this ticket, and if not, why (TAR-272,
  /// 0008 decision 3). A column rather than only the `assignment_deferred`
  /// event, because an event records *that it happened* and the supervisor's
  /// view has to filter on *what is still true* — deriving it would be a
  /// correlated subquery over an append-only log on every page load.
  routingState          TicketRoutingState           @default(pending) @map("routing_state")
  /// Non-null exactly when `routingState = 'deferred'`, enforced by
  /// `tickets_routing_deferred_consistent`. What TAR-274 renders as the reason a
  /// ticket is stuck.
  routingDeferredReason TicketRoutingDeferredReason? @map("routing_deferred_reason")
  /// When the flag was raised, and what the supervisor list sorts by. Not
  /// derivable from `created_at`: a ticket that was assigned, released and then
  /// deferred would report an age that is a lie. Set on the first transition
  /// into `deferred` only, so a redelivered routing job does not reset it.
  routingDeferredSince  DateTime?                    @map("routing_deferred_since") @db.Timestamptz(3)

  /// Named for the contract's `firstRespondedAt`, not for the column (0003,
  /// open question 4). The column keeps `first_response_at`, so this is a
  /// client-side rename with no migration behind it: the published field is the
  /// fixed artifact the console types against, and the mapper stops needing a
  /// translation line. TAR-26 filled it in: `SlaTimerService.stampFirstResponse`
  /// writes it on the first human reply and the mapper publishes it, so it is a
  /// real value rather than the placeholder it started as. TAR-30's
  /// response-time metric reads it directly.
  firstRespondedAt DateTime? @map("first_response_at") @db.Timestamptz(3)
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz(3)
  closedAt         DateTime? @map("closed_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// **Who** answered and **who** resolved, recorded when it happens (TAR-30,
  /// 0010 decision 4). The per-agent breakdown needs both and neither was
  /// recorded anywhere: `sla-timer.service.ts` writes the `first_response`
  /// event with no actor on purpose — "the timer observed the reply, it did not
  /// make it".
  ///
  /// Denormalised deliberately, and the two rejected alternatives are the
  /// reason. Deriving the responder from `messages` at query time is a second
  /// implementation of `stampFirstResponse`'s five-clause definition of "who
  /// answered", correct until somebody changes one of them; attributing to
  /// `assigned_user_id` rewrites history, because a ticket reassigned in March
  /// moves its January response time onto a different agent's row after that
  /// period was reported to a client.
  ///
  /// **Null means "not recorded"**, which the report renders as its
  /// `unattributed` row rather than redistributing. The backfill is best-effort
  /// (0010 decision 4) and inherits 0006 risk 3 — a reply sent on a second
  /// conversation for a multi-number tenant is invisible to both the stamp and
  /// the backfill.
  ///
  /// Neither column is ever written by a read path, and nothing but the two
  /// single writers below writes them at all:
  /// `SlaTimerService.stampFirstResponse` and `TicketCommandService`, each in
  /// the transaction that already establishes the fact.
  firstResponseUserId String? @map("first_response_user_id") @db.Uuid
  resolvedByUserId    String? @map("resolved_by_user_id") @db.Uuid

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation   Conversation?  @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  contact        Contact?       @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  /// Three relations from this model to `User` now, so all three carry a name:
  /// Prisma cannot disambiguate more than one unnamed relation between the same
  /// pair of models, and naming only the new ones is a schema error rather than
  /// a style choice. The relation name is a client-side concept — it changes no
  /// column and no foreign-key constraint name.
  assignedUser   User?          @relation("TicketAssignee", fields: [tenantId, assignedUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  firstResponder User?          @relation("TicketFirstResponder", fields: [tenantId, firstResponseUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  resolver       User?          @relation("TicketResolver", fields: [tenantId, resolvedByUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  assignedTeam   Team?          @relation(fields: [tenantId, assignedTeamId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  events         TicketEvent[]
  slaTimers      SlaTimer[]
  notifications  Notification[]
  handoffEvents  HandoffEvent[]
  /// Automation-written ticket tags (TAR-27). `TicketResponse.tags` is mapped
  /// from here, and the existing ticket queries take one batched join.
  tags           TicketTag[]
  workflowRuns   WorkflowRun[]

  @@unique([tenantId, number])
  @@unique([tenantId, id])
  /// Ticket queues and supervisor dashboards (TAR-39, index table).
  @@index([tenantId, status, priority, createdAt(sort: Desc)])
  /// The three range anchors `tickets_reporting_metrics_idx` cannot serve
  /// (TAR-428, completing ADR 0010's data model).
  ///
  /// 0010 decision 2 anchors each metric on the timestamp that makes it true —
  /// response time on `first_response_at`, resolution on `resolved_at`,
  /// closed-unworked on `closed_at` — so each of those is a range on its own
  /// column, and a range needs its column as a **start condition**.
  /// `tickets_reporting_metrics_idx` below leads with `(tenant_id, created_at)`
  /// and puts `first_response_at` fifth and `resolved_at` sixth, unreachable
  /// without an equality on everything before them; a report deliberately spans
  /// every status and every assignee. `closed_at` is not in it at all. That is
  /// TAR-427's own argument against `(tenant_id, status, priority, created_at
  /// DESC)`, applied to the other three anchors.
  ///
  /// **No `(tenant_id, created_at)` here on purpose**: TAR-427's index leads
  /// with exactly that pair and covers the aggregated columns too, so the
  /// created-at anchor and the daily series are already served.
  ///
  /// Not partial, though `first_response_at IS NOT NULL` would halve two of
  /// them: Prisma cannot express an index predicate, and an index created
  /// outside this file is something `migrate dev` proposes to drop. The same
  /// trade `sla_timers` documents, with the same escalation — make them partial
  /// out of band, with a spec asserting their definition, once size makes the
  /// drift caveat worth paying.
  ///
  /// Three more btrees on the most-written table, on top of TAR-427's. If that
  /// has to be cut, ADR 0010 risk 4 names the lever: `(tenant_id, closed_at)`
  /// serves the supplementary `closedWithoutResolution` count alone, and
  /// dropping that index and that response field together is a coherent
  /// reduction. The other two are load-bearing for TAR-30's stated metrics.
  @@index([tenantId, firstRespondedAt])
  @@index([tenantId, resolvedAt])
  @@index([tenantId, closedAt])
  /// The `ticket:read` (no `_all`) queue, the ticket half of the same agent
  /// scope as `conversations` above, carrying its own sort key for the same
  /// reason. Measured: the narrower index still applied the scope, but every
  /// page paid a top-N sort over the principal's whole matching set — 43 buffers
  /// against 6 for one page at 500 matching tickets, and that gap grows with the
  /// principal's backlog rather than staying flat.
  @@index([tenantId, assignedUserId, status, createdAt(sort: Desc), id(sort: Desc)], map: "tickets_tenant_assigned_user_queue_idx")
  @@index([tenantId, assignedTeamId, status, createdAt(sort: Desc), id(sort: Desc)], map: "tickets_tenant_assigned_team_queue_idx")
  @@index([tenantId, conversationId])
  @@index([tenantId, contactId])
  /// The reporting dashboard and its export (TAR-427, serving TAR-30), and the
  /// one covering index in this file. Four metrics — volume, response time,
  /// resolution time, per-agent breakdown — over a supervisor-chosen date
  /// range, answered by a single index-only scan of that range.
  ///
  /// No existing index can: the closest,
  /// `(tenant_id, status, priority, created_at DESC)`, puts `status` *between*
  /// the tenant and the timestamp, and a report deliberately spans every
  /// status — so `created_at` is not reachable as a range boundary through it,
  /// and Postgres 16 has no btree skip scan. Measured on 500 000 tickets: a
  /// Parallel Seq Scan of the whole table, 9 608 buffers, **whatever date range
  /// was asked for**, against 214 buffers and `Heap Fetches: 0` with this index.
  ///
  /// `createdAt` is ASC where every other timestamp here is DESC. Those are
  /// queues, read newest-first; a report is read chronologically and the export
  /// streams `ORDER BY created_at, id`, so ascending is a forward scan.
  ///
  /// The last four columns are the aggregated ones, carried so the scan never
  /// visits the heap. They are plain key columns rather than an `INCLUDE`
  /// payload only because Prisma cannot express `INCLUDE` — both forms were
  /// built and measured at identical size, identical plans and identical
  /// buffers, so the tie went to the form this file can declare. That makes
  /// this the one bespoke index on `tickets` that `migrate dev` will regenerate
  /// and whose absence *is* drift.
  @@index([tenantId, createdAt, assignedUserId, status, firstRespondedAt, resolvedAt], map: "tickets_reporting_metrics_idx")
  @@map("tickets")
}

// ⚠️ `tickets` carries three objects this file cannot express. Two arrived with
// TAR-272 and live in the
// 20260813140000_assignment_workload_and_routing_state migration:
//
//   * `tickets_routing_deferred_idx` — partial, on
//     `(tenant_id, routing_deferred_since) WHERE routing_state = 'deferred'`.
//     The supervisor's landing query (0008 decision 3).
//   * `tickets_routing_deferred_consistent` — a CHECK making
//     `routing_state = 'deferred'` equivalent to both deferred columns being
//     non-null. Prisma's schema language has no CHECK at all.
//
// `src/prisma/assignment-workload-schema.int-spec.ts` asserts both by
// definition, for the same reason the third one below has its own spec.
//
// The third, and the original: the partial unique
// index `tickets_one_active_per_contact`, on `(tenant_id, contact_id)`
// `WHERE status IN ('open','pending')`. It is the DB-level guarantee behind
// TAR-21's "one active ticket per contact" (TAR-73, decision 2) and it lives in
// the 20260811130000_ticket_active_constraint_and_counters migration.
//
// Prisma's schema language has no partial-index syntax, and its Postgres
// describer skips indexes carrying a predicate — so `migrate dev` neither
// proposes to create it nor proposes to drop it, and it is not drift. The
// consequence to know about: **nothing in this file will ever regenerate it.**
// A `migrate reset` replays the migration and is fine; a database built any
// other way from this schema alone silently loses the invariant.
// `ticket-active-uniqueness.int-spec.ts` is what catches that.
//
// `contact_id` stays nullable and that is load-bearing: Postgres does not
// collide NULLs in a unique index, so TAR-25's manual ticket with no contact
// never conflicts. Making the column `NOT NULL` to tidy it would break that.
//
// ⚠️ And a second one this file cannot express: `tickets_active_queue_idx`, on
// `(tenant_id, priority DESC, created_at DESC, id DESC)`
// `WHERE status IN ('open','pending')`, in the
// 20260813150000_ticket_active_queue_index migration. It serves `GET /tickets`
// — active-only, `ORDER BY priority DESC, created_at DESC, id DESC` (0006, §6).
//
// The `(tenant_id, status, priority, created_at DESC)` index declared above
// cannot: a btree yields `priority DESC` only on a backward scan, which flips
// `created_at` to ASC; `status IN ('open','pending')` is two ranges on a column
// sitting *before* `priority`, so no single scan delivers a priority-ordered
// stream across both; and it carries no `id`, so the keyset has no total order
// to resume on. It stays because supervisor dashboards filter by an explicit
// status, which is the shape it does serve.
//
// Same caveat as the index above: Prisma's describer skips predicated indexes,
// so **nothing in this file will ever regenerate it** and its absence is not
// drift. `ticket-queue-shape.int-spec.ts` is what catches that.
//
// ⚠️ And a third, added by TAR-394: `tickets_active_created_at_idx`, on
// `(tenant_id, created_at)` `WHERE status IN ('open','pending')`, in the
// 20260816140000_workflow_rule_schema migration. It serves phase 1 of the
// workflow elapsed-trigger sweep — per tenant, `status IN ('open','pending') AND
// created_at <= now() - interval`, `ORDER BY created_at LIMIT 50` (0009,
// decision 3). `tickets_active_queue_idx` leads with `priority`, and
// `(tenant_id, status, priority, created_at DESC)` puts two status ranges and a
// whole column between the tenant and the range the sweep bounds on, so the
// planner sorts the tenant's active set instead of stopping at the fiftieth row.
//
// **`tickets_reporting_metrics_idx` (TAR-427) shares its exact leading prefix**,
// `(tenant_id, created_at)`, and is therefore the redundancy question this index
// has to answer. It is not redundant: that index is not partial, so the sweep
// would walk every ticket in the range — resolved and closed included, with
// `status` applied as an in-index filter — before it reaches fifty active ones,
// and its cost grows with the tenant's *history* rather than with its open
// backlog. This one holds only active tickets, so the first fifty entries in
// `created_at` order are the answer, and a resolved ticket leaves the index
// instead of sitting in it. The reporting index would still serve the query if
// this one were dropped, which makes the failure a slow sweep rather than a
// broken one. `workflow-schema.int-spec.ts` asserts its definition, and the same
// describer caveat applies.

/// Append-only audit trail for a single ticket (TAR-32). `type` is text, not an
/// enum: every later story adds event types, and an enum would make each of
/// them a migration.
model TicketEvent {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  ticketId    String   @map("ticket_id") @db.Uuid
  type        String
  /// Null when the actor is the system — an automation rule or an SLA timer.
  actorUserId String?  @map("actor_user_id") @db.Uuid
  /// Type-specific payload: `{ from, to }` for a status change, and so on.
  data        Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  actor  User?  @relation(fields: [tenantId, actorUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  /// The `escalation` notifications raised by this event (TAR-468). N supervisors
  /// told about one escalation act, which is what lets the console render one
  /// escalation rather than three.
  notifications Notification[]

  /// Carried for the same reason `Ticket` and `SlaTimer` carry it and for no
  /// other: it is the target a *composite* foreign key needs.
  /// `notifications.(tenant_id, ticket_event_id)` references it, and without this
  /// constraint PostgreSQL has nothing to point that key at — an `id`-only key
  /// would let one tenant's notification name another tenant's event.
  ///
  /// `id` is already unique on its own, so this adds no new guarantee about
  /// events; it adds a reference target.
  @@unique([tenantId, id])
  @@index([tenantId, ticketId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, actorUserId])
  @@map("ticket_events")
}

/// Per-tenant ticket-number allocator (TAR-73, decision 3). `tickets.number` is
/// `NOT NULL` with `UNIQUE (tenant_id, number)` and no default, so without this
/// there is no way to insert a ticket at all.
///
/// One row per tenant, created lazily by the first ticket rather than at
/// provisioning, so TAR-50's flow needs no change. Holds the *next* number to
/// hand out. Numbers are unique and monotonic but **not gapless** — the
/// allocating CTE still increments when the outer insert loses the race to
/// `tickets_one_active_per_contact`, and nothing depends on density.
model TicketCounter {
  tenantId   String   @id @map("tenant_id") @db.Uuid
  nextNumber Int      @default(1) @map("next_number")
  /// The one deviation from the usual timestamp shape: a database-level `now()`
  /// default alongside `@updatedAt`. Every other table here is written through
  /// the Prisma client, which supplies the value; this one is written by the raw
  /// upsert in TAR-73 decision 2, whose column list is `(tenant_id,
  /// next_number)`. Without the default that statement violates `NOT NULL` and
  /// no ticket can be created. `@updatedAt` still wins whenever the client
  /// writes the row.
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("ticket_counters")
}

// ---------------------------------------------------------------------------
// Assignment — TAR-23 / TAR-24
// ---------------------------------------------------------------------------

model AssignmentRule {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// `citext`, on the same reasoning as `teams.name` (conventions, rule 6),
  /// applied to a second name column: decision 6 of 0007 puts the rule *name*
  /// into the `ticket_events` row that records why a ticket was routed, and
  /// `Billing` next to `billing` is indistinguishable to whoever reads that log.
  name         String   @db.Citext
  /// Rules are evaluated in ascending `position`; the first match wins. Ties
  /// break on `id`, and that tie-break is load-bearing rather than cosmetic
  /// (0007, decision 2): `position` defaults to `0` and carries no unique
  /// constraint, so without it two rules created normally have no defined
  /// order. Ids are UUIDv7, so a tie resolves in creation order.
  position     Int      @default(0)
  isActive     Boolean  @default(true) @map("is_active")
  /// TAR-24 owns the condition grammar — `RoutingConditionSchema` in
  /// `@whatsappcrm/contracts` (0007, decision 3). JSONB keeps that grammar out
  /// of the schema so evolving it is not a migration.
  ///
  /// The `action` column TAR-47 shipped beside this one was dropped by TAR-285:
  /// the target is the two foreign-key columns below, and two representations
  /// of one fact is a drift surface with no owner (0007, data model delta 3).
  /// A non-assignment action belongs to TAR-27's automation engine.
  conditions   Json
  /// Exactly one of the two is set on an **active** rule, enforced by the CHECK
  /// constraint noted at the bottom of this model. Both null is a legitimate
  /// state only while `is_active` is false — see that note.
  targetUserId String?  @map("target_user_id") @db.Uuid
  targetTeamId String?  @map("target_team_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  targetUser User?  @relation(fields: [tenantId, targetUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  targetTeam Team?  @relation(fields: [tenantId, targetTeamId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, name])
  /// `id` is part of the sort (decision 2 above), so it is part of the index
  /// that serves it — the engine's one read per created ticket is
  /// `WHERE tenant_id = … AND is_active ORDER BY position, id`.
  @@index([tenantId, isActive, position, id])
  @@index([tenantId, targetUserId])
  @@index([tenantId, targetTeamId])
  /// ⚠️ One constraint on this table is **not** in this file:
  /// `assignment_rules_active_has_one_target`, a CHECK that reads
  /// `NOT is_active OR num_nonnulls(target_user_id, target_team_id) = 1`.
  /// Prisma's schema language cannot express a CHECK and its describer does not
  /// report one, so `migrate dev` proposes neither to create nor to drop it and
  /// this is not drift — but nothing regenerates it from this file either. It
  /// lives in `20260813140000_routing_rule_schema` and
  /// `src/prisma/assignment-rule-schema.int-spec.ts` fails if it goes missing,
  /// the same arrangement as `tickets_one_active_per_contact` (TAR-74).
  ///
  /// It is conditional on `is_active` deliberately. `users.service.ts` sets
  /// `{ targetUserId: null, isActive: false }` on every rule pointing at a
  /// removed user, so that a supervisor finds a rule needing a new target
  /// rather than finding it silently gone; an unconditional form would make
  /// that shipped statement fail at the constraint and break user removal.
  @@map("assignment_rules")
}

/// Round-robin cursor, one row per **routing scope** — a team, or the tenant
/// pool when `teamId` is null (TAR-272, 0008 decision 6). It was one row per
/// team until TAR-272; a tenant that has never created a team is the ordinary
/// starting state and has to rotate too.
model AssignmentState {
  id                 String   @id @default(uuid(7)) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  /// Null is the tenant pool, and is a real scope rather than a missing value.
  teamId             String?  @map("team_id") @db.Uuid
  /// Where the ring stopped. Compared with `>` and never dereferenced, so it
  /// naming a user who has since been removed is harmless by construction —
  /// recorded so nobody "fixes" it into a join.
  lastAssignedUserId String?  @map("last_assigned_user_id") @db.Uuid
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant           Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  team             Team?  @relation(fields: [tenantId, teamId], references: [tenantId, id], onDelete: Cascade)
  lastAssignedUser User?  @relation(fields: [tenantId, lastAssignedUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  /// ⚠️ The real index is `UNIQUE (tenant_id, team_id) **NULLS NOT DISTINCT**`,
  /// and Prisma cannot say that. It sees a unique index on the pair, matches
  /// this line against it and reports no drift — so this is not drift, but a
  /// `migrate dev` that ever recreates the index will recreate it NULL-distinct
  /// and silently allow a tenant several pool cursors, at which point rotation
  /// stops rotating rather than failing. It lives in
  /// 20260813140000_assignment_workload_and_routing_state and
  /// `src/prisma/assignment-workload-schema.int-spec.ts` asserts it.
  @@unique([tenantId, teamId], map: "assignment_state_tenant_scope_key")
  @@index([tenantId, lastAssignedUserId])
  @@map("assignment_state")
}

// ---------------------------------------------------------------------------
// SLA — TAR-26
// ---------------------------------------------------------------------------

model SlaPolicy {
  id                   String          @id @default(uuid(7)) @db.Uuid
  tenantId             String          @map("tenant_id") @db.Uuid
  name                 String
  /// Applies to tickets of this priority; null means "any".
  priority             TicketPriority?
  firstResponseMinutes Int?            @map("first_response_minutes")
  resolutionMinutes    Int?            @map("resolution_minutes")
  /// When true, elapsed time is counted against `tenant_settings.business_hours`
  /// rather than wall-clock.
  businessHoursOnly    Boolean         @default(false) @map("business_hours_only")
  isActive             Boolean         @default(true) @map("is_active")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timers SlaTimer[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId, isActive, priority])
  @@map("sla_policies")
}

model SlaTimer {
  id         String        @id @default(uuid(7)) @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  ticketId   String        @map("ticket_id") @db.Uuid
  policyId   String        @map("policy_id") @db.Uuid
  kind       SlaTargetKind
  state      SlaTimerState @default(running)
  startedAt  DateTime      @default(now()) @map("started_at") @db.Timestamptz(3)
  /// The single authoritative wall-clock deadline, and the only thing the sweep
  /// compares. A pause does not stop it; a resume moves it forward by however
  /// long the pause lasted (0006, pause and resume arithmetic). Keeping the
  /// deadline here rather than deriving it from an elapsed counter is what lets
  /// the sweep stay one comparison against one index.
  dueAt      DateTime      @map("due_at") @db.Timestamptz(3)
  stoppedAt  DateTime?     @map("stopped_at") @db.Timestamptz(3)
  /// When the current pause started. Null while running, and cleared on resume —
  /// it is the operand of the `due_at` arithmetic, not a history of pauses.
  pausedAt   DateTime?     @map("paused_at") @db.Timestamptz(3)
  /// Accumulated paused time across every pause. Never read by the sweep: it
  /// exists so that a `due_at` sitting three hours past `started_at + window`
  /// can be explained, and so TAR-30 can report working time rather than
  /// wall-clock. Milliseconds, to match what the timestamps here can represent.
  pausedMs   Int           @default(0) @map("paused_ms")
  /// When the sweep flipped this timer to `breached`. Separate from
  /// `stopped_at`, which is overloaded across `met` and `cancelled`: a supervisor
  /// asking "when did we miss it" and a report asking "when did the clock stop"
  /// are different questions, and `breached` is terminal even if a late reply
  /// arrives afterwards.
  breachedAt DateTime?     @map("breached_at") @db.Timestamptz(3)

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket Ticket         @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  policy SlaPolicy      @relation(fields: [tenantId, policyId], references: [tenantId, id], onDelete: Cascade)
  /// The `type = 'sla_breach'` rows in `notifications`. Named `alerts` because
  /// that is what they are from a timer's point of view.
  alerts Notification[]

  /// One timer per target per ticket. Also what serves the `breachedOnly` ticket
  /// filter's `EXISTS` (0006, `tickets` section).
  @@unique([tenantId, ticketId, kind])
  /// The composite key `notifications` references, per convention 2 — a plain
  /// `sla_timer_id uuid REFERENCES sla_timers(id)` would accept a timer id
  /// belonging to another tenant.
  @@unique([tenantId, id])
  /// The timer sweep. TAR-39 specifies a partial index
  /// `(tenant_id, due_at) WHERE state = 'running'`; Prisma cannot express a
  /// `WHERE` on an index, and an index created outside the schema shows up as
  /// drift that the next `migrate dev` proposes to drop. Leading with `state`
  /// gives the sweep the same access path — equality on `state`, then a range
  /// scan on `due_at` in index order — at the cost of also indexing finished
  /// timers. Revisit as a partial index once timer volume makes the size
  /// matter; the query does not have to change.
  @@index([tenantId, state, dueAt])
  /// Phase 1 of the breach sweep, and **the one composite index in this file
  /// that does not lead with `tenant_id`** (0006, decision 2). It is deliberate,
  /// not an oversight of convention 3 above.
  ///
  /// The sweep has to find due timers across every tenant, because no request
  /// context exists inside a queue worker: its predicate is
  /// `state = 'running' AND due_at <= now()` with no tenant term at all, so the
  /// index above leaves the planner a full scan. Everything the sweep then
  /// *does* with the rows it finds runs under RLS, one `$tenantTransaction` per
  /// tenant — this index serves a two-column read of `(tenant_id, id)` pairs and
  /// nothing else.
  ///
  /// It is not partial (`WHERE state = 'running'`) for the same reason the index
  /// above is not: Prisma cannot express an index predicate, and one created
  /// outside this file is drift the next `migrate dev` proposes to drop. Leading
  /// with `state` gives the same access path at the cost of also indexing
  /// finished timers. 0006 names making it partial as the second step once timer
  /// volume makes the size matter, ahead of sharding phase 1 by tenant.
  @@index([state, dueAt], map: "sla_timers_state_due_at_idx")
  @@index([tenantId, policyId])
  @@map("sla_timers")
}

/// One notification, per recipient, per thing worth telling them about (TAR-26,
/// 0006 decision 5; generalised by TAR-27, 0009 decision 7). Three things at
/// once, and each is load-bearing:
///
///   * **The delivery record.** It survives a restart, a missed socket and a
///     supervisor who was asleep. The `sla.breached` and `notification.created`
///     realtime events are accelerators; this row is what makes "the supervisor
///     is notified" true.
///   * **The read model** behind `GET /api/v1/sla-alerts` and
///     `GET /api/v1/notifications`, keyset-paginated by
///     `(created_at DESC, id DESC)` and narrowed to the calling principal.
///   * **The idempotency ledger.** `UNIQUE (tenant_id, sla_timer_id,
///     recipient_user_id)` is the second of the three layers that make one
///     breach produce exactly one alert; the load-bearing one is the conditional
///     `UPDATE ... WHERE state = 'running'` that flips the timer in the same
///     transaction (0006, decision 3). `UNIQUE (tenant_id, recipient_user_id,
///     dedupe_key)` is the same layer for the workflow types.
///
/// For `sla_breach`, recipients are derived, not configured: the tenant's active
/// supervisors and admins, narrowed to those sharing a team with whoever holds
/// the ticket, and falling back to all of them when that yields nobody. TAR-22's
/// model has no manager link, and 0006 decision 4 records why v1 does not add
/// one. A `notify` action names its own audience and reuses the same resolver.
///
/// This table shipped as
/// `sla_alerts` with TAR-270 and was renamed by
/// `20260816130000_notifications_generalisation` — which is what 0006 decision 5
/// said should happen when a second notification type arrived: "generalising it
/// is a rename and a `type` column". `GET /api/v1/sla-alerts` and its
/// acknowledge keep their paths, their response shape and their behaviour as a
/// documented `type = 'sla_breach'` view over these rows.
///
/// **`sla_timer_id`, `kind` and `due_at` are the `sla_breach` columns**, so they
/// are nullable now — and `notifications_sla_breach_columns` makes
/// "non-null exactly for that type" an invariant rather than a convention.
/// `ticket_id` stays `NOT NULL`: every type this story adds is raised while
/// evaluating one ticket, and `workflow_broken` is raised from the run that
/// failed, which has one.
///
/// **TAR-468 added the third type, `escalation`, and its `ticket_event_id`
/// column** rather than the parallel `escalation_alerts` table ADR 0011 decision
/// 5 specified. 0011 accepted two tables only as the price of not folding them
/// mid-story, and named the third notification type as the trigger to fold; by
/// the time escalation arrived, TAR-394 had already folded at the second. So the
/// fourth table would have been the deviation, and its stated cost — two unread
/// counts, two acknowledge endpoints, and a supervisor who has to look in two
/// places — is exactly what this table exists to prevent. The API contract is
/// unaffected: `GET /api/v1/escalation-alerts` is a `type = 'escalation'` view,
/// the same arrangement `sla-alerts` already keeps.
model Notification {
  id              String           @id @default(uuid(7)) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  /// Defaulted rather than required, which is what makes the rename a
  /// metadata-only migration: every row that existed was already a breach.
  type            NotificationType @default(sla_breach)
  slaTimerId      String?          @map("sla_timer_id") @db.Uuid
  /// The `escalated` `ticket_events` row this notification belongs to — the
  /// `escalation` type's equivalent of `sla_timer_id`, non-null exactly for that
  /// type and enforced by `notifications_escalation_columns` (TAR-468).
  ///
  /// It is the group key and the idempotency key at once, which is the point of
  /// the design. N recipient rows point at one escalation act, so the console
  /// shows one escalation and not three. There is no natural uniqueness on
  /// `(ticket, recipient)` — a second escalation an hour later must notify again
  /// — but a *retry* of one escalation must not, and the event row is already
  /// unique.
  ///
  /// A real column with a composite foreign key rather than a `dedupe_key`
  /// string, because only the key makes the invariant structural: a notification
  /// cannot reference an escalation that is absent from the audit trail, so a
  /// notification nobody can explain is not a reachable state.
  ticketEventId   String?          @map("ticket_event_id") @db.Uuid
  ticketId        String           @map("ticket_id") @db.Uuid
  recipientUserId String           @map("recipient_user_id") @db.Uuid
  /// Denormalised from the timer so the supervisor's list needs no join.
  kind            SlaTargetKind?
  /// The deadline that was missed, copied at write time. Not read through the
  /// timer: a later policy edit or a resume must not be able to rewrite what the
  /// supervisor was told they missed.
  dueAt           DateTime?        @map("due_at") @db.Timestamptz(3)
  /// Type-specific payload: `{ workflowId, workflowRunId }` for the two workflow
  /// types, and the supervisor's own `notify` message. JSON rather than columns
  /// because it is read as a whole by the console and never filtered on.
  data            Json?
  /// The workflow types' second idempotency layer, mirroring the SLA unique
  /// below. Null for `sla_breach`, whose reservation is
  /// `(tenant_id, sla_timer_id, recipient_user_id)`.
  dedupeKey       String?          @map("dedupe_key")
  /// When the breach was *detected*, not when it was due — the sweep's own
  /// clock. `NOT NULL` because it is a keyset sort column.
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Set by the acknowledge endpoint. First write wins; a second call is not a
  /// conflict.
  acknowledgedAt  DateTime?        @map("acknowledged_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slaTimer    SlaTimer?    @relation(fields: [tenantId, slaTimerId], references: [tenantId, id], onDelete: Cascade)
  ticketEvent TicketEvent? @relation(fields: [tenantId, ticketEventId], references: [tenantId, id], onDelete: Cascade)
  ticket      Ticket       @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  /// `NoAction`, matching every other user reference in this file: removing a
  /// user is a status change, never a row delete (convention 4).
  recipient User      @relation(fields: [tenantId, recipientUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  /// The SLA path's second idempotency layer. A retry after a partial failure
  /// re-inserts nothing.
  ///
  /// **Left non-partial**, where 0009 proposed `WHERE sla_timer_id IS NOT NULL`.
  /// Postgres does not collide NULLs, so a workflow row — whose `sla_timer_id`
  /// is null — can never conflict here either way, and 0009 says as much
  /// ("belt-and-braces rather than required"). Adding the predicate would buy
  /// nothing and cost the one thing this schema keeps being bitten by: Prisma's
  /// describer skips predicated indexes, so a partial unique index cannot be
  /// declared on this line and the next `migrate dev` would propose creating a
  /// second, non-partial one beside it.
  @@unique([tenantId, slaTimerId, recipientUserId])
  /// The workflow types' idempotency layer — one `notify` per recipient per
  /// occurrence. Null for `sla_breach`, which does not collide, for the same
  /// reason and with the same non-partial shape.
  @@unique([tenantId, recipientUserId, dedupeKey])
  /// The escalation path's idempotency layer — one notification per recipient
  /// per `escalated` event (TAR-468). Non-partial for the same reason as the two
  /// above: `ticket_event_id` is null on every other type and PostgreSQL does
  /// not collide NULLs, so they can never conflict here.
  ///
  /// `dedupe_key` was the alternative and was rejected: it would have keyed on a
  /// string, where this keys on the foreign key that also guarantees the event
  /// exists.
  @@unique([tenantId, ticketEventId, recipientUserId])
  /// The recipient's notification list and its keyset pagination.
  @@index([tenantId, recipientUserId, createdAt(sort: Desc), id(sort: Desc)])
  /// "What did this ticket raise" — TAR-32's escalation log.
  @@index([tenantId, ticketId])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Workflows — TAR-27
// ---------------------------------------------------------------------------

/// One automation rule: one trigger, one condition set, one action list (0009,
/// decision 4). **A workflow is a rule, and the tenant's workflows are the
/// ordered rule list** the console renders — the same shape as
/// `assignment_rules`, and what makes the name and the enable switch belong to
/// the thing a supervisor reasons about.
///
/// `position` orders **execution, not selection**: every matching workflow runs,
/// unlike routing where a first match is the answer. Ties break on `id`, which is
/// creation order.
///
/// `definition` holds the trigger's parameters, the conditions and the actions,
/// as the grammar `packages/contracts/src/workflows.ts` publishes. JSONB rather
/// than normalised trigger/condition/action tables so that the grammar can grow
/// without a migration — and `workflow_references` is what buys back the one
/// thing JSONB cannot give, a foreign key (0009, decision 6).
///
/// **Taxonomy references inside `definition` are ids and only ids** — never a
/// copied name. A tag or team rename therefore needs no migration, no backfill
/// and no cache bust: the name is joined at read time. This is TAR-27's second
/// acceptance criterion, and it is a property of the shape rather than of any
/// code path.
model Workflow {
  id           String                @id @default(uuid(7)) @db.Uuid
  tenantId     String                @map("tenant_id") @db.Uuid
  /// `citext`, on the same reasoning as `teams.name` and `assignment_rules.name`
  /// (conventions, rule 6): a unique key within the tenant that a human types.
  /// Without it `UNIQUE (tenant_id, name)` admits `Escalate` beside `escalate`,
  /// and a supervisor editing one of a pair changes nothing they can see.
  name         String                @db.Citext
  /// Defaults to `false`, where an assignment rule defaults to `true`: a rule
  /// that can close tickets and message supervisors is armed on purpose (0009).
  isActive     Boolean               @default(false) @map("is_active")
  /// Execution order within the tenant. Not unique — two workflows created
  /// normally share `0`, which is why the ordering index also carries `id`.
  position     Int                   @default(0)
  /// A column duplicating a `definition` field, deliberately. Every triggering
  /// occurrence reads "the active workflows in this tenant whose trigger is X",
  /// which is the hottest query in the module; a JSONB extraction in that
  /// predicate cannot use a composite index that also carries `position`, and an
  /// expression index would be a second thing to keep in step with the grammar.
  /// Written in the same statement as `definition`.
  triggerType  WorkflowTriggerType   @map("trigger_type")
  /// Non-null exactly when the workflow was **auto-deactivated** because a
  /// reference broke (0009, decision 6). What the console renders as a warning,
  /// and what blocks re-enabling until the reference resolves.
  /// `workflows_broken_is_inactive` makes the second half structural.
  brokenReason WorkflowBrokenReason? @map("broken_reason")
  /// Trigger, conditions and actions. TAR-27 owns the grammar.
  definition   Json
  /// Incremented on every write that changes `definition`, and copied onto each
  /// run, so a run can be read against the definition that produced it.
  version      Int                   @default(1)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs       WorkflowRun[]
  references WorkflowReference[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  /// The evaluation read, once per triggering occurrence: the active workflows
  /// for one trigger type, in execution order. Replaces `(tenant_id, is_active)`,
  /// which is a strict prefix of this and would cost a second index's writes to
  /// serve queries this one already serves.
  @@index([tenantId, isActive, triggerType, position, id])
  @@map("workflows")
}

/// What one workflow did about one triggering occurrence — and, in the same row,
/// the reservation that stopped a second worker doing it again (0009, decision
/// 2). `UNIQUE (tenant_id, workflow_id, dedupe_key)` is the whole exactly-once
/// mechanism: the claim is
/// `INSERT … ON CONFLICT (tenant_id, workflow_id, dedupe_key) DO NOTHING
/// RETURNING id`, so the record and the right to act are one write. Everything
/// else — the `running` status, the BullMQ job id — is optimisation.
///
/// The table is a **log, not a ledger**: it grows with ticket volume × active
/// workflows and `WORKFLOW_LIMITS.runsRetentionDays` (90) is published with
/// nothing yet enforcing it (0009, risk 5). Whoever builds the acknowledged-alert
/// sweeper 0006 risk 5 left open should sweep this in the same job.
model WorkflowRun {
  id              String                 @id @default(uuid(7)) @db.Uuid
  tenantId        String                 @map("tenant_id") @db.Uuid
  workflowId      String                 @map("workflow_id") @db.Uuid
  /// Every trigger is about a ticket, so this is `NOT NULL`.
  ticketId        String                 @map("ticket_id") @db.Uuid
  /// Which `workflows.version` ran. Copied, not joined: the definition a
  /// supervisor is reading now is not necessarily the one that fired.
  workflowVersion Int                    @map("workflow_version")
  /// The occurrence this run *is*, as `workflowDedupeKey` builds it — e.g.
  /// `ticket:{id}` for `ticket_created` and `ticket_unresolved_for`,
  /// `ticket:{id}:event:{ticketEventId}` for a status change. Text rather than a
  /// pair of columns because the shape differs per trigger type and only its
  /// equality is ever read.
  dedupeKey       String                 @map("dedupe_key")
  status          WorkflowRunStatus      @default(pending)
  /// What fired it — the `WorkflowEvaluateTicketTrigger` payload, including
  /// `depth` and `causedByRunId` for the loop protection's audit trail.
  trigger         Json?
  context         Json?
  /// Per-action outcome, in definition order:
  /// `[{ index, type, outcome, reason }]`. `'[]'` rather than null so that the
  /// response's non-nullable array needs no coalescing, and so the claim
  /// statement — which does not name this column — writes a well-formed value.
  results         Json                   @default("[]")
  /// Typed, because a supervisor filters the run list on it and free text cannot
  /// be filtered. `error` keeps the human-readable detail behind it.
  failureReason   WorkflowFailureReason? @map("failure_reason")
  error           String?
  startedAt       DateTime?              @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime?              @map("finished_at") @db.Timestamptz(3)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow Workflow @relation(fields: [tenantId, workflowId], references: [tenantId, id], onDelete: Cascade)
  ticket   Ticket   @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)

  /// **The idempotency mechanism.** See the docblock above.
  @@unique([tenantId, workflowId, dedupeKey])
  /// The run list for one workflow, keyset-paginated.
  @@index([tenantId, workflowId, createdAt(sort: Desc), id(sort: Desc)])
  /// "What automation touched this ticket" — the first question a supervisor
  /// asks, and the only one that starts from the ticket rather than the rule.
  @@index([tenantId, ticketId, createdAt(sort: Desc)])
  @@index([tenantId, status])
  @@map("workflow_runs")
}

/// The reverse index of 0009 decision 6: one row per entity a workflow's
/// `definition` names, rewritten inside the same transaction as every workflow
/// write. Two jobs, and the second is the reason it is a table rather than a
/// query:
///
///   * **"Which workflows reference this tag / team / user?"** — one indexed read
///     on a taxonomy delete, instead of a JSONB containment scan over every
///     definition in the tenant.
///   * **The database refuses a delete that would break a workflow.** That
///     cannot be a call from `ContactsModule` (L3) into `WorkflowsModule` (L4) —
///     0002 forbids the upward import — but a foreign key is enforced by
///     Postgres and needs no module to know about any other. `ContactsModule`
///     translates the violation into `conflict` and names the workflows.
///
/// ⚠️ **`NoAction`, not `Restrict`, and the difference is load-bearing.** 0009
/// specifies `RESTRICT` for `tag_id` and `team_id`. This schema's convention 4
/// forbids it, for the reason that applies exactly here: `RESTRICT` is checked
/// the instant the referenced row goes, so the `ON DELETE CASCADE` from `tenants`
/// — which removes the tags and these rows in one statement — would abort
/// depending on the order Postgres happened to pick, breaking every fixture and
/// TAR-403's purge. `NoAction` is checked at end of statement instead, so a
/// cascading tenant delete succeeds and a plain `DELETE FROM tags` still raises
/// `23503`. Both halves of decision 6 hold; only the keyword changes.
model WorkflowReference {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  workflowId String   @map("workflow_id") @db.Uuid
  tagId      String?  @map("tag_id") @db.Uuid
  teamId     String?  @map("team_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow Workflow @relation(fields: [tenantId, workflowId], references: [tenantId, id], onDelete: Cascade)
  /// Refused at end of statement, so "3 workflows use this tag" is a fixable
  /// answer rather than a silent trap sprung at 02:00 on a Sunday.
  tag      Tag?     @relation(fields: [tenantId, tagId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  team     Team?    @relation(fields: [tenantId, teamId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  /// Removing a user is a security action and must always succeed, so this one
  /// is genuinely permissive: `users.service.ts` deletes these rows in the same
  /// transaction that already clears `assignment_rules.target_user_id`, and
  /// deactivates the workflow with `broken_reason = 'reference_removed'`.
  user     User?    @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  /// One row per (workflow, entity): a workflow naming the same tag from two
  /// actions stores one row.
  ///
  /// ⚠️ **`NULLS NOT DISTINCT` in the database**, which this line cannot say —
  /// and without it this unique index constrains nothing at all, because every
  /// row has two NULLs in the key and Postgres treats NULL-bearing keys as
  /// distinct by default. Prisma matches `@@unique` against the index and reports
  /// no drift either way, so a `migrate dev` that recreates it for an unrelated
  /// reason recreates it NULL-distinct and the duplicates come back silently.
  /// Same trap, same resolution and same reasoning as
  /// `assignment_state_tenant_scope_key` (TAR-272);
  /// `workflow-schema.int-spec.ts` is what catches it.
  @@unique([tenantId, workflowId, tagId, teamId, userId], map: "workflow_references_scope_key")
  /// The three "which workflows use this?" lookups, one per delete path.
  @@index([tenantId, tagId])
  @@index([tenantId, teamId])
  @@index([tenantId, userId])
  @@map("workflow_references")
}

/// A tag on a **ticket**, mirroring `ContactTag` column for column (0009, data
/// model). `tags` is the one taxonomy — TAR-33 owns it — and this is its second
/// join table.
///
/// **Why not tag the contact instead**, which would need no migration and reuse
/// 0007's `tag` condition: `escalated` is a fact about one incident, while a
/// contact tag is a permanent property of a customer. A workflow writing into the
/// taxonomy TAR-33's segmentation reads would corrupt segments silently and
/// irreversibly, and "why is this customer tagged `escalated` eight months
/// later" is a support conversation nobody can answer. A `contact` variant of the
/// action stays additive — a discriminator on the action, no migration.
///
/// Automation-written at v1: there is no manual ticket-tag endpoint (0009,
/// risk 8).
model TicketTag {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tenantId, tagId], references: [tenantId, id], onDelete: Cascade)

  /// Applying a tag twice is a no-op, not an error — which is what lets the
  /// action report `no_op` instead of failing a run.
  @@unique([tenantId, ticketId, tagId])
  /// "Every ticket with this tag" — the filter that makes ticket tags useful,
  /// and the read behind the `ticket_tag` condition.
  @@index([tenantId, tagId])
  @@map("ticket_tags")
}

// ⚠️ TAR-27's tables carry six objects this file cannot express. All six live in
// 20260816130000_notifications_generalisation and
// 20260816140000_workflow_rule_schema, and `src/prisma/workflow-schema.int-spec.ts`
// fails if any of them is missing or has been quietly widened:
//
//   * `workflows_broken_is_inactive` — CHECK (NOT is_active OR broken_reason IS
//     NULL). A broken workflow cannot be active: the API's "fix the reference,
//     then enable" made structural rather than left to a service that could
//     forget.
//   * `workflow_runs_results_is_array` — CHECK (jsonb_typeof(results) =
//     'array'). `WorkflowRunResponse.results` is an array; a writer sending an
//     object would reach the console as a validation failure on a read.
//   * `workflow_runs_failure_reason_only_when_failed` — CHECK (failure_reason IS
//     NULL OR status = 'failed'). One direction only, deliberately: a `failed`
//     run always has a typed reason in the executor, but making that a
//     constraint would refuse a two-statement transition, and the cost of the
//     gap is a null a mapper already handles.
//   * `workflow_references_one_target` — CHECK (num_nonnulls(tag_id, team_id,
//     user_id) = 1). A reference row names exactly one entity.
//   * `workflow_references_scope_key` — UNIQUE **NULLS NOT DISTINCT**. Without
//     the three words it constrains nothing; see the docblock on
//     `WorkflowReference`.
//   * `notifications_sla_breach_columns` — CHECK ((type = 'sla_breach') =
//     (sla_timer_id IS NOT NULL)). The nullability of the three SLA columns made
//     an invariant instead of a convention.
//   * `notifications_escalation_columns` — CHECK ((type = 'escalation') =
//     (ticket_event_id IS NOT NULL)). The same shape as the line above, applied
//     to TAR-468's column: an `escalation` row that named no event would be a
//     notification with nothing in the audit trail to explain it, and any other
//     type carrying one would be claiming an escalation that never happened.
//
// Prisma's schema language has no CHECK at all, and its describer neither reports
// CHECKs nor distinguishes `NULLS NOT DISTINCT`, so `migrate dev` proposes
// neither to create nor to drop any of them. That is not drift — and it means
// **nothing in this file will ever regenerate them.** A `migrate reset` replays
// the migrations and is fine; a database built from this schema alone silently
// loses all seven.

// ---------------------------------------------------------------------------
// AI — TAR-28
// ---------------------------------------------------------------------------

model AiConfig {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @unique @map("tenant_id") @db.Uuid
  isEnabled       Boolean  @default(false) @map("is_enabled")
  /// Null means "the platform default", so a tenant that never chooses is not
  /// pinned to whatever model was current the day their row was written.
  ///
  /// Free text in the database on purpose (0010 decision 10): the allowlist is
  /// `AI_MODELS` in `@whatsappcrm/contracts`, checked at the API boundary. A
  /// CHECK here would make adding a model id a migration, and model ids change
  /// on the provider's schedule rather than ours.
  model           String?
  systemPrompt    String?  @map("system_prompt")
  /// Phrases that force an immediate handover to a human agent.
  handoffKeywords String[] @default([]) @map("handoff_keywords")

  /// The floor the composite score `min(modelConfidence, retrievalConfidence)`
  /// must reach for the bot to reply rather than hand off (0010 decision 3).
  /// 0.60 = "the model must be at least medium, and retrieval at least solid".
  ///
  /// A defensible starting value, not a measured one — `bot_turns` stores both
  /// component scores per turn precisely so re-tuning it is a query.
  /// `ai_configs_min_confidence_range` bounds it 0..1 in the database and not
  /// only in zod, because zod guards the one handler that writes this row today
  /// and the CHECK guards every writer there will ever be.
  minConfidence  Decimal @default(0.60) @map("min_confidence") @db.Decimal(3, 2)
  /// Bot replies allowed in one conversation before `handoff:max_turns` — the
  /// loop-breaker for a bot and a customer talking past each other. Bounded
  /// 1..20 by `ai_configs_max_bot_turns_range`.
  maxBotTurns    Int     @default(5) @map("max_bot_turns")
  /// Sent to the customer once per conversation on handoff. Null = say nothing,
  /// and that is the default: a tenant that hands off on every unmatched
  /// greeting would otherwise spam.
  handoffMessage String? @map("handoff_message")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("ai_configs")
}

/// Per-tenant knowledge base. Still no embedding column, and now that is a
/// decision rather than a gap: 0010 decision 2 picked PostgreSQL full-text
/// search plus `pg_trgm` over `pgvector`, because a lexical rank with a floor can
/// say "nothing here answers this" and cosine similarity cannot — and that
/// refusal is what TAR-28's empty-knowledge-base criterion rests on. Deferred,
/// not dismissed: adding a `vector` column to `KnowledgeChunk` and a second
/// retriever is the whole change if the recorded revisit signal fires.
model KnowledgeDocument {
  id         String                  @id @default(uuid(7)) @db.Uuid
  tenantId   String                  @map("tenant_id") @db.Uuid
  title      String
  sourceUrl  String?                 @map("source_url")
  content    String
  status     KnowledgeDocumentStatus @default(pending)
  /// BCP 47. Stored for the console and for a future per-language partial index;
  /// **not** consulted by retrieval. The search vector is generated with the
  /// `'simple'` configuration, which a generated column forces to be a literal,
  /// so a per-document `regconfig` cannot reach the query at all (0010
  /// decision 2).
  language   String?
  /// Denormalised from `KnowledgeChunk` so the console can render "indexed, 14
  /// chunks" without a count query per row. Maintained by `KnowledgeIndexer` in
  /// the same transaction as the delete-and-insert reindex.
  chunkCount Int                     @default(0) @map("chunk_count")
  /// Why `status = failed`. Operator-facing; never rendered to a customer, and
  /// never a prompt or a provider key.
  indexError String?                 @map("index_error")
  indexedAt  DateTime?               @map("indexed_at") @db.Timestamptz(3)
  createdAt  DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  /// Referenced by `knowledge_chunks` (conventions, rule 2).
  @@unique([tenantId, id])
  @@index([tenantId, status])
  /// The console's list endpoint, keyset-paginated per 0002 rule 3. The
  /// `(tenantId, status)` index above serves the status filter and the readiness
  /// check; neither serves the default page order.
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("knowledge_documents")
}

/// What retrieval actually reads (0010 decision 2, TAR-402).
///
/// A document is the unit a tenant authors and edits; a chunk is the unit that is
/// ranked, put in the prompt and **cited** — which is why `citedChunkIds` and
/// `BotTurn.citedChunkIds` name chunks rather than documents. Paragraph-packed at
/// roughly 1200 characters with one paragraph of overlap, so the split follows
/// boundaries the author already chose and needs no tokenizer at write time.
model KnowledgeChunk {
  id           String                   @id @default(uuid(7)) @db.Uuid
  tenantId     String                   @map("tenant_id") @db.Uuid
  documentId   String                   @map("document_id") @db.Uuid
  /// Position within the document. Ordering context for the prompt, and what
  /// makes a citation locatable in the source the tenant authored.
  ordinal      Int
  content      String
  /// `to_tsvector('simple', content)`, GENERATED ALWAYS ... STORED, so it is
  /// written once at index time and cannot drift from `content`.
  ///
  /// Optional here and NOT NULL in spirit: the column is generated, so nothing
  /// may write it and PostgreSQL refuses an attempt. Prisma has no syntax for a
  /// generated column, and a required `Unsupported` field cannot be created
  /// through the client at all — so it is declared optional, which keeps
  /// `KnowledgeIndexer`'s inserts possible and matches what the database
  /// reports. The GIN index over it, and the `gin_trgm_ops` index over
  /// `content`, live in raw SQL in
  /// `20260815150000_ai_chatbot_knowledge_base_and_handoff` for the same reason.
  searchVector Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, content)")) @map("search_vector")
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document KnowledgeDocument @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  /// Reindexing is delete-and-insert in one transaction, keyed on the document.
  /// This is what makes a half-written chunk set impossible — a retrieval running
  /// alongside an edit sees the old set or the new one, never a mixture, and a
  /// partially reindexed document is exactly a confidently wrong answer.
  @@unique([tenantId, documentId, ordinal])
  /// The two retrieval indexes. Declared here so `migrate diff` sees them, and
  /// created by the migration's raw SQL because a `USING GIN` build with an
  /// operator class is not something `migrate dev` should be trusted to
  /// reconstruct from this line alone.
  @@index([searchVector], type: Gin, map: "knowledge_chunks_search_idx")
  @@index([content(ops: raw("gin_trgm_ops"))], type: Gin, map: "knowledge_chunks_content_trgm_idx")
  @@index([tenantId, documentId])
  @@map("knowledge_chunks")
}

/// One row per inbound message the bot considered (0010, TAR-402). Three jobs,
/// each load-bearing: the idempotency ledger, the audit trail, and the data set
/// that makes decision 3's constants re-tunable by query.
///
/// **Inserted before the model call.** A deterministic BullMQ job id
/// de-duplicates a re-enqueue; it does not de-duplicate a worker that crashed
/// after the send and before the ack, and a second WhatsApp message to a customer
/// is visible and unrecoverable. So the guard is `@@unique([tenantId,
/// inboundMessageId])` rather than a queue property.
///
/// **No prompt text and no answer text.** The answer is already a `Message` row;
/// storing it twice would double a customer's data footprint for no reader and
/// make retention two problems instead of one.
model BotTurn {
  id                String         @id @default(uuid(7)) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  conversationId    String         @map("conversation_id") @db.Uuid
  inboundMessageId  String         @map("inbound_message_id") @db.Uuid
  outcome           BotTurnOutcome
  /// Set exactly when `outcome = handed_off`, both directions, enforced by
  /// `bot_turns_handoff_reason_matches_outcome`.
  handoffReason     HandoffReason? @map("handoff_reason")
  /// The composite and its two components, stored separately so a re-tune is a
  /// query rather than a re-derivation from an aggregate. Null when the model was
  /// never called. Each is bounded 0..1 independently — they genuinely appear in
  /// combinations, because a `no_match` turn can record a retrieval score with no
  /// model confidence at all.
  score             Decimal?       @db.Decimal(4, 3)
  modelConfidence   Decimal?       @map("model_confidence") @db.Decimal(4, 3)
  retrievalScore    Decimal?       @map("retrieval_score") @db.Decimal(4, 3)
  replyMessageId    String?        @map("reply_message_id") @db.Uuid
  /// Written once, read with the turn, never queried the other way — so a plain
  /// array rather than a join table, on `InternalNote.mentionedUserIds`'
  /// precedent.
  citedChunkIds     String[]       @default([]) @map("cited_chunk_ids") @db.Uuid
  /// The id actually used, not the configured one: `AiConfig.model` may be null
  /// for "the platform default", and a turn has to record which model produced it
  /// after that default moves.
  model             String?
  inputTokens       Int?           @map("input_tokens")
  outputTokens      Int?           @map("output_tokens")
  /// `usage.cache_read_input_tokens` — the only honest verification that prompt
  /// caching is working (0010 decision 12).
  cachedInputTokens Int?           @map("cached_input_tokens")
  /// The model call only.
  latencyMs         Int?           @map("latency_ms")
  /// A classified failure label. Never a prompt, never a provider key, never
  /// customer content.
  error             String?
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation   Conversation   @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)
  inboundMessage Message        @relation("BotTurnInboundMessage", fields: [tenantId, inboundMessageId], references: [tenantId, id], onDelete: Cascade)
  /// `NoAction`, per conventions rule 4 for an optional reference: a cascade here
  /// would delete the idempotency guard and the audit of why the bot answered,
  /// because the reply it produced was removed.
  replyMessage   Message?       @relation("BotTurnReplyMessage", fields: [tenantId, replyMessageId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  handoffEvents  HandoffEvent[]

  /// **The guard that makes a double reply impossible.**
  @@unique([tenantId, inboundMessageId])
  /// Referenced by `handoff_events` (conventions, rule 2).
  @@unique([tenantId, id])
  /// The handoff-context read (0002 rule 3).
  @@index([tenantId, conversationId, createdAt(sort: Desc), id(sort: Desc)])
  /// The tuning queries decisions 2 and 3 name: the outcome mix over time, and
  /// the `no_match` share that is decision 2's revisit signal for `pgvector`.
  @@index([tenantId, outcome, createdAt(sort: Desc)])
  @@map("bot_turns")
}

/// One row per handoff, newest wins (0010 decision 6, TAR-402).
///
/// Carries what the message thread cannot: why the bot stopped and how sure it
/// was. The bot's replies themselves are ordinary `Message` rows — they were
/// genuinely sent to the customer over WhatsApp — so the agent's existing thread
/// already holds the exchange verbatim and in order.
model HandoffEvent {
  id               String        @id @default(uuid(7)) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  conversationId   String        @map("conversation_id") @db.Uuid
  /// Null when the linker produced no ticket for the triggering message.
  ticketId         String?       @map("ticket_id") @db.Uuid
  reason           HandoffReason
  /// The customer message that ended the bot's run: the question the agent now
  /// has to answer.
  triggerMessageId String        @map("trigger_message_id") @db.Uuid
  /// Null for `customer_requested` and `no_match` — the model was never called,
  /// so there is no scored turn to point at.
  botTurnId        String?       @map("bot_turn_id") @db.Uuid
  /// Start of the window the handoff DTO's `botExchange` spans. Null when the bot
  /// never replied; `handoff_events_engagement_matches_replies` holds the other
  /// direction.
  botEngagedAt     DateTime?     @map("bot_engaged_at") @db.Timestamptz(3)
  /// How many times the bot replied before giving up.
  botReplyCount    Int           @map("bot_reply_count")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)
  ticket         Ticket?      @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  triggerMessage Message      @relation(fields: [tenantId, triggerMessageId], references: [tenantId, id], onDelete: Cascade)
  botTurn        BotTurn?     @relation(fields: [tenantId, botTurnId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  /// **Not unique per conversation**, deliberately: a conversation can be
  /// resolved, reopened by a later question, handled by the bot again and handed
  /// off again. `GET /conversations/{id}/handoff` returns the most recent row,
  /// which is what this index is for (0002 rule 3).
  @@index([tenantId, conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("handoff_events")
}

// ---------------------------------------------------------------------------
// Canned responses — TAR-31
// ---------------------------------------------------------------------------

/// The tenant-shared quick-reply library of TAR-31. Four bounds live in the
/// database and cannot appear here — Prisma has no syntax for a CHECK and its
/// describer ignores them, so `migrate dev` proposes neither to create nor to
/// drop `canned_responses_shortcut_format`, `_title_length`, `_body_length` or
/// `_is_shared`, and that is not drift. `src/prisma/canned-response-schema.int-spec.ts`
/// fails if any of them goes missing (TAR-475).
model CannedResponse {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  /// What an agent types to expand it, leading `/` included, e.g. `/refund`.
  ///
  /// `citext`, on the same reasoning as `tenants.slug` and `teams.name`
  /// (conventions, rule 6): this is a *unique* key within the tenant that a
  /// human types, so `/Hours` and `/hours` colliding on the unique index is the
  /// correct answer. It is also what makes the console's case-insensitive
  /// picker agree with the database about which row `/HOURS` means — decision 4
  /// of 0011 has the shortcut resolved client-side, against a local copy.
  ///
  /// A CHECK constraint holds it to `^/[a-z0-9][a-z0-9_-]{0,38}$`: 40
  /// characters including the slash, matching what
  /// `CANNED_RESPONSE_LIMITS.shortcutLength` publishes.
  shortcut        String   @db.Citext
  /// The picker's label, 1..80 characters by CHECK. Never the body — a 4 kB
  /// preview is not a menu item.
  title           String
  /// Literal text, no interpolation at v1. 1..4096 characters by CHECK, 4096
  /// being `SendTextInputSchema.body`'s ceiling, so an inserted body is always
  /// sendable as-is.
  body            String
  /// Always true at v1, enforced by CHECK rather than remembered: TAR-31 scopes
  /// this to a tenant-shared library. The constraint is the seam a future
  /// personal-responses story drops — at which point the *audience* changes
  /// too, from the tenant room to the owner's (0011, open question 3).
  isShared        Boolean  @default(true) @map("is_shared")
  /// Set from the writing principal. Nullable and `NoAction`, so the row
  /// survives its creator being removed from the tenant.
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [tenantId, createdByUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  /// Case-insensitive since `shortcut` became `citext`. `tenant_id` leads it
  /// (conventions, rule 3), so a conflict can only ever be caused by this
  /// tenant's own row — which is also what stops it being used as an oracle for
  /// another tenant's shortcut namespace. It serves the list's
  /// `ORDER BY shortcut` too, so that read needs no index of its own.
  @@unique([tenantId, shortcut])
  /// Kept although **no application query reads by creator** — the composite
  /// foreign key does. Deleting a `users` row makes Postgres check the
  /// referencing side, and it does not index that side for you; without this,
  /// each such delete is a sequential scan of the whole table. Removing one user
  /// is a status change rather than a delete (rule 4), but TAR-397's tenant
  /// purge cascades `users` and `canned_responses` together. 0011 recommends
  /// dropping this as write amplification; writes here are a supervisor's, "a
  /// few times a month", so the saving is not worth a seq scan on the purge path
  /// (TAR-475).
  @@index([tenantId, createdByUserId])
  @@map("canned_responses")
}

// ---------------------------------------------------------------------------
// Billing — TAR-37
// ---------------------------------------------------------------------------

/// Platform-wide, not per tenant: every tenant chooses from the same catalogue.
/// Not RLS-protected — it is public product data.
model Plan {
  id              String          @id @default(uuid(7)) @db.Uuid
  key             String          @unique
  name            String
  /// Integer minor units, never a float (TAR-39, conventions).
  priceMinorUnits Int             @map("price_minor_units")
  currency        String          @default("USD") @db.Char(3)
  interval        BillingInterval @default(month)
  /// Feature flags and quotas the `FeatureGuard` reads. JSONB so adding an
  /// entitlement is a data change, not a migration.
  entitlements    Json
  isActive        Boolean         @default(true) @map("is_active")
  providerPriceId String?         @map("provider_price_id")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscriptions Subscription[]

  @@map("plans")
}

/// One per tenant. `provider_*` ids are opaque strings only the billing adapter
/// interprets (TAR-39, billing ports).
model Subscription {
  id                     String             @id @default(uuid(7)) @db.Uuid
  tenantId               String             @unique @map("tenant_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  status                 SubscriptionStatus @default(trialing)
  seats                  Int                @default(1)
  providerCustomerId     String?            @map("provider_customer_id")
  providerSubscriptionId String?            @unique @map("provider_subscription_id")
  currentPeriodStart     DateTime?          @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd       DateTime?          @map("current_period_end") @db.Timestamptz(3)
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// Billing-webhook routing: provider customer id → tenant.
  @@index([providerCustomerId])
  @@index([planId])
  @@map("subscriptions")
}

/// Incremented inside the transaction that writes the source row, so a rolled
/// back webhook replay rolls the count back with it (TAR-39, usage rules).
/// `period_start` is the subscription's own period, never the calendar month.
model UsageCounter {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  metric      String
  periodStart DateTime @map("period_start") @db.Timestamptz(3)
  periodEnd   DateTime @map("period_end") @db.Timestamptz(3)
  /// BigInt: message counts over a long-lived tenant outgrow `int4`.
  value       BigInt   @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metric, periodStart])
  @@map("usage_counters")
}

// ---------------------------------------------------------------------------
// Platform plumbing — TAR-20 / TAR-22 / TAR-37
// ---------------------------------------------------------------------------

/// **The deliberate exception to tenant scoping** (TAR-39, data model). Written
/// before the tenant is known — storing first and routing later is the whole
/// point — so `tenant_id` is nullable and TAR-48 must NOT put an RLS policy on
/// this table. Written only by `SystemPrisma`, from the ingest controller and
/// the sweeper, and never read by tenant-facing code. `tenant_id` is filled in
/// during processing, for forensics.
model WebhookEvent {
  id              String             @id @default(uuid(7)) @db.Uuid
  tenantId        String?            @map("tenant_id") @db.Uuid
  provider        String
  providerEventId String             @map("provider_event_id")
  status          WebhookEventStatus @default(received)
  payload         Json
  attempts        Int                @default(0)
  lastError       String?            @map("last_error")
  receivedAt      DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt     DateTime?          @map("processed_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  /// What makes a Meta retry a no-op: the ingest insert is
  /// `ON CONFLICT (provider, provider_event_id) DO NOTHING`.
  @@unique([provider, providerEventId])
  /// The sweeper: anything still `received`, or stuck in `processing`, past a
  /// threshold. This is what turns a Redis outage into lateness, not loss.
  @@index([status, receivedAt])
  @@index([tenantId])
  @@map("webhook_events")
}

/// Replay protection for unsafe POSTs that cause external side effects
/// (TAR-39, idempotency). Rows expire after 24 hours.
model IdempotencyKey {
  id           String              @id @default(uuid(7)) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  key          String
  /// Hash of the request body. A replay with a *different* body is a client
  /// bug and must 409 rather than return someone else's response.
  requestHash  String              @map("request_hash")
  state        IdempotencyKeyState @default(in_progress)
  statusCode   Int?                @map("status_code")
  responseBody Json?               @map("response_body")
  expiresAt    DateTime            @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  /// The expiry sweep, which runs across tenants under `SystemPrisma`.
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Role changes, invites, session revocation, branding and billing changes
/// (TAR-39, security). Append-only: no `updated_at`.
model AuditLog {
  id          String         @id @default(uuid(7)) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  /// Null when the actor is the platform rather than a user in this tenant.
  actorUserId String?        @map("actor_user_id") @db.Uuid
  /// Which *kind* of actor (TAR-166), because a null `actor_user_id` alone said
  /// both "the platform acted" and "nothing recorded who".
  ///
  /// The default is the rollout valve, not the application's choice: this
  /// migration lands before the release that writes the column, and an instance
  /// still running the previous build must keep writing valid rows. Every write
  /// path sets this explicitly through `AuditService`.
  actorType   AuditActorType @default(unattributed) @map("actor_type")
  /// Names the operator credential behind a `platform_operator` row — the label
  /// half of a `PLATFORM_ADMIN_TOKEN` entry, never the secret half. Null for
  /// every other actor type, which `audit_logs_actor_attribution` enforces.
  actorLabel  String?        @map("actor_label")
  action      String
  targetType  String?        @map("target_type")
  targetId    String?        @map("target_id") @db.Uuid
  /// Never PII and never a secret value — a redacted before/after at most.
  metadata    Json?
  ipAddress   String?        @map("ip_address") @db.Inet
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [tenantId, actorUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, actorUserId])
  @@index([tenantId, targetType, targetId])
  /// "Everything this operator did, most recent first" — the query the
  /// attribution columns exist to answer, kept an index scan as the table grows.
  @@index([tenantId, actorType, createdAt(sort: Desc)])
  /// One constraint is missing from this block on purpose:
  /// `audit_logs_actor_attribution` is a CHECK, which Prisma's schema language
  /// cannot express, so it lives in raw SQL in
  /// `20260811160000_audit_actor_attribution`. Prisma's describer ignores check
  /// constraints, so `migrate dev` proposes neither to create nor to drop it and
  /// this is not drift — the same arrangement as the predicated indexes on
  /// `users` and `tickets`. Nothing regenerates it from this file alone.
  @@map("audit_logs")
}
