// Prisma schema — the single source of truth for the database shape.
//
// Authored by TAR-47 against the entity table in
// `docs/architecture/0002-architecture-and-api-contract.md` (TAR-39). That
// document fixes the tenancy mechanism, the entity set, the constraints that
// carry meaning, and the load-bearing indexes; this file expresses them and
// adds nothing that changes a decision recorded there.
//
// The connection URL lives in `prisma.config.mjs`, not here: Prisma 7 reads the
// datasource URL from the config file and no longer loads `.env` on its own.
//
// The `generator` block below is TAR-49's, together with `@prisma/client`, the
// `@prisma/adapter-pg` driver adapter, and the `TenantPrisma` / `SystemPrisma`
// split in `src/database`.
//
// ---------------------------------------------------------------------------
// Conventions, applied without exception
// ---------------------------------------------------------------------------
//
//  1. **Every tenant-scoped table carries a non-null `tenant_id`**, even where
//     the tenant is already reachable through a foreign key. Denormalised on
//     purpose: an RLS policy is a row predicate and cannot join (TAR-39,
//     decision 1, rule 2). TAR-48 attaches `FORCE ROW LEVEL SECURITY` and the
//     `tenant_isolation` policy to exactly the tables that have this column.
//
//  2. **Tenant-scoped foreign keys are composite** — `(tenant_id, <parent_id>)`
//     referencing the parent's `@@unique([tenantId, id])`, never the parent's
//     `id` alone. This is the one integrity property RLS cannot provide: RLS
//     stops a tenant *reading* another tenant's row, but a plain
//     `contact_id uuid REFERENCES contacts(id)` would still happily accept an
//     id belonging to another tenant if a handler took it from a request body.
//     The composite key makes that write fail in the database.
//     Cost: one extra unique index per referenced table. Paid deliberately.
//
//  3. **Composite indexes lead with `tenant_id`** (TAR-39, decision 1, rule 3),
//     so an RLS-filtered query and an application-filtered query use the same
//     index. Sort keys are `(<timestamp> DESC, id DESC)` — keyset pagination
//     needs a total order, and a UUIDv7 id is a stable tie-breaker for two rows
//     written in the same millisecond.
//
//  4. **Referential actions are only ever `Cascade` or `NoAction`.**
//     `Cascade` where the child is genuinely owned by the parent (a message
//     without its conversation is garbage). `NoAction` everywhere else —
//     including every optional user/team reference. Two reasons, both load-
//     bearing:
//       * `Restrict` is checked immediately, so it would abort a legitimate
//         `DELETE FROM tenants` whose cascade is about to remove the
//         referencing rows anyway. `NoAction` defers to end of statement and
//         lets that succeed.
//       * `SetNull` on a *composite* key nulls **every** column in the key,
//         including `tenant_id`, which is `NOT NULL`. Postgres 15+ can restrict
//         that to named columns; Prisma cannot express it. So optional
//         references are never `SetNull`, and removing a user is a status
//         change (`UserStatus.removed`), not a row delete.
//
//  5. **Ids are UUIDv7**, generated by the Prisma client (`@default(uuid(7))`).
//     Postgres 17 has no native `uuidv7()` — that lands in 18 — so there is no
//     column default in the generated SQL. Anything inserting outside the
//     client (TAR-48's isolation fixture, TAR-46's seed) must supply the id.
//
//  6. **Timestamps are `timestamptz`**, millisecond precision to match what a
//     JavaScript `Date` can actually represent. Money is integer minor units
//     plus an ISO 4217 code. Phone numbers are E.164. Emails, slugs and
//     hostnames are `citext`, so `A@b.com` and `a@b.com` collide on a unique
//     index rather than becoming two accounts.

datasource db {
  provider = "postgresql"
}

// Prisma 7's generator. Notes on each option, because none of them is a default:
//
//   provider      `prisma-client` is the Prisma 7 generator. The old
//                 `prisma-client-js` wrote into `node_modules/.prisma`, which
//                 pnpm's non-flat store makes unreliable.
//   output        Required now. Inside `src` so `tsc` and `nest build` compile
//                 it with everything else; git-ignored, because generated code
//                 in review noise is worse than one `pnpm db:generate`.
//   moduleFormat  The API is CommonJS (`packages/tsconfig/nestjs.json`).
//   runtime       Plain Node, not an edge or Deno build.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

// ---------------------------------------------------------------------------
// Enums
//
// Native Postgres enums rather than text + CHECK: they are the closed sets in
// the contract, and a typo becomes an error at write time instead of a filter
// that silently matches nothing. The trade-off is that adding a value is cheap
// (`ALTER TYPE ... ADD VALUE`) but removing one is not. Anything genuinely
// open-ended — `ticket_events.type`, workflow definitions — stays text or JSON
// for exactly that reason.
// ---------------------------------------------------------------------------

enum TenantStatus {
  pending
  active
  suspended
  cancelled

  @@map("tenant_status")
}

enum TenantDomainKind {
  platform
  custom

  @@map("tenant_domain_kind")
}

/// The role vocabulary, and it is exactly `TENANT_ROLES` in
/// `packages/contracts/src/rbac.ts` — no more and no less (TAR-80).
///
/// TAR-39's contract is what every guard, every response schema and the session
/// principal speak, and it names three roles. This enum carried a fourth,
/// `owner`, which no code has ever written and which no `TenantRoleSchema` would
/// accept: a row holding it would fail response validation at the serializer and
/// answer 500, not 200. Removed rather than added to the contract, because
/// TAR-22 records "three roles cover v1" as a settled assumption.
///
/// The direction matters if that assumption changes. Adding a value back is one
/// `ALTER TYPE ... ADD VALUE`, online and non-blocking. Removing one is a type
/// swap and a table rewrite — which is precisely why this is done now, while
/// `users` and `invites` are empty in every environment, rather than later.
enum UserRole {
  admin
  supervisor
  agent

  @@map("user_role")
}

enum UserStatus {
  invited
  active
  suspended
  removed

  @@map("user_status")
}

enum UserAvailability {
  available
  away
  offline

  @@map("user_availability")
}

enum WhatsappAccountStatus {
  connected
  disconnected
  error

  @@map("whatsapp_account_status")
}

/// Where a WABA stands with Meta (TAR-52). Modelled as the lifecycle — not
/// verified, submitted, cleared, refused — rather than as a transcription of
/// Meta's field, because Meta exposes two different vocabularies here (the
/// business's `verification_status` and the WABA's `account_review_status`) and
/// TAR-39 records which one the Embedded Signup flow returns as *unverified*.
/// TAR-20 confirms it against Meta's current documentation and maps onto these
/// four; a value it needs and does not find is one `ALTER TYPE ... ADD VALUE`,
/// which is the cheap direction of an enum change.
enum WhatsappBusinessVerificationStatus {
  not_verified
  pending
  verified
  rejected

  @@map("whatsapp_business_verification_status")
}

/// Meta's per-phone-number quality rating. It belongs to the number and not to
/// the business: Meta rates each number separately and throttles each one
/// separately, so two numbers under one WABA can and do sit at different
/// ratings. `unknown` is a value Meta itself returns — distinct from the column
/// being NULL, which means we have never asked.
enum WhatsappQualityRating {
  green
  yellow
  red
  unknown

  @@map("whatsapp_quality_rating")
}

enum MessageTemplateStatus {
  pending
  approved
  rejected
  paused
  disabled

  @@map("message_template_status")
}

enum CustomFieldType {
  text
  number
  date
  boolean
  select
  multi_select

  @@map("custom_field_type")
}

enum ConversationStatus {
  open
  pending
  resolved

  @@map("conversation_status")
}

enum MessageDirection {
  inbound
  outbound

  @@map("message_direction")
}

/// Ordered ladder for outbound messages: queued → sent → delivered → read.
/// `received` is the terminal state of an inbound message and never advances.
/// TAR-20's `isMessageStatusAdvance` reads this order so a late `sent` webhook
/// cannot un-read a message.
enum MessageStatus {
  received
  queued
  sent
  delivered
  read
  failed

  @@map("message_status")
}

enum MessageContentType {
  text
  image
  video
  audio
  document
  sticker
  location
  contacts
  interactive
  template
  system
  /// Anything Meta sends that is not modelled yet — `reaction`, `order`,
  /// `button`, and whatever it ships next. Added by TAR-20's ingestion pipeline
  /// (`20260810180000_message_content_type_unsupported`) to close the drift with
  /// `MESSAGE_TYPES` in `@whatsappcrm/contracts`, which has always published it.
  /// Recording the message is the point: the raw payload is on `webhook_events`,
  /// so a type the product learns to render later can be backfilled, and in the
  /// meantime the thread shows that *something* arrived rather than a gap.
  unsupported

  @@map("message_content_type")
}

/// What a stored binary is, in WhatsApp's own vocabulary (TAR-20e).
///
/// Not `message_content_type` reused: that enum has to cover `text`,
/// `location`, `interactive` and `unsupported`, none of which is a file, and a
/// column typed on it could hold `media_objects.kind = 'text'`. A narrower enum
/// makes that unrepresentable rather than merely wrong.
enum MediaKind {
  image
  video
  audio
  document
  /// Inbound only. Sending one needs a sticker pack registered with Meta, which
  /// the product does not model — see `UPLOADABLE_MEDIA_KINDS` in the contract.
  sticker

  @@map("media_kind")
}

/// How a stored binary came to exist. Recorded rather than inferred from
/// whether an attachment happens to reference it: retention, and whether the
/// bytes may be re-sent, both follow from this.
enum MediaSource {
  /// Downloaded from Meta after an inbound message named it.
  inbound
  /// Uploaded by an agent through `POST /api/v1/media`, before a send.
  upload

  @@map("media_source")
}

/// How far an inbound attachment has got. Downloading runs off the ingest path
/// — Meta's media endpoint is a second network call and a document may be
/// 100 MB — so there is a real interval in which a message exists and its
/// picture does not, and the inbox has to render the difference.
enum MediaDownloadState {
  pending
  stored
  /// Terminal. Meta refused, the five-minute handle expired, or the payload
  /// broke a limit. The message stays in the thread: the customer did send
  /// something, and a gap would say otherwise.
  failed

  @@map("media_download_state")
}

enum TicketStatus {
  open
  pending
  resolved
  closed

  @@map("ticket_status")
}

enum TicketPriority {
  low
  normal
  high
  urgent

  @@map("ticket_priority")
}

enum SlaTargetKind {
  first_response
  resolution

  @@map("sla_target_kind")
}

enum SlaTimerState {
  running
  met
  breached
  cancelled

  @@map("sla_timer_state")
}

enum WorkflowRunStatus {
  pending
  running
  succeeded
  failed

  @@map("workflow_run_status")
}

enum KnowledgeDocumentStatus {
  pending
  indexed
  failed

  @@map("knowledge_document_status")
}

enum BillingInterval {
  month
  year

  @@map("billing_interval")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
  incomplete

  @@map("subscription_status")
}

enum WebhookEventStatus {
  received
  processing
  processed
  failed

  @@map("webhook_event_status")
}

enum IdempotencyKeyState {
  in_progress
  completed

  @@map("idempotency_key_state")
}

// ---------------------------------------------------------------------------
// Tenancy — TAR-19 / TAR-29 / TAR-36
// ---------------------------------------------------------------------------

/// The only table that is not tenant-scoped by design: it *is* the tenant.
/// Never RLS-protected, and reachable only through `SystemPrisma`.
model Tenant {
  id          String       @id @default(uuid(7)) @db.Uuid
  /// Stable, human-readable handle. Used for the platform subdomain and in
  /// support tooling. `citext` so `Acme` and `acme` cannot both exist.
  slug        String       @unique @db.Citext
  name        String
  status      TenantStatus @default(pending)
  trialEndsAt DateTime?    @map("trial_ends_at") @db.Timestamptz(3)
  /// Set by TAR-51. Deactivation retains data and revokes access; it is not a
  /// delete, which is why there is no `deleted_at` here.
  suspendedAt DateTime?    @map("suspended_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  domains                  TenantDomain[]
  branding                 TenantBranding?
  settings                 TenantSettings?
  users                    User[]
  sessions                 Session[]
  passwordResetTokens      PasswordResetToken[]
  invites                  Invite[]
  inviteTeams              InviteTeam[]
  teams                    Team[]
  teamMembers              TeamMember[]
  whatsappBusinessAccounts WhatsappBusinessAccount[]
  whatsappAccounts         WhatsappAccount[]
  messageTemplates         MessageTemplate[]
  contacts                 Contact[]
  tags                     Tag[]
  contactTags              ContactTag[]
  customFieldDefs          CustomFieldDef[]
  conversations            Conversation[]
  messages                 Message[]
  mediaObjects             MediaObject[]
  attachments              MessageAttachment[]
  internalNotes            InternalNote[]
  tickets                  Ticket[]
  ticketEvents             TicketEvent[]
  ticketCounter            TicketCounter?
  assignmentRules          AssignmentRule[]
  assignmentStates         AssignmentState[]
  slaPolicies              SlaPolicy[]
  slaTimers                SlaTimer[]
  workflows                Workflow[]
  workflowRuns             WorkflowRun[]
  aiConfig                 AiConfig?
  knowledgeDocs            KnowledgeDocument[]
  cannedResponses          CannedResponse[]
  subscription             Subscription?
  usageCounters            UsageCounter[]
  webhookEvents            WebhookEvent[]
  idempotencyKeys          IdempotencyKey[]
  auditLogs                AuditLog[]

  @@index([status])
  @@map("tenants")
}

/// Host → tenant resolution (TAR-39, decision 2, step 1). `hostname` is unique
/// **globally**, not per tenant: it is the lookup key on an unauthenticated
/// request, so two tenants claiming one host has no correct answer.
model TenantDomain {
  id         String           @id @default(uuid(7)) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  hostname   String           @unique @db.Citext
  kind       TenantDomainKind @default(platform)
  /// Custom domains are unverified until DNS and TLS check out (TAR-29). An
  /// unverified row must not resolve a request.
  verifiedAt DateTime?        @map("verified_at") @db.Timestamptz(3)
  isPrimary  Boolean          @default(false) @map("is_primary")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_domains")
}

/// White-label presentation, one row per tenant (TAR-29 owns the contents).
model TenantBranding {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @unique @map("tenant_id") @db.Uuid
  productName  String?  @map("product_name")
  logoUrl      String?  @map("logo_url")
  faviconUrl   String?  @map("favicon_url")
  primaryColor String?  @map("primary_color")
  accentColor  String?  @map("accent_color")
  supportEmail String?  @map("support_email") @db.Citext
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_branding")
}

/// Operational defaults, one row per tenant — the "settings" of TAR-19's first
/// acceptance criterion. Deliberately small: feature stories add their own
/// columns here rather than inventing a second settings table.
model TenantSettings {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @unique @map("tenant_id") @db.Uuid
  /// IANA zone name. Drives business hours, SLA calculation and report
  /// bucketing; timestamps themselves are always stored `timestamptz`.
  timezone      String   @default("UTC")
  locale        String   @default("en")
  /// `{ mon: [{ from: "09:00", to: "17:00" }], ... }`. JSON because the shape
  /// is presentation-driven and TAR-26 owns its interpretation.
  businessHours Json?    @map("business_hours")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

// ---------------------------------------------------------------------------
// Identity and access — TAR-22 / TAR-35
// ---------------------------------------------------------------------------

/// The "agents" of TAR-19's acceptance criteria. Identity is **tenant-scoped**:
/// `UNIQUE (tenant_id, email)`, not a global unique email (TAR-39, decision 2).
/// Someone who works for two client organisations gets two accounts. TAR-39
/// records this as worth confirming with Tarek before TAR-35 ships, and records
/// the additive migration path if it turns out to be wrong.
model User {
  id           String           @id @default(uuid(7)) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  email        String           @db.Citext
  /// Argon2id (TAR-39, security). Null for a user who has been invited but has
  /// not yet accepted.
  passwordHash String?          @map("password_hash")
  name         String
  avatarUrl    String?          @map("avatar_url")
  role         UserRole         @default(agent)
  status       UserStatus       @default(invited)
  availability UserAvailability @default(offline)
  lastLoginAt  DateTime?        @map("last_login_at") @db.Timestamptz(3)
  /// `UserResponse.lastSeenAt` (TAR-39's users contract), and not the same thing
  /// as `last_login_at`: an agent who logged in on Monday and is working now is
  /// "last seen" now. The truth lives in `sessions.last_seen_at`, but reading it
  /// per row would make the people list an aggregate over `sessions` for every
  /// user, and sessions are swept on expiry, so the history disappears with
  /// them. Denormalised here instead, written by the same session-touch path
  /// that maintains `sessions.last_seen_at` (TAR-35), which is already rate
  /// limited by the principal cache TTL — so this is at most one extra UPDATE
  /// per user per minute, not one per request.
  lastSeenAt   DateTime?        @map("last_seen_at") @db.Timestamptz(3)

  /// Lockout state (TAR-53, decision 3), and the reason it is three durable
  /// columns rather than a Redis counter: TAR-35 requires a lockout to be
  /// *observable to a tenant admin*, and a counter that evaporates on an
  /// eviction cannot answer "is this account locked, and since when".
  ///
  /// `failed_login_attempts` is monotonic between successes — the lockout fires
  /// on every positive multiple of `AUTH_POLICY.loginFailureThreshold`, so an
  /// attacker who waits out one window does not get a fresh allowance of ten.
  /// A successful login resets it to zero along with `locked_until`.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  /// Distinguishes "locked right now" from "locked last March" in the admin
  /// list. `locked_until` alone cannot: it is cleared on the next success.
  lastFailedLoginAt   DateTime? @map("last_failed_login_at") @db.Timestamptz(3)
  /// The lockout itself. Compared against the database's `now()`, never a
  /// node's clock, so skew between API instances cannot end one early.
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions              Session[]
  passwordResetTokens   PasswordResetToken[]
  invitesSent           Invite[]
  teamMemberships       TeamMember[]
  assignedConversations Conversation[]
  sentMessages          Message[]
  uploadedMedia         MediaObject[]
  internalNotes         InternalNote[]
  assignedTickets       Ticket[]
  ticketEvents          TicketEvent[]
  assignmentRules       AssignmentRule[]
  assignmentCursors     AssignmentState[]
  cannedResponses       CannedResponse[]
  auditLogs             AuditLog[]

  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  /// One index is missing from this block on purpose:
  /// `users_tenant_id_locked_until_idx` is **partial**
  /// (`WHERE locked_until IS NOT NULL`), so the admin list can surface locked
  /// accounts without scanning a table where almost every row has a NULL there.
  /// Prisma cannot express an index predicate, so it lives in raw SQL in
  /// `20260811150000_auth_schema_and_policies` — the same arrangement as
  /// `tickets_one_active_per_contact` (TAR-74). Prisma's describer skips
  /// predicated indexes entirely, so `migrate dev` proposes neither to create
  /// nor to drop it and this is not drift. Nothing regenerates it from this
  /// file alone.
  @@map("users")
}

/// Opaque server-side sessions (TAR-39, decision 2). The token itself is never
/// stored — only its hash — so a database leak does not hand over live sessions.
model Session {
  id                String    @id @default(uuid(7)) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  /// The *sliding* idle deadline: `now() + AUTH_POLICY.sessionIdleMs`, pushed
  /// forward on use but never past `absolute_expires_at`.
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  /// The cap the sliding window may not cross —
  /// `created_at + AUTH_POLICY.sessionAbsoluteMs` (TAR-53, decision 1). Stored
  /// rather than derived from `created_at` so the sweep is one index range scan
  /// instead of a computed predicate over every row, and so the cap can be
  /// shortened for one session (a suspicious login) without a schema change.
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Why this session died: `logout` / `logout_all` / `password_change` /
  /// `password_reset` / `deactivation` / `admin`. Free text rather than an enum
  /// — it is an audit annotation nothing branches on, and TAR-57/58/59 will add
  /// reasons; `ALTER TYPE` for a label no query filters on is cost without
  /// benefit. Null on a live session, and on one that simply expired.
  revokedReason     String?   @map("revoked_reason")
  lastSeenAt        DateTime? @map("last_seen_at") @db.Timestamptz(3)
  ipAddress         String?   @map("ip_address") @db.Inet
  userAgent         String?   @map("user_agent")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  /// Bulk revoke on a role change or a password reset.
  @@index([tenantId, userId])
  /// The expiry sweep, which runs across tenants under `SystemPrisma`.
  @@index([expiresAt])
  /// The other half of that sweep. A row can be past its absolute cap while its
  /// sliding `expires_at` is still in the future — that is the whole point of a
  /// cap — so the `expires_at` index above does not find it.
  @@index([absoluteExpiresAt])
  @@map("sessions")
}

/// Single-use, time-limited password reset (TAR-53). A table rather than a
/// signed stateless token: single-use is *state*, and expiry alone does not
/// give it. A stateless token needs a consumed-list to be single-use, which is
/// this table with extra steps.
///
/// Redemption is one conditional statement —
/// `UPDATE … WHERE consumed_at IS NULL RETURNING` — so the update itself is the
/// concurrency control and two simultaneous uses of one link cannot both win.
/// A read-then-write would let both through.
model PasswordResetToken {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  /// SHA-256 hex of the token. The token itself is never stored, so a database
  /// leak yields no usable link. SHA-256 rather than argon2id is correct here
  /// specifically: the input is 256 bits of uniform entropy, not a
  /// human-chosen password, so there is no dictionary for a KDF to slow down.
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(3)
  /// Forensics only — never a filter, never shown to a user.
  requestedIp String?   @map("requested_ip") @db.Inet
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  /// "Invalidate this user's outstanding tokens", which every new request and
  /// every completed reset does.
  @@index([tenantId, userId])
  /// The cross-tenant expiry sweep under `SystemPrisma`.
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Invite {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  email           String    @db.Citext
  role            UserRole  @default(agent)
  tokenHash       String    @unique @map("token_hash")
  invitedByUserId String?   @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz(3)
  /// An admin cancelling a pending invite. `accepted_at` cannot express it:
  /// "never accepted" and "withdrawn" are different states, and only one of
  /// them should stop the link working.
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User?        @relation(fields: [tenantId, invitedByUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  teams     InviteTeam[]

  /// Referenced by `invite_teams` (conventions, rule 2).
  @@unique([tenantId, id])
  @@index([tenantId, email])
  @@index([tenantId, invitedByUserId])
  /// A second index is missing from this block on purpose:
  /// `invites_one_live_per_email` is a **partial unique** index over
  /// `(tenant_id, email) WHERE accepted_at IS NULL AND revoked_at IS NULL`, so
  /// two live invites for one address — which means two accounts — are
  /// impossible rather than merely unlikely. Prisma cannot express an index
  /// predicate; it lives in raw SQL in
  /// `20260811150000_auth_schema_and_policies`, which also explains why the
  /// predicate cannot carry an expiry term and what TAR-55 must do about it.
  @@map("invites")
}

/// The teams an invited agent joins on acceptance.
/// `InviteCreateInputSchema` has carried `teamIds` since TAR-53 and nothing in
/// the schema held them.
///
/// A `uuid[]` column on `invites` would be one fewer table and cannot express a
/// foreign key, so a team deleted between invite and acceptance would leave a
/// dangling id that surfaces as a 500 in the middle of onboarding. Here the
/// database removes the row with the team.
model InviteTeam {
  tenantId String @map("tenant_id") @db.Uuid
  inviteId String @map("invite_id") @db.Uuid
  teamId   String @map("team_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invite Invite @relation(fields: [tenantId, inviteId], references: [tenantId, id], onDelete: Cascade)
  team   Team   @relation(fields: [tenantId, teamId], references: [tenantId, id], onDelete: Cascade)

  /// The natural key is the whole row, so it is the primary key — no surrogate
  /// `id` that nothing would ever reference (TAR-53's data model).
  @@id([tenantId, inviteId, teamId])
  /// "Which pending invites reference this team", the read a team deletion
  /// needs. The primary key leads with `invite_id` and cannot serve it.
  @@index([tenantId, teamId])
  @@map("invite_teams")
}

/// The routing unit of TAR-22: a conversation assigned to a team is visible to
/// every member of that team, whatever their own assignment.
model Team {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// `citext`, on the same reasoning as `tenants.slug` and every email column
  /// (conventions, rule 6): this is a *unique* key within the tenant that a
  /// human types, so `Billing` and `billing` colliding on the unique index is
  /// the correct answer. Without it an admin creating "billing" next to an
  /// existing "Billing" gets two teams that look identical in every picker, and
  /// conversations routed to one are invisible to the members of the other.
  name        String   @db.Citext
  /// `TeamResponse.description` in TAR-39's users contract, which had nowhere to
  /// land. `TeamCreateInput` caps it at 500 characters; that bound is the
  /// contract's to enforce, not a column type's.
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members               TeamMember[]
  pendingInvites        InviteTeam[]
  assignedConversations Conversation[]
  assignedTickets       Ticket[]
  assignmentRules       AssignmentRule[]
  assignmentState       AssignmentState?

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(uuid(7)) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  teamId   String   @map("team_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [tenantId, teamId], references: [tenantId, id], onDelete: Cascade)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, teamId, userId])
  /// "Which teams is this user in" — resolved on every session bootstrap to fill
  /// `SessionPrincipal.teamIds`, and again wherever a role-scoped list needs the
  /// user's team set. `team_id` is trailing rather than absent so the answer
  /// comes out of the index without touching the heap; it replaces the narrower
  /// `(tenant_id, user_id)` index, which was a prefix of this one and therefore
  /// served nothing extra.
  @@index([tenantId, userId, teamId])
  @@map("team_members")
}

// ---------------------------------------------------------------------------
// WhatsApp channel — TAR-20
// ---------------------------------------------------------------------------

/// Meta scopes its WhatsApp objects at three levels, not two, and TAR-52 gives
/// the middle one a table of its own:
///
///   Tenant ──< WhatsappBusinessAccount ──< WhatsappAccount   (phone numbers)
///                                     └──< MessageTemplate
///
/// A tenant may hold several WABAs (TAR-39, question 6, answered by Tarek), each
/// with one or more numbers. The two things that follow from Meta's own scoping,
/// and that this table exists to express:
///
///   * **The access token is issued to the business, not to the number.** One
///     copy per WABA, so a rotation is a single-row update that cannot leave two
///     numbers holding different secrets.
///   * **Template approval is per WABA.** `message_templates` hangs off this
///     table, which is what lets one tenant hold `order_update`/`en` approved
///     separately under two WABAs.
///
/// Quality rating and messaging limits stay on the phone number, where Meta puts
/// them — see `WhatsappAccount`.
model WhatsappBusinessAccount {
  id                   String                             @id @default(uuid(7)) @db.Uuid
  tenantId             String                             @map("tenant_id") @db.Uuid
  /// Meta's own id for the business account. Unique **globally**, on the same
  /// reasoning as `phone_number_id`: one Meta app serves every tenant, so a
  /// WABA id arriving on a webhook has to resolve to exactly one row.
  wabaId               String                             @unique @map("waba_id")
  /// The business name Meta reports. Display only — two WABAs under one tenant
  /// are otherwise indistinguishable in an operator's list.
  name                 String?
  /// The per-business credential, encrypted at rest and decrypted only in the
  /// send path (TAR-39, security). Never selected into an API response.
  accessTokenEncrypted String?                            @map("access_token_encrypted")
  verificationStatus   WhatsappBusinessVerificationStatus @default(not_verified) @map("verification_status")
  createdAt            DateTime                           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts  WhatsappAccount[]
  templates MessageTemplate[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("whatsapp_business_accounts")
}

/// One phone number, child of a WABA. One Meta app serves every tenant, so
/// `phone_number_id` is the webhook routing key and must be unique **globally**
/// (TAR-39, webhook ingestion) — that does not change with several WABAs behind
/// it, because the routing key names the number rather than the business.
model WhatsappAccount {
  id                        String                 @id @default(uuid(7)) @db.Uuid
  tenantId                  String                 @map("tenant_id") @db.Uuid
  whatsappBusinessAccountId String                 @map("whatsapp_business_account_id") @db.Uuid
  phoneNumberId             String                 @unique @map("phone_number_id")
  displayPhoneNumber        String                 @map("display_phone_number")
  verifiedName              String?                @map("verified_name")
  /// Meta's rating for this number. NULL until we have read it; `unknown` when
  /// Meta says so. Not on the WABA — Meta rates and throttles per number.
  qualityRating             WhatsappQualityRating? @map("quality_rating")
  status                    WhatsappAccountStatus  @default(disconnected)
  createdAt                 DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  whatsappBusinessAccount WhatsappBusinessAccount @relation(fields: [tenantId, whatsappBusinessAccountId], references: [tenantId, id], onDelete: Cascade)
  conversations           Conversation[]

  @@unique([tenantId, id])
  @@index([tenantId, whatsappBusinessAccountId])
  @@map("whatsapp_accounts")
}

/// A template belongs to the WABA that submitted it for approval, not to the
/// tenant and not to the number: `UNIQUE (tenant_id, whatsapp_business_account_id,
/// name, language)`. Keyed on the tenant as well as the WABA even though the
/// WABA already implies one, because every unique index here has to lead with
/// `tenant_id` for RLS to use it (TAR-39, decision 1, rule 3).
model MessageTemplate {
  id                        String                @id @default(uuid(7)) @db.Uuid
  tenantId                  String                @map("tenant_id") @db.Uuid
  whatsappBusinessAccountId String                @map("whatsapp_business_account_id") @db.Uuid
  name                      String
  language                  String
  category                  String?
  status                    MessageTemplateStatus @default(pending)
  /// Meta's component tree, stored verbatim — its shape is Meta's to change.
  components                Json?
  providerTemplateId        String?               @map("provider_template_id")
  createdAt                 DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  whatsappBusinessAccount WhatsappBusinessAccount @relation(fields: [tenantId, whatsappBusinessAccountId], references: [tenantId, id], onDelete: Cascade)

  /// No separate `(tenant_id, whatsapp_business_account_id)` index: this unique
  /// index leads with exactly those two columns, so "every template in this
  /// WABA" already has one. A second index on the same prefix would cost write
  /// throughput and serve no read.
  @@unique([tenantId, whatsappBusinessAccountId, name, language])
  /// Serves `GET /api/v1/message-templates` (TAR-20a, shape ruled in 0002
  /// amendment 1): approved templates for the tenant in scope, ordered by name,
  /// keyset-paginated. The unique index above cannot serve it — it leads with
  /// the WABA, while this list may span a tenant's WABAs — so without this the
  /// composer's template picker is a sequential scan of every tenant's
  /// templates. `status` sits second because the endpoint filters on exactly one
  /// value; `tenant_id` leads it because RLS supplies that equality on every
  /// query (TAR-39, decision 1, rule 3); `name, language, id` are the three sort
  /// keys, and a name-leading order is also what makes the `q` prefix a range.
  @@index([tenantId, status, name, language, id])
  @@map("message_templates")
}

// ---------------------------------------------------------------------------
// Contacts — TAR-33
// ---------------------------------------------------------------------------

model Contact {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  /// E.164, and the natural key for an inbound message: every inbound webhook
  /// resolves a contact through `(tenant_id, phone_e164)`.
  phoneE164    String    @map("phone_e164")
  displayName  String?   @map("display_name")
  email        String?   @db.Citext
  locale       String?
  /// Values for `custom_field_defs`, keyed by `custom_field_defs.key`. JSONB so
  /// a tenant adding a field is a row insert, not a migration.
  customFields Json?     @map("custom_fields")
  /// Set when the contact opts out. A non-null value blocks outbound sends.
  optedOutAt   DateTime? @map("opted_out_at") @db.Timestamptz(3)
  lastSeenAt   DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tags          ContactTag[]
  conversations Conversation[]
  tickets       Ticket[]

  @@unique([tenantId, phoneE164])
  @@unique([tenantId, id])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("contacts")
}

model Tag {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  color     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts ContactTag[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@map("tags")
}

model ContactTag {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tenantId, tagId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, contactId, tagId])
  /// "Every contact with this tag" — the filter that makes tags useful.
  @@index([tenantId, tagId])
  @@map("contact_tags")
}

model CustomFieldDef {
  id        String          @id @default(uuid(7)) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  /// The key used inside `contacts.custom_fields`.
  key       String
  label     String
  type      CustomFieldType @default(text)
  /// Allowed values for `select` / `multi_select`.
  options   Json?
  position  Int             @default(0)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("custom_field_defs")
}

// ---------------------------------------------------------------------------
// Inbox — TAR-20
// ---------------------------------------------------------------------------

model Conversation {
  id                     String             @id @default(uuid(7)) @db.Uuid
  tenantId               String             @map("tenant_id") @db.Uuid
  whatsappAccountId      String             @map("whatsapp_account_id") @db.Uuid
  contactId              String             @map("contact_id") @db.Uuid
  status                 ConversationStatus @default(open)
  assignedUserId         String?            @map("assigned_user_id") @db.Uuid
  assignedTeamId         String?            @map("assigned_team_id") @db.Uuid
  /// Meta's 24-hour customer service window. Past this, only an approved
  /// template may be sent — so it is a column, not a derived value.
  serviceWindowExpiresAt DateTime?          @map("service_window_expires_at") @db.Timestamptz(3)
  /// Denormalised from `messages` to keep the inbox list a single-table scan.
  /// Maintained in the same transaction as the message insert.
  ///
  /// NOT NULL, and that is load-bearing rather than tidiness (TAR-92): this is
  /// the leading *sort* column of all three inbox keyset indexes below.
  /// Postgres orders NULLs FIRST under DESC, so a message-less conversation
  /// would pin itself to page one, and the ruled resume predicate
  /// (`last_message_at <= $1 AND NOT (…)`) evaluates to NULL — not TRUE — for
  /// that cursor, silently dropping every row after it. A thread with no
  /// message yet sorts by when it was opened: the default is the row's own
  /// insert time, matching `created_at`.
  lastMessageAt          DateTime           @default(now()) @map("last_message_at") @db.Timestamptz(3)
  unreadCount            Int                @default(0) @map("unread_count")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  whatsappAccount WhatsappAccount @relation(fields: [tenantId, whatsappAccountId], references: [tenantId, id], onDelete: Cascade)
  contact         Contact         @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Cascade)
  assignedUser    User?           @relation(fields: [tenantId, assignedUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  assignedTeam    Team?           @relation(fields: [tenantId, assignedTeamId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  messages        Message[]
  internalNotes   InternalNote[]
  tickets         Ticket[]

  /// One thread per contact per WhatsApp number.
  @@unique([tenantId, whatsappAccountId, contactId])
  @@unique([tenantId, id])
  /// The inbox list — the hottest query in the product (TAR-39, index table).
  @@index([tenantId, status, lastMessageAt(sort: Desc), id(sort: Desc)])
  /// An agent's default view — the `conversation:read` (no `_all`) inbox, which
  /// is the whole difference between an agent and a supervisor (TAR-22).
  ///
  /// The sort key is part of the index, not an afterthought. Without it the
  /// planner drops the scope predicate to a filter and walks the tenant-wide
  /// index above instead, so the work scales with the *tenant's* conversation
  /// count rather than with the principal's. Measured on 120 000 conversations
  /// where the principal holds 2 000 of them: 3 094 buffers and 39 333
  /// `Rows Removed by Filter` for one 25-row page, against 6 buffers and an
  /// Index Only Scan once the sort key is in the index.
  ///
  /// Explicitly named because Prisma's generated name for five columns exceeds
  /// Postgres's 63-character identifier limit and would be silently truncated.
  @@index([tenantId, assignedUserId, status, lastMessageAt(sort: Desc), id(sort: Desc)], map: "conversations_tenant_assigned_user_inbox_idx")
  @@index([tenantId, assignedTeamId, status, lastMessageAt(sort: Desc), id(sort: Desc)], map: "conversations_tenant_assigned_team_inbox_idx")
  @@index([tenantId, contactId])
  @@map("conversations")
}

model Message {
  id                String             @id @default(uuid(7)) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  conversationId    String             @map("conversation_id") @db.Uuid
  direction         MessageDirection
  status            MessageStatus
  contentType       MessageContentType @default(text) @map("content_type")
  body              String?
  /// Meta's id. Null until an outbound send is acknowledged, which is why the
  /// unique constraint tolerates it — Postgres does not collide NULLs. Once
  /// set, it is what makes a replayed webhook a no-op.
  providerMessageId String?            @map("provider_message_id")
  /// The agent who sent an outbound message. Null for inbound and for messages
  /// sent by automation.
  senderUserId      String?            @map("sender_user_id") @db.Uuid
  /// The provider's timestamp, never insert order: Meta does not guarantee
  /// delivery order and ingest is concurrent (TAR-39, ordering).
  sentAt            DateTime           @map("sent_at") @db.Timestamptz(3)
  deliveredAt       DateTime?          @map("delivered_at") @db.Timestamptz(3)
  readAt            DateTime?          @map("read_at") @db.Timestamptz(3)
  failedAt          DateTime?          @map("failed_at") @db.Timestamptz(3)
  errorCode         String?            @map("error_code")
  errorMessage      String?            @map("error_message")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation        @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)
  sender       User?               @relation(fields: [tenantId, senderUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  attachments  MessageAttachment[]

  @@unique([tenantId, providerMessageId])
  @@unique([tenantId, id])
  /// Thread view and keyset pagination (TAR-39, index table).
  @@index([tenantId, conversationId, sentAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, senderUserId])
  @@map("messages")
}

/// One stored binary (TAR-20e).
///
/// ## Why this is not `message_attachments`
///
/// `POST /api/v1/media` returns a `mediaId` **before** any message exists — the
/// composer attaches a file, then sends. An attachment row cannot represent
/// that: `message_id` is what makes it an attachment. So the binary is its own
/// entity, and an attachment is the join between a message and one.
///
/// It also makes the two lifetimes separable, which they genuinely are. An
/// upload that is never sent is a stray media object with no attachment, and
/// sweeping those is a retention job that never has to reason about messages.
///
/// ## What is not here
///
/// No Meta media id for the *outbound* direction. Meta's upload handle is
/// scoped to the phone number it was uploaded to and expires on Meta's own
/// schedule, so caching one would be a per-number, time-limited cache whose
/// staleness surfaces as a failed send. The bytes are uploaded per send
/// instead; see `MediaSendResolver`.
model MediaObject {
  id       String      @id @default(uuid(7)) @db.Uuid
  tenantId String      @map("tenant_id") @db.Uuid
  kind     MediaKind
  source   MediaSource
  /// Where the bytes are in the object store, namespaced by tenant. Unique per
  /// tenant so two rows can never point at one blob and a delete of either
  /// orphan the other.
  storageKey      String   @map("storage_key")
  mimeType        String   @map("mime_type")
  sizeBytes       Int      @map("size_bytes")
  /// SHA-256 of the stored bytes, lower-case hex. Written on the way in, so a
  /// corrupted or truncated object can be proven rather than suspected — and so
  /// an inbound download can be checked against the digest Meta publishes.
  checksumSha256  String   @map("checksum_sha256")
  /// What the recipient sees, and what a download is named. Documents only in
  /// practice; null when the source supplied none.
  fileName        String?  @map("file_name")
  /// Meta's handle for an inbound object. Retrieval only — it is not a handle
  /// this platform may send with, and it stops resolving after Meta expires it.
  providerMediaId String?  @map("provider_media_id")
  /// The agent who uploaded it. Null for inbound and for automation.
  uploadedByUserId String? @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy  User?               @relation(fields: [tenantId, uploadedByUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  attachments MessageAttachment[]

  @@unique([tenantId, id])
  @@unique([tenantId, storageKey])
  /// The retention sweep over uploads nothing ever attached, and the only
  /// listing this table has.
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, uploadedByUserId])
  @@map("media_objects")
}

model MessageAttachment {
  id              String             @id @default(uuid(7)) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  messageId       String             @map("message_id") @db.Uuid
  /// The stored binary, once there is one. Null while an inbound download is
  /// `pending`, and permanently null when it `failed` — the row still records
  /// that the customer sent a file, which is the honest thing for the thread to
  /// show.
  mediaObjectId   String?            @map("media_object_id") @db.Uuid
  /// Re-hosted by us: Meta's media URLs expire.
  ///
  /// Stored as a path (`/api/v1/media/{id}/content`), not an absolute URL. The
  /// same row is served through a tenant's platform subdomain and through its
  /// custom domain (TAR-29), so the origin is the request's to supply and the
  /// response mapper is where the two are joined. An absolute URL here would
  /// name whichever host was configured the day the row was written.
  url             String?
  kind            MediaKind
  downloadState   MediaDownloadState @default(stored) @map("download_state")
  /// Why a download ended `failed`, for the operator. Never rendered to a
  /// customer, and never carries a URL or a token.
  downloadError   String?            @map("download_error")
  mimeType        String             @map("mime_type")
  /// Known once the bytes are stored. Meta's inbound payload does not carry it.
  sizeBytes       Int?               @map("size_bytes")
  filename        String?
  providerMediaId String?            @map("provider_media_id")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  message     Message      @relation(fields: [tenantId, messageId], references: [tenantId, id], onDelete: Cascade)
  mediaObject MediaObject? @relation(fields: [tenantId, mediaObjectId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  /// One attachment per message per Meta handle. Meta sends exactly one media
  /// object per inbound message, so this is what makes a replayed webhook a
  /// no-op instead of a second attachment on the same message.
  @@unique([tenantId, messageId, providerMediaId])
  @@index([tenantId, messageId])
  /// The retry sweep: inbound downloads that never completed.
  @@index([tenantId, downloadState, createdAt])
  @@map("message_attachments")
}

/// Agent-only notes on a conversation. Never sent to the contact.
model InternalNote {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  conversationId   String   @map("conversation_id") @db.Uuid
  authorUserId     String?  @map("author_user_id") @db.Uuid
  body             String
  /// Who to notify. A plain `uuid[]` rather than a join table: it is written
  /// once, read with the note, and never queried the other way round.
  mentionedUserIds String[] @map("mentioned_user_ids") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)
  author       User?        @relation(fields: [tenantId, authorUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, authorUserId])
  @@map("internal_notes")
}

// ---------------------------------------------------------------------------
// Tickets — TAR-21 / TAR-25 / TAR-32
// ---------------------------------------------------------------------------

model Ticket {
  id              String         @id @default(uuid(7)) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  /// Per-tenant, human-facing ticket number. Unique within the tenant only —
  /// two tenants both having ticket #1 is correct. Allocated by
  /// `TicketCounter` below (TAR-73, decision 3); the unique constraint is what
  /// makes a racy allocator fail loudly instead of duplicating.
  number          Int
  subject         String?
  status          TicketStatus   @default(open)
  priority        TicketPriority @default(normal)
  conversationId  String?        @map("conversation_id") @db.Uuid
  contactId       String?        @map("contact_id") @db.Uuid
  assignedUserId  String?        @map("assigned_user_id") @db.Uuid
  assignedTeamId  String?        @map("assigned_team_id") @db.Uuid
  firstResponseAt DateTime?      @map("first_response_at") @db.Timestamptz(3)
  resolvedAt      DateTime?      @map("resolved_at") @db.Timestamptz(3)
  closedAt        DateTime?      @map("closed_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  contact      Contact?      @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  assignedUser User?         @relation(fields: [tenantId, assignedUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  assignedTeam Team?         @relation(fields: [tenantId, assignedTeamId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  events       TicketEvent[]
  slaTimers    SlaTimer[]

  @@unique([tenantId, number])
  @@unique([tenantId, id])
  /// Ticket queues and supervisor dashboards (TAR-39, index table).
  @@index([tenantId, status, priority, createdAt(sort: Desc)])
  /// The `ticket:read` (no `_all`) queue, the ticket half of the same agent
  /// scope as `conversations` above, carrying its own sort key for the same
  /// reason. Measured: the narrower index still applied the scope, but every
  /// page paid a top-N sort over the principal's whole matching set — 43 buffers
  /// against 6 for one page at 500 matching tickets, and that gap grows with the
  /// principal's backlog rather than staying flat.
  @@index([tenantId, assignedUserId, status, createdAt(sort: Desc), id(sort: Desc)], map: "tickets_tenant_assigned_user_queue_idx")
  @@index([tenantId, assignedTeamId, status, createdAt(sort: Desc), id(sort: Desc)], map: "tickets_tenant_assigned_team_queue_idx")
  @@index([tenantId, conversationId])
  @@index([tenantId, contactId])
  @@map("tickets")
}

// ⚠️ `tickets` carries one index this file cannot express: the partial unique
// index `tickets_one_active_per_contact`, on `(tenant_id, contact_id)`
// `WHERE status IN ('open','pending')`. It is the DB-level guarantee behind
// TAR-21's "one active ticket per contact" (TAR-73, decision 2) and it lives in
// the 20260811130000_ticket_active_constraint_and_counters migration.
//
// Prisma's schema language has no partial-index syntax, and its Postgres
// describer skips indexes carrying a predicate — so `migrate dev` neither
// proposes to create it nor proposes to drop it, and it is not drift. The
// consequence to know about: **nothing in this file will ever regenerate it.**
// A `migrate reset` replays the migration and is fine; a database built any
// other way from this schema alone silently loses the invariant.
// `ticket-active-uniqueness.int-spec.ts` is what catches that.
//
// `contact_id` stays nullable and that is load-bearing: Postgres does not
// collide NULLs in a unique index, so TAR-25's manual ticket with no contact
// never conflicts. Making the column `NOT NULL` to tidy it would break that.

/// Append-only audit trail for a single ticket (TAR-32). `type` is text, not an
/// enum: every later story adds event types, and an enum would make each of
/// them a migration.
model TicketEvent {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  ticketId    String   @map("ticket_id") @db.Uuid
  type        String
  /// Null when the actor is the system — an automation rule or an SLA timer.
  actorUserId String?  @map("actor_user_id") @db.Uuid
  /// Type-specific payload: `{ from, to }` for a status change, and so on.
  data        Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  actor  User?  @relation(fields: [tenantId, actorUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, ticketId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, actorUserId])
  @@map("ticket_events")
}

/// Per-tenant ticket-number allocator (TAR-73, decision 3). `tickets.number` is
/// `NOT NULL` with `UNIQUE (tenant_id, number)` and no default, so without this
/// there is no way to insert a ticket at all.
///
/// One row per tenant, created lazily by the first ticket rather than at
/// provisioning, so TAR-50's flow needs no change. Holds the *next* number to
/// hand out. Numbers are unique and monotonic but **not gapless** — the
/// allocating CTE still increments when the outer insert loses the race to
/// `tickets_one_active_per_contact`, and nothing depends on density.
model TicketCounter {
  tenantId   String   @id @map("tenant_id") @db.Uuid
  nextNumber Int      @default(1) @map("next_number")
  /// The one deviation from the usual timestamp shape: a database-level `now()`
  /// default alongside `@updatedAt`. Every other table here is written through
  /// the Prisma client, which supplies the value; this one is written by the raw
  /// upsert in TAR-73 decision 2, whose column list is `(tenant_id,
  /// next_number)`. Without the default that statement violates `NOT NULL` and
  /// no ticket can be created. `@updatedAt` still wins whenever the client
  /// writes the row.
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("ticket_counters")
}

// ---------------------------------------------------------------------------
// Assignment — TAR-23 / TAR-24
// ---------------------------------------------------------------------------

model AssignmentRule {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  /// Rules are evaluated in ascending `position`; the first match wins.
  position     Int      @default(0)
  isActive     Boolean  @default(true) @map("is_active")
  /// TAR-24 owns the condition and action grammar. JSONB keeps that grammar
  /// out of the schema so evolving it is not a migration.
  conditions   Json
  action       Json
  targetUserId String?  @map("target_user_id") @db.Uuid
  targetTeamId String?  @map("target_team_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  targetUser User?  @relation(fields: [tenantId, targetUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  targetTeam Team?  @relation(fields: [tenantId, targetTeamId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, isActive, position])
  @@index([tenantId, targetUserId])
  @@index([tenantId, targetTeamId])
  @@map("assignment_rules")
}

/// Round-robin cursor, one row per team (TAR-23).
model AssignmentState {
  id                 String   @id @default(uuid(7)) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  teamId             String   @unique @map("team_id") @db.Uuid
  lastAssignedUserId String?  @map("last_assigned_user_id") @db.Uuid
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant           Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  team             Team   @relation(fields: [tenantId, teamId], references: [tenantId, id], onDelete: Cascade)
  lastAssignedUser User?  @relation(fields: [tenantId, lastAssignedUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, teamId])
  @@index([tenantId, lastAssignedUserId])
  @@map("assignment_state")
}

// ---------------------------------------------------------------------------
// SLA — TAR-26
// ---------------------------------------------------------------------------

model SlaPolicy {
  id                   String          @id @default(uuid(7)) @db.Uuid
  tenantId             String          @map("tenant_id") @db.Uuid
  name                 String
  /// Applies to tickets of this priority; null means "any".
  priority             TicketPriority?
  firstResponseMinutes Int?            @map("first_response_minutes")
  resolutionMinutes    Int?            @map("resolution_minutes")
  /// When true, elapsed time is counted against `tenant_settings.business_hours`
  /// rather than wall-clock.
  businessHoursOnly    Boolean         @default(false) @map("business_hours_only")
  isActive             Boolean         @default(true) @map("is_active")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timers SlaTimer[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId, isActive, priority])
  @@map("sla_policies")
}

model SlaTimer {
  id        String        @id @default(uuid(7)) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  ticketId  String        @map("ticket_id") @db.Uuid
  policyId  String        @map("policy_id") @db.Uuid
  kind      SlaTargetKind
  state     SlaTimerState @default(running)
  startedAt DateTime      @default(now()) @map("started_at") @db.Timestamptz(3)
  dueAt     DateTime      @map("due_at") @db.Timestamptz(3)
  stoppedAt DateTime?     @map("stopped_at") @db.Timestamptz(3)

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket Ticket    @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  policy SlaPolicy @relation(fields: [tenantId, policyId], references: [tenantId, id], onDelete: Cascade)

  /// One timer per target per ticket.
  @@unique([tenantId, ticketId, kind])
  /// The timer sweep. TAR-39 specifies a partial index
  /// `(tenant_id, due_at) WHERE state = 'running'`; Prisma cannot express a
  /// `WHERE` on an index, and an index created outside the schema shows up as
  /// drift that the next `migrate dev` proposes to drop. Leading with `state`
  /// gives the sweep the same access path — equality on `state`, then a range
  /// scan on `due_at` in index order — at the cost of also indexing finished
  /// timers. Revisit as a partial index once timer volume makes the size
  /// matter; the query does not have to change.
  @@index([tenantId, state, dueAt])
  @@index([tenantId, policyId])
  @@map("sla_timers")
}

// ---------------------------------------------------------------------------
// Workflows — TAR-27
// ---------------------------------------------------------------------------

model Workflow {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String
  isActive   Boolean  @default(false) @map("is_active")
  /// Trigger, conditions and actions. TAR-27 owns the grammar.
  definition Json
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   WorkflowRun[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId, isActive])
  @@map("workflows")
}

model WorkflowRun {
  id         String            @id @default(uuid(7)) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  workflowId String            @map("workflow_id") @db.Uuid
  status     WorkflowRunStatus @default(pending)
  /// What fired it — `{ event: "ticket.created", ticketId: "..." }`.
  trigger    Json?
  context    Json?
  error      String?
  startedAt  DateTime?         @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime?         @map("finished_at") @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow Workflow @relation(fields: [tenantId, workflowId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, workflowId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, status])
  @@map("workflow_runs")
}

// ---------------------------------------------------------------------------
// AI — TAR-28
// ---------------------------------------------------------------------------

model AiConfig {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @unique @map("tenant_id") @db.Uuid
  isEnabled       Boolean  @default(false) @map("is_enabled")
  model           String?
  systemPrompt    String?  @map("system_prompt")
  /// Phrases that force an immediate handover to a human agent.
  handoffKeywords String[] @default([]) @map("handoff_keywords")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("ai_configs")
}

/// Per-tenant knowledge base. No embedding column: whether that is `pgvector`,
/// an external index, or nothing at all is TAR-28's decision, and adding the
/// column here would make it look settled.
model KnowledgeDocument {
  id        String                  @id @default(uuid(7)) @db.Uuid
  tenantId  String                  @map("tenant_id") @db.Uuid
  title     String
  sourceUrl String?                 @map("source_url")
  content   String
  status    KnowledgeDocumentStatus @default(pending)
  indexedAt DateTime?               @map("indexed_at") @db.Timestamptz(3)
  createdAt DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("knowledge_documents")
}

// ---------------------------------------------------------------------------
// Canned responses — TAR-31
// ---------------------------------------------------------------------------

model CannedResponse {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  /// What an agent types to expand it, e.g. `/refund`.
  shortcut        String
  title           String
  body            String
  isShared        Boolean  @default(true) @map("is_shared")
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [tenantId, createdByUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, shortcut])
  @@index([tenantId, createdByUserId])
  @@map("canned_responses")
}

// ---------------------------------------------------------------------------
// Billing — TAR-37
// ---------------------------------------------------------------------------

/// Platform-wide, not per tenant: every tenant chooses from the same catalogue.
/// Not RLS-protected — it is public product data.
model Plan {
  id              String          @id @default(uuid(7)) @db.Uuid
  key             String          @unique
  name            String
  /// Integer minor units, never a float (TAR-39, conventions).
  priceMinorUnits Int             @map("price_minor_units")
  currency        String          @default("USD") @db.Char(3)
  interval        BillingInterval @default(month)
  /// Feature flags and quotas the `FeatureGuard` reads. JSONB so adding an
  /// entitlement is a data change, not a migration.
  entitlements    Json
  isActive        Boolean         @default(true) @map("is_active")
  providerPriceId String?         @map("provider_price_id")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscriptions Subscription[]

  @@map("plans")
}

/// One per tenant. `provider_*` ids are opaque strings only the billing adapter
/// interprets (TAR-39, billing ports).
model Subscription {
  id                     String             @id @default(uuid(7)) @db.Uuid
  tenantId               String             @unique @map("tenant_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  status                 SubscriptionStatus @default(trialing)
  seats                  Int                @default(1)
  providerCustomerId     String?            @map("provider_customer_id")
  providerSubscriptionId String?            @unique @map("provider_subscription_id")
  currentPeriodStart     DateTime?          @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd       DateTime?          @map("current_period_end") @db.Timestamptz(3)
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// Billing-webhook routing: provider customer id → tenant.
  @@index([providerCustomerId])
  @@index([planId])
  @@map("subscriptions")
}

/// Incremented inside the transaction that writes the source row, so a rolled
/// back webhook replay rolls the count back with it (TAR-39, usage rules).
/// `period_start` is the subscription's own period, never the calendar month.
model UsageCounter {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  metric      String
  periodStart DateTime @map("period_start") @db.Timestamptz(3)
  periodEnd   DateTime @map("period_end") @db.Timestamptz(3)
  /// BigInt: message counts over a long-lived tenant outgrow `int4`.
  value       BigInt   @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metric, periodStart])
  @@map("usage_counters")
}

// ---------------------------------------------------------------------------
// Platform plumbing — TAR-20 / TAR-22 / TAR-37
// ---------------------------------------------------------------------------

/// **The deliberate exception to tenant scoping** (TAR-39, data model). Written
/// before the tenant is known — storing first and routing later is the whole
/// point — so `tenant_id` is nullable and TAR-48 must NOT put an RLS policy on
/// this table. Written only by `SystemPrisma`, from the ingest controller and
/// the sweeper, and never read by tenant-facing code. `tenant_id` is filled in
/// during processing, for forensics.
model WebhookEvent {
  id              String             @id @default(uuid(7)) @db.Uuid
  tenantId        String?            @map("tenant_id") @db.Uuid
  provider        String
  providerEventId String             @map("provider_event_id")
  status          WebhookEventStatus @default(received)
  payload         Json
  attempts        Int                @default(0)
  lastError       String?            @map("last_error")
  receivedAt      DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt     DateTime?          @map("processed_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  /// What makes a Meta retry a no-op: the ingest insert is
  /// `ON CONFLICT (provider, provider_event_id) DO NOTHING`.
  @@unique([provider, providerEventId])
  /// The sweeper: anything still `received`, or stuck in `processing`, past a
  /// threshold. This is what turns a Redis outage into lateness, not loss.
  @@index([status, receivedAt])
  @@index([tenantId])
  @@map("webhook_events")
}

/// Replay protection for unsafe POSTs that cause external side effects
/// (TAR-39, idempotency). Rows expire after 24 hours.
model IdempotencyKey {
  id           String              @id @default(uuid(7)) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  key          String
  /// Hash of the request body. A replay with a *different* body is a client
  /// bug and must 409 rather than return someone else's response.
  requestHash  String              @map("request_hash")
  state        IdempotencyKeyState @default(in_progress)
  statusCode   Int?                @map("status_code")
  responseBody Json?               @map("response_body")
  expiresAt    DateTime            @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  /// The expiry sweep, which runs across tenants under `SystemPrisma`.
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Role changes, invites, session revocation, branding and billing changes
/// (TAR-39, security). Append-only: no `updated_at`.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// Null when the actor is the platform rather than a user in this tenant.
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id") @db.Uuid
  /// Never PII and never a secret value — a redacted before/after at most.
  metadata    Json?
  ipAddress   String?  @map("ip_address") @db.Inet
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [tenantId, actorUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, actorUserId])
  @@index([tenantId, targetType, targetId])
  @@map("audit_logs")
}
