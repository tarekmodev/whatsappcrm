{
  "name": "@whatsappcrm/api",
  "version": "0.0.0",
  "private": true,
  "description": "WhatsApp CRM HTTP API (NestJS)",
  "scripts": {
    "generate": "prisma generate",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:db": "jest --config jest.int.config.js --runInBand",
    "db:check-migrations": "node scripts/check-down-migrations.mjs",
    "db:rollback": "node scripts/db-rollback.mjs",
    "db:provision-roles": "node scripts/provision-roles.mjs",
    "db:restore-drill": "node scripts/db-restore-drill.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^11.1.28",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@sentry/nestjs": "^10.69.0",
    "@whatsappcrm/contracts": "workspace:^",
    "bullmq": "^6.0.10",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "@whatsappcrm/tsconfig": "workspace:^",
    "jest": "^30.4.2",
    "pino-pretty": "^13.1.3",
    "prisma": "7.9.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  }
}
