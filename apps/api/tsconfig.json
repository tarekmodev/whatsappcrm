{
  "extends": "@whatsappcrm/tsconfig/nestjs.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      // `@polar-sh/sdk` publishes its webhook verifier on a subpath and declares
      // it only through the `exports` map. Node honours that at runtime — which
      // is why the import works — but this project compiles with
      // `moduleResolution: "Node"` (node10), which predates `exports` and looks
      // for a real `webhooks.js` at the package root instead.
      //
      // Mapped here rather than by moving the whole API to `node16` resolution:
      // that switch makes every relative import in the project require a `.js`
      // extension, which is a repo-wide change for one dependency. The target is
      // the CommonJS build, matching what `require` actually loads.
      "@polar-sh/sdk/webhooks.js": ["./node_modules/@polar-sh/sdk/dist/commonjs/webhooks.d.ts"],
      // Same reason. `validateEvent` throws this one once the signature has
      // already passed, and telling it apart from a verification failure is what
      // stops an authentic delivery becoming a 500 (TAR-663).
      "@polar-sh/sdk/models/errors/sdkvalidationerror.js": [
        "./node_modules/@polar-sh/sdk/dist/commonjs/models/errors/sdkvalidationerror.d.ts"
      ]
    }
  },
  "include": ["src/**/*.ts"]
}
